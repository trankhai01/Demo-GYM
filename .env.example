# Copy this file to .env and fill in real values.
# Do NOT commit the real .env to git.

# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=quan_ly_gym

# Session — REQUIRED in production. Generate a long random string, e.g.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Set to "production" when deploying.
NODE_ENV=development

# Gemini API key cho chatbot. Lấy free tại https://aistudio.google.com/app/apikey
# (15 req/phút, 1M tokens/ngày). Để trống → chatbot trả 503 lịch sự.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# SMTP (Gmail App Password) cho email reset MK + sinh nhật. Để trống → bỏ qua gửi mail.
# Lấy App Password tại https://myaccount.google.com/apppasswords (cần bật 2FA Gmail).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GymBro <noreply@gymbro.local>"

# Brevo (Sendinblue) API - Dùng thay SMTP để gửi mail qua HTTPS API (tránh bị block ở Railway)
BREVO_API_KEY=
BREVO_FROM_EMAIL=

# payOS cho thanh toán tự động khi khách tự đăng ký gói tập.
# Webhook URL cần cấu hình trên payOS: https://your-domain.com/payments/payos/webhook
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_PUBLIC_BASE_URL=
