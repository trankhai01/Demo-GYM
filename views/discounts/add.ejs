<%- include('../partials/header') %>

<div class="container mt-4 mb-5" style="max-width: 720px;">
  <div class="card shadow-sm">
    <div class="card-header"><h4 class="mb-0"><i class="bi bi-ticket-perforated text-primary"></i> Thêm mã ưu đãi</h4></div>
    <div class="card-body">
      <% if (locals.error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>
      <form action="/discounts/add" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Mã <span class="text-danger">*</span></label>
            <input type="text" name="code" class="form-control" placeholder="VD: TET2026" value="<%= (locals.form && form.code) || '' %>" required style="text-transform: uppercase;">
          </div>
          <div class="col-md-6">
            <label class="form-label">Trạng thái</label>
            <select name="status" class="form-select">
              <option value="<%= STATUS.DISCOUNT.ACTIVE %>" <%= !locals.form || form.status !== STATUS.DISCOUNT.DISABLED ? 'selected' : '' %>>Hoạt động</option>
              <option value="<%= STATUS.DISCOUNT.DISABLED %>" <%= locals.form && form.status === STATUS.DISCOUNT.DISABLED ? 'selected' : '' %>>Tắt</option>
            </select>
          </div>
          <div class="col-12">
            <label class="form-label">Mô tả</label>
            <input type="text" name="description" class="form-control" placeholder="VD: Khuyến mãi Tết Nguyên Đán 2026" value="<%= (locals.form && form.description) || '' %>">
          </div>
          <div class="col-md-4">
            <label class="form-label">Loại giảm</label>
            <select name="discount_type" class="form-select">
              <option value="percent" <%= !locals.form || form.discount_type !== 'fixed' ? 'selected' : '' %>>Phần trăm (%)</option>
              <option value="fixed" <%= locals.form && form.discount_type === 'fixed' ? 'selected' : '' %>>Số tiền cố định (đ)</option>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label">Giá trị <span class="text-danger">*</span></label>
            <input type="number" name="discount_value" class="form-control" min="0" step="0.01" value="<%= (locals.form && form.discount_value) || '' %>" required>
          </div>
          <div class="col-md-4">
            <label class="form-label">Giảm tối đa (chỉ áp với %)</label>
            <input type="number" name="max_discount" class="form-control" min="0" value="<%= (locals.form && form.max_discount) || '' %>" placeholder="Không giới hạn">
          </div>
          <div class="col-md-4">
            <label class="form-label">Đơn tối thiểu</label>
            <input type="number" name="min_amount" class="form-control" min="0" value="<%= (locals.form && form.min_amount) || 0 %>">
          </div>
          <div class="col-md-4">
            <label class="form-label">Có hiệu lực từ</label>
            <input type="date" name="valid_from" class="form-control" value="<%= (locals.form && form.valid_from) || '' %>">
          </div>
          <div class="col-md-4">
            <label class="form-label">Có hiệu lực đến</label>
            <input type="date" name="valid_to" class="form-control" value="<%= (locals.form && form.valid_to) || '' %>">
          </div>
          <div class="col-md-6">
            <label class="form-label">Giới hạn số lần dùng</label>
            <input type="number" name="usage_limit" class="form-control" min="1" value="<%= (locals.form && form.usage_limit) || '' %>" placeholder="Không giới hạn">
          </div>
        </div>
        <div class="d-flex justify-content-between mt-4">
          <a href="/discounts" class="btn btn-outline-secondary">Hủy</a>
          <button class="btn btn-primary"><i class="bi bi-save"></i> Lưu mã</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
