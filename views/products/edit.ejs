<%- include('../partials/header') %>

<div class="container mt-5 mb-5 d-flex justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="bg-dark p-4 rounded-4 shadow border border-secondary">
            <h4 class="text-white text-uppercase mb-4 border-bottom border-secondary pb-2"><i class="bi bi-box-fill text-danger me-2"></i>Sửa sản phẩm</h4>
            
            <form action="/products/edit/<%= product.id %>" method="POST">
    
    <div class="mb-3">
        <label class="form-label text-white-50">Tên sản phẩm *</label>
        <input type="text" name="product_name" class="form-control bg-dark text-white border-secondary" 
               value="<%= product.product_name %>" required>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <label class="form-label text-white-50">Danh mục</label>
            <select name="category" class="form-select bg-dark text-white border-secondary">
                <option value="Đồ uống" <%= product.category === 'Đồ uống' ? 'selected' : '' %>>Đồ uống</option>
                <option value="Thực phẩm bổ sung" <%= product.category === 'Thực phẩm bổ sung' ? 'selected' : '' %>>Thực phẩm bổ sung</option>
                <option value="Phụ kiện" <%= product.category === 'Phụ kiện' ? 'selected' : '' %>>Phụ kiện</option>
            </select>
        </div>
        <div class="col-md-6 mt-3 mt-md-0">
            <label class="form-label text-white-50">Trạng thái</label>
            <select name="status" class="form-select bg-dark text-white border-secondary">
                <option value="Active" <%= product.status === 'Active' ? 'selected' : '' %>>Đang bán (Active)</option>
                <option value="Inactive" <%= product.status === 'Inactive' ? 'selected' : '' %>>Ngừng bán (Inactive)</option>
            </select>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <label class="form-label text-white-50">Giá bán (VNĐ) *</label>
            <input type="number" name="price" class="form-control bg-dark text-white border-secondary" 
                   value="<%= product.price %>" required>
        </div>
        <div class="col-md-6 mt-3 mt-md-0">
            <label class="form-label text-white-50">Số lượng nhập kho *</label>
            <input type="number" name="stock_quantity" class="form-control bg-dark text-white border-secondary" 
                   value="<%= product.stock_quantity %>" required>
        </div>
    </div>

    <div class="mb-4">
        <label class="form-label text-white-50">Link Hình Ảnh (URL)</label>
        <input type="text" name="image_url" class="form-control bg-dark text-white border-secondary" 
               value="<%= product.image_url %>">
    </div>

    <div class="d-flex gap-3">
        <a href="/products" class="btn btn-secondary w-50 py-2 fw-bold" style="background-color: #6c757d; border: none;">
            Hủy
        </a>
        <button type="submit" class="btn btn-danger w-50 py-2 fw-bold" style="background-color: #d9534f; border: none;">
            Lưu vào kho
        </button>
    </div>
</form>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>