<%- include('../partials/header') %>

<div class="container mt-5 mb-5 d-flex justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="bg-dark p-4 rounded-4 shadow border border-secondary">
            <h4 class="text-white text-uppercase mb-4 border-bottom border-secondary pb-2"><i class="bi bi-box-fill text-danger me-2"></i>Thêm Sản Phẩm Mới</h4>
            
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger py-2"><i class="bi bi-exclamation-triangle"></i> <%= error %></div>
            <% } %>

            <form action="/products/add" method="POST" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="mb-3">
                    <label class="form-label text-white-50 small">Tên sản phẩm *</label>
                    <input type="text" name="product_name" class="form-control bg-transparent text-white border-secondary" value="<%= (typeof form !== 'undefined' && form.product_name) || '' %>" required>
                </div>
                
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label text-white-50 small">Danh mục</label>
                        <select name="category" class="form-select bg-transparent text-white border-secondary">
                            <option value="Đồ uống" class="text-dark">Đồ uống</option>
                            <option value="Thực phẩm bổ sung" class="text-dark">Thực phẩm bổ sung (Whey/Pre-workout)</option>
                            <option value="Phụ kiện" class="text-dark">Phụ kiện (Găng tay/Quấn cổ tay)</option>
                            <option value="Trang phục" class="text-dark">Trang phục</option>
                            <option value="Khác" class="text-dark">Khác</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-white-50 small">Trạng thái</label>
                        <select name="status" class="form-select bg-transparent text-white border-secondary">
                            <option value="Active" class="text-dark">Đang bán (Active)</option>
                            <option value="Out of Stock" class="text-dark">Ngưng bán</option>
                        </select>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label text-white-50 small">Giá bán (VNĐ) *</label>
                        <input type="number" name="price" class="form-control bg-transparent text-white border-secondary" min="0" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-white-50 small">Số lượng nhập kho *</label>
                        <input type="number" name="stock_quantity" class="form-control bg-transparent text-white border-secondary" min="0" value="0" required>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-white-50 small">Upload ảnh sản phẩm</label>
                    <input type="file" name="image_file" class="form-control bg-transparent text-white border-secondary" accept="image/jpeg,image/png,image/webp">
                    <div class="form-text text-white-50">Tối đa 2 MB. Chấp nhận JPG/PNG/WEBP.</div>
                </div>

                <div class="mb-4">
                    <label class="form-label text-white-50 small">Hoặc dán URL ảnh (nếu không upload file)</label>
                    <input type="text" name="image_url" class="form-control bg-transparent text-white border-secondary" placeholder="https://..." value="<%= (typeof form !== 'undefined' && form.image_url) || '' %>">
                </div>

                <div class="d-flex gap-2">
                    <a href="/products" class="btn btn-secondary w-50">Hủy</a>
                    <button type="submit" class="btn btn-danger w-50 fw-bold">Lưu vào kho</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>