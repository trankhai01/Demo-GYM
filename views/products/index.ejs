<%- include('../partials/header') %>

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-secondary">
        <div>
            <h2 class="fw-bold text-white text-uppercase m-0"><i class="bi bi-box-seam text-danger me-2"></i>Quản lý Kho Hàng</h2>
        </div>
        <a href="/products/add" class="btn btn-danger rounded-pill px-4"><i class="bi bi-plus-lg me-1"></i>Nhập sản phẩm mới</a>
    </div>

    <div class="bg-dark rounded-4 shadow border border-secondary overflow-hidden">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead class="table-active text-uppercase small" style="letter-spacing: 1px;">
                    <tr>
                        <th class="ps-4">Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Danh mục</th>
                        <th>Giá bán</th>
                        <th class="text-center">Tồn kho</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (products.length > 0) { %>
                        <% products.forEach(prod => { %>
                            <tr>
                                <td class="ps-4">
                                    <img src="<%= prod.image_url || 'https://via.placeholder.com/50' %>" class="rounded bg-secondary object-fit-cover" width="50" height="50">
                                </td>
                                <td class="fw-bold"><%= prod.product_name %></td>
                                <td><span class="badge bg-secondary"><%= prod.category %></span></td>
                                <td class="text-success fw-bold"><%= Number(prod.price).toLocaleString('vi-VN') %>đ</td>
                                
                                <td class="text-center">
                                    <% if (prod.stock_quantity <= 0) { %>
                                        <span class="badge bg-danger fs-6">Hết hàng</span>
                                    <% } else if (prod.stock_quantity < 10) { %>
                                        <span class="text-warning fw-bold"><%= prod.stock_quantity %> <i class="bi bi-exclamation-triangle-fill"></i></span>
                                    <% } else { %>
                                        <span class="text-white"><%= prod.stock_quantity %></span>
                                    <% } %>
                                </td>
                                
                                <td class="text-center">
                                    <span class="badge <%= prod.status === 'Active' ? 'bg-success' : 'bg-secondary' %>"><%= prod.status %></span>
                                </td>
                                <td class="text-center pe-4">
                                    <a href="/products/edit/<%= prod.id %>" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil-square"></i></a>
                                    <form action="/products/delete/<%= prod.id %>" method="POST" class="d-inline ms-1"
                                          onsubmit="return confirm('Xóa sản phẩm này khỏi kho?')">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash3"></i></button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="7" class="text-center text-white-50 py-4">Kho hàng đang trống.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>