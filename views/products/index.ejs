<%- include('../partials/header') %>

<style>
    .pos-page-title { color:#0f172a; letter-spacing:1px; }
    .pos-page-title .accent { color:#4f46e5; }

    /* Layout 2 cột: sidebar category + grid sản phẩm */
    .pos-layout {
        display:grid;
        grid-template-columns:240px 1fr;
        gap:20px;
        align-items:start;
    }
    @media (max-width: 768px) {
        .pos-layout { grid-template-columns: 1fr; }
    }

    /* Sidebar category */
    .pos-cat-sidebar {
        background:#ffffff;
        border:1px solid #e2e8f0;
        border-radius:14px;
        padding:14px;
        box-shadow:0 4px 12px rgba(15,23,42,.04);
        position:sticky;
        top:20px;
    }
    .pos-cat-title {
        text-transform:uppercase;
        font-size:.78rem;
        letter-spacing:1.2px;
        color:#94a3b8;
        font-weight:700;
        padding:6px 10px 10px 10px;
        border-bottom:1px solid #f1f5f9;
        margin-bottom:8px;
    }
    .pos-cat-list { list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:4px; }
    .pos-cat-item {
        display:flex; align-items:center; justify-content:space-between;
        padding:10px 12px;
        border-radius:10px;
        cursor:pointer;
        text-decoration:none;
        color:#475569;
        font-weight:500;
        font-size:.95rem;
        transition:all .2s ease;
    }
    .pos-cat-item:hover {
        background:#f8fafc;
        color:#0f172a;
    }
    .pos-cat-item.active {
        background:linear-gradient(90deg, rgba(79,70,229,.95) 0%, rgba(6,182,212,.78) 100%);
        color:#ffffff;
        font-weight:600;
        box-shadow:0 4px 10px rgba(79,70,229,.25);
    }
    .pos-cat-count {
        font-size:.78rem;
        font-weight:600;
        background:#f1f5f9;
        color:#64748b;
        padding:2px 9px;
        border-radius:999px;
        min-width:28px; text-align:center;
    }
    .pos-cat-item.active .pos-cat-count { background:rgba(255,255,255,.25); color:#ffffff; }

    /* Search bar */
    .pos-toolbar {
        display:flex; gap:12px; align-items:center;
        margin-bottom:18px;
    }
    .pos-search-input { flex:1; background:#fff; color:#0f172a; border:1px solid #e2e8f0; }
    .pos-search-btn { background:#4f46e5; color:#fff; }
    .pos-add-btn { background:#4f46e5; color:#fff; font-weight:700; letter-spacing:.5px; white-space:nowrap; }

    /* Product grid card (POS-like) */
    .pos-grid {
        display:grid;
        grid-template-columns:repeat(auto-fill, minmax(190px, 1fr));
        gap:18px;
    }
    .pos-prod {
        background:#ffffff;
        border:1px solid #e2e8f0;
        border-radius:16px;
        overflow:hidden;
        transition:all .25s ease;
        display:flex; flex-direction:column;
        box-shadow:0 4px 12px rgba(15,23,42,.05);
        position:relative;
    }
    .pos-prod:hover {
        transform:translateY(-4px);
        border-color:#c7d2fe;
        box-shadow:0 12px 24px rgba(79,70,229,.15);
    }
    .pos-prod-img-wrap {
        height:150px;
        background:linear-gradient(135deg,#eef2ff 0%,#ecfeff 100%);
        position:relative;
        overflow:hidden;
        display:flex; align-items:center; justify-content:center;
    }
    .pos-prod-img { max-width:90%; max-height:90%; object-fit:contain; transition:transform .3s ease; }
    .pos-prod:hover .pos-prod-img { transform:scale(1.06); }
    .pos-prod-img-fallback { font-size:3rem; color:#a5b4fc; }

    /* Price chip overlay (giống ảnh mẫu) */
    .pos-price-chip {
        position:absolute;
        bottom:8px; left:50%;
        transform:translateX(-50%);
        background:rgba(79,70,229,.92);
        color:#ffffff;
        font-weight:700;
        font-size:.95rem;
        padding:5px 14px;
        border-radius:999px;
        box-shadow:0 4px 10px rgba(79,70,229,.35);
        letter-spacing:.3px;
    }
    .pos-stock-chip {
        position:absolute;
        top:10px; right:10px;
        font-size:.7rem;
        font-weight:700;
        padding:3px 9px;
        border-radius:999px;
        text-transform:uppercase;
    }
    .pos-stock-low { background:#fef3c7; color:#b45309; }
    .pos-stock-out { background:#fee2e2; color:#b91c1c; }
    .pos-stock-ok { background:#dcfce7; color:#166534; }
    .pos-status-off {
        position:absolute; inset:0;
        background:rgba(255,255,255,.65);
        display:flex; align-items:center; justify-content:center;
        font-weight:700; color:#94a3b8;
        text-transform:uppercase;
        letter-spacing:1px;
        font-size:.85rem;
    }

    .pos-prod-body {
        padding:12px 14px 14px 14px;
        display:flex; flex-direction:column; gap:6px;
        flex-grow:1;
    }
    .pos-prod-name {
        color:#0f172a; font-weight:600; font-size:.95rem;
        line-height:1.35;
        display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;
        overflow:hidden;
        min-height:2.6em;
    }
    .pos-prod-meta {
        display:flex; align-items:center; justify-content:space-between;
        font-size:.78rem; color:#64748b;
    }
    .pos-prod-cat-badge {
        background:#ecfeff; color:#0891b2;
        padding:2px 8px; border-radius:999px;
        border:1px solid #a5f3fc;
        font-weight:600;
        font-size:.72rem;
    }
    .pos-prod-actions {
        display:flex; gap:6px; padding:0 12px 12px 12px;
    }
    .pos-prod-actions .btn { flex:1; font-size:.82rem; font-weight:600; padding:6px 8px; }
    .pos-edit-btn { background:#4f46e5; color:#fff; }
    .pos-edit-btn:hover { background:#4338ca; color:#fff; }
    .pos-del-btn { background:#fff; color:#dc2626; border:1px solid #fecaca; }
    .pos-del-btn:hover { background:#dc2626; color:#fff; border-color:#dc2626; }

    .pos-empty { text-align:center; padding:60px 20px; color:#94a3b8; grid-column:1 / -1; }
    .pos-empty i { font-size:3rem; display:block; margin-bottom:10px; }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-uppercase pos-page-title">QUẢN LÝ <span class="accent">KHO HÀNG</span></h3>
    <a href="/products/add" class="btn shadow-sm pos-add-btn">
        <i class="bi bi-plus-lg"></i> THÊM SẢN PHẨM
    </a>
</div>

<div class="pos-layout">
    <!-- Sidebar danh mục -->
    <aside class="pos-cat-sidebar">
        <div class="pos-cat-title"><i class="bi bi-collection me-1"></i> Danh mục</div>
        <ul class="pos-cat-list">
            <li>
                <a href="/products<%= locals.searchQuery ? '?q=' + encodeURIComponent(searchQuery) : '' %>"
                   class="pos-cat-item <%= !selectedCategory ? 'active' : '' %>">
                    <span><i class="bi bi-grid-fill me-2"></i>Tất cả</span>
                    <span class="pos-cat-count"><%= totalProducts %></span>
                </a>
            </li>
            <% (categories || []).forEach(c => { %>
                <li>
                    <a href="/products?category=<%= encodeURIComponent(c.category) %><%= locals.searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>"
                       class="pos-cat-item <%= selectedCategory === c.category ? 'active' : '' %>">
                        <span><i class="bi bi-tag-fill me-2"></i><%= c.category %></span>
                        <span class="pos-cat-count"><%= c.cnt %></span>
                    </a>
                </li>
            <% }) %>
            <% if (!categories || categories.length === 0) { %>
                <li class="text-muted small px-3 py-2">Chưa có danh mục.</li>
            <% } %>
        </ul>
    </aside>

    <!-- Cột phải: search + grid -->
    <div>
        <form action="/products" method="GET" class="pos-toolbar">
            <% if (selectedCategory) { %>
                <input type="hidden" name="category" value="<%= selectedCategory %>">
            <% } %>
            <input type="text" name="q" class="form-control pos-search-input"
                   placeholder="Tìm theo tên sản phẩm hoặc danh mục..."
                   value="<%= locals.searchQuery || '' %>">
            <button type="submit" class="btn pos-search-btn"><i class="bi bi-search"></i> Tìm</button>
            <% if (locals.searchQuery || selectedCategory) { %>
                <a href="/products" class="btn btn-light"><i class="bi bi-x-lg"></i> Xóa lọc</a>
            <% } %>
        </form>

        <div class="pos-grid">
            <% if (products.length > 0) { %>
                <% products.forEach(prod => { %>
                    <div class="pos-prod">
                        <div class="pos-prod-img-wrap">
                            <% if (prod.stock_quantity <= 0) { %>
                                <span class="pos-stock-chip pos-stock-out">Hết hàng</span>
                            <% } else if (prod.stock_quantity < 10) { %>
                                <span class="pos-stock-chip pos-stock-low">Sắp hết</span>
                            <% } else { %>
                                <span class="pos-stock-chip pos-stock-ok">Còn <%= prod.stock_quantity %></span>
                            <% } %>
                            <% if (prod.image_url) { %>
                                <img src="<%= prod.image_url %>" alt="<%= prod.product_name %>" class="pos-prod-img">
                            <% } else { %>
                                <div class="pos-prod-img-fallback"><i class="bi bi-box-seam"></i></div>
                            <% } %>
                            <span class="pos-price-chip"><%= Number(prod.price).toLocaleString('vi-VN') %>đ</span>
                            <% if (prod.status !== STATUS.INVENTORY.ACTIVE) { %>
                                <div class="pos-status-off">Ngừng bán</div>
                            <% } %>
                        </div>
                        <div class="pos-prod-body">
                            <div class="pos-prod-name"><%= prod.product_name %></div>
                            <div class="pos-prod-meta">
                                <% if (prod.category) { %>
                                    <span class="pos-prod-cat-badge"><%= prod.category %></span>
                                <% } else { %>
                                    <span style="color:#cbd5e1;">—</span>
                                <% } %>
                                <span><i class="bi bi-archive me-1"></i><%= prod.stock_quantity %></span>
                            </div>
                        </div>
                        <div class="pos-prod-actions">
                            <a href="/products/edit/<%= prod.id %>" class="btn btn-sm pos-edit-btn">
                                <i class="bi bi-pencil"></i> Sửa
                            </a>
                            <form action="/products/delete/<%= prod.id %>" method="POST" class="flex-fill"
                                  data-confirm="Xóa sản phẩm này khỏi kho?">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="btn btn-sm pos-del-btn w-100">
                                    <i class="bi bi-trash"></i> Xóa
                                </button>
                            </form>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="pos-empty">
                    <i class="bi bi-box-seam"></i>
                    <% if (locals.searchQuery || selectedCategory) { %>
                        Không tìm thấy sản phẩm nào.
                        <% if (selectedCategory) { %>
                            <div class="mt-2"><small>Danh mục: <strong><%= selectedCategory %></strong></small></div>
                        <% } %>
                    <% } else { %>
                        Kho hàng đang trống. <a href="/products/add" style="color:#4f46e5;font-weight:600;">Thêm sản phẩm đầu tiên</a>.
                    <% } %>
                </div>
            <% } %>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
<% if (locals.notice) { %>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const cleanUrl = "/products" +
            (<%- JSON.stringify(locals.searchQuery || '') %> ? "?q=" + encodeURIComponent(<%- JSON.stringify(locals.searchQuery || '') %>) : "");
        const messages = {
            delete_success: { type: 'success', text: 'Đã xóa sản phẩm khỏi kho.' },
            delete_in_use: { type: 'warning', text: 'Không thể xóa sản phẩm đã nằm trong hóa đơn cũ.' },
            delete_error: { type: 'error', text: 'Không thể xóa sản phẩm. Vui lòng thử lại sau.' }
        };
        const item = messages[<%- JSON.stringify(notice) %>];
        if (item && window.Toast) Toast[item.type](item.text);
        window.history.replaceState({}, document.title, cleanUrl);
    });
</script>
<% } %>
