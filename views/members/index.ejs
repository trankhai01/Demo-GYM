<%- include('../partials/header') %>

<style>
    /* Bo góc cho bảng */
    .table-custom-dark { border-radius: 12px; overflow: hidden; }
    /* Chỉnh màu tiêu đề bảng thành đỏ thương hiệu */
    .table-custom-dark thead th { background-color: #2a2a2a; color: #e50914; border-bottom: 2px solid #e50914; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1px;}
    /* Chỉnh dòng kẻ của bảng */
    .table-custom-dark td { border-color: #333 !important; color: #e0e0e0; }
    /* Đổi màu chữ của mấy cái nút cho sáng lên */
    .btn-outline-warning { color: #ffc107; border-color: #ffc107; }
    .btn-outline-warning:hover { color: #000; background-color: #ffc107; }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-white text-uppercase" style="letter-spacing: 1px;">QUẢN LÝ <span style="color: #e50914;">HỘI VIÊN</span></h3>
    <a href="/members/add" class="btn btn-danger shadow-sm fw-bold"><i class="bi bi-plus-lg"></i> THÊM MỚI</a>
</div>

<div class="card bg-dark border-secondary shadow-lg">
    <div class="card-body p-0 table-custom-dark">
        <table class="table table-dark table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th class="ps-4 py-3">ID</th>
                    <th class="py-3">Họ và Tên</th>
                    <th class="py-3">Liên hệ</th>
                    <th class="py-3">Giới tính</th>
                    <th class="py-3">Ngày tham gia</th>
                    <th class="text-end pe-4 py-3">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                <% members.forEach(member => { %>
                <tr>
                    <td class="ps-4 text-white-50">#<%= member.id %></td>
                    <td><span class="fw-bold text-white"><%= member.fullname %></span></td>
                    <td><i class="bi bi-telephone text-white-50 me-2"></i><%= member.phone %></td>
                    <td>
                        <% if (member.gender === 'Nam') { %>
                            <span class="badge bg-primary px-3 py-2">Nam</span>
                        <% } else { %>
                            <span class="badge bg-danger px-3 py-2">Nữ</span>
                        <% } %>
                    </td>
                    <td class="text-white-50"><%= new Date(member.join_date).toLocaleDateString('vi-VN') %></td>
                    <td class="text-end pe-4">
                        <a href="/members/edit/<%= member.id %>" class="btn btn-sm btn-outline-warning me-2 shadow-sm">
                            <i class="bi bi-pencil"></i> Sửa
                        </a>
                        <a href="/members/delete/<%= member.id %>" 
                           class="btn btn-sm btn-outline-danger shadow-sm" 
                           onclick="return confirm('Bạn có chắc chắn muốn xóa hội viên này không?')">
                            <i class="bi bi-trash"></i> Xóa
                        </a>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../partials/footer') %>