<%- include('../partials/header') %>

<style>
    .pt-card { background: #1a1a1a; border: 1px solid #333; border-radius: 15px; overflow: hidden; transition: 0.3s; height: 100%; display: flex; flex-direction: column; }
    .pt-card:hover { transform: translateY(-5px); border-color: #e50914; box-shadow: 0 10px 20px rgba(229, 9, 20, 0.2); }
    .pt-img-wrapper { height: 250px; overflow: hidden; background: #222; }
    .pt-img { width: 100%; height: 100%; object-fit: cover; transition: 0.5s; }
    .pt-card:hover .pt-img { transform: scale(1.05); }
    .pt-specialty { position: absolute; top: 15px; right: 15px; background: rgba(229, 9, 20, 0.9); color: white; padding: 5px 15px; border-radius: 20px; font-size: 0.8rem; font-weight: bold; }
</style>

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-secondary">
        <div>
            <h2 class="fw-bold text-white text-uppercase m-0"><i class="bi bi-person-video3 text-danger me-2"></i>Quản lý Huấn Luyện Viên</h2>
        </div>
        <a href="/trainers/add" class="btn btn-danger rounded-pill px-4"><i class="bi bi-plus-lg me-1"></i>Thêm PT mới</a>
    </div>

    <div class="row g-4">
        <% if (trainers.length > 0) { %>
            <% trainers.forEach(pt => { %>
                <div class="col-md-4 col-lg-3">
                    <div class="pt-card position-relative">
                        <span class="pt-specialty"><%= pt.specialty %></span>
                        <div class="pt-img-wrapper">
                            <img src="<%= pt.image_url || 'https://via.placeholder.com/300x400?text=No+Image' %>" class="pt-img" alt="<%= pt.fullname %>">
                        </div>
                        <div class="p-3 d-flex flex-column flex-grow-1">
                            <h5 class="text-white fw-bold mb-1"><%= pt.fullname %></h5>
                            <div class="text-white-50 small mb-2"><i class="bi bi-telephone-fill me-2"></i><%= pt.phone %></div>
                            <div class="text-warning small mb-3"><i class="bi bi-star-fill me-1"></i>Kinh nghiệm: <%= pt.experience_years %> năm</div>
                            
                            <p class="text-secondary small line-clamp-2 flex-grow-1"><%= pt.description %></p>
                            
                            <div class="d-flex gap-2 mt-auto pt-3 border-top border-secondary">
                                <a href="/trainers/edit/<%= pt.id %>" class="btn btn-outline-warning btn-sm w-50">Sửa</a>
                                <form action="/trainers/delete/<%= pt.id %>" method="POST" class="w-50"
                                      onsubmit="return confirm('Xóa PT này?')">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="btn btn-outline-danger btn-sm w-100">Xóa</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="col-12 text-center text-white-50 py-5">
                <i class="bi bi-people fs-1 d-block mb-3"></i>
                Chưa có Huấn luyện viên nào trong hệ thống.
            </div>
        <% } %>
    </div>
</div>

<%- include('../partials/footer') %>