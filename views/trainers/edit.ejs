<%- include('../partials/header') %>

<div class="container mt-5 mb-5 d-flex justify-content-center">
  <div class="col-md-8 col-lg-6">
    <div class="bg-dark p-4 rounded-4 shadow border border-secondary">
      <h4
        class="text-white text-uppercase mb-4 border-bottom border-secondary pb-2"
      >
        <i class="bi bi-person-plus text-danger me-2"></i>Chỉnh sửa thông tin
        HLV
      </h4>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger py-2"><i class="bi bi-exclamation-triangle"></i> <%= error %></div>
      <% } %>

      <form action="/trainers/edit/<%= trainer.id %>" method="POST" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="mb-3">
          <label class="form-label text-white-50">Họ và tên *</label>
          <input
            type="text"
            name="fullname"
            class="form-control bg-dark text-white border-secondary"
            value="<%= trainer.fullname %>"
            required
          />
        </div>

        <div class="row mb-3">
          <div class="col-md-6">
            <label class="form-label text-white-50">Số điện thoại *</label>
            <input
              type="text"
              name="phone"
              class="form-control bg-dark text-white border-secondary"
              value="<%= trainer.phone %>"
              required
            />
          </div>
          <div class="col-md-6 mt-3 mt-md-0">
            <label class="form-label text-white-50">Kinh nghiệm (Năm)</label>
            <input
              type="number"
              name="experience_years"
              class="form-control bg-dark text-white border-secondary"
              min="0"
              value="<%= trainer.experience_years || 0 %>"
            />
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label text-white-50">Thế mạnh / Chuyên môn</label>
          <input
            type="text"
            name="specialty"
            class="form-control bg-dark text-white border-secondary"
            value="<%= trainer.specialty %>"
          />
        </div>

        <div class="mb-3">
          <label class="form-label text-white-50">Trạng thái</label>
          <select name="status" class="form-select bg-dark text-white border-secondary">
            <option value="<%= STATUS.TRAINER.ACTIVE %>" <%= (trainer.status || STATUS.TRAINER.ACTIVE) === STATUS.TRAINER.ACTIVE ? 'selected' : '' %>>Đang dạy</option>
            <option value="<%= STATUS.TRAINER.INACTIVE %>" <%= trainer.status === STATUS.TRAINER.INACTIVE ? 'selected' : '' %>>Nghỉ</option>
          </select>
        </div>

        <div class="mb-3">
          <label class="form-label text-white-50">Ảnh hiện tại</label><br>
          <% if (trainer.image_url) { %>
            <img src="<%= trainer.image_url %>" alt="<%= trainer.fullname %>"
                 class="rounded" style="max-width:120px; max-height:160px; object-fit:cover; background:#222;">
          <% } else { %>
            <span class="text-white-50"><i class="bi bi-person"></i> Chưa có ảnh</span>
          <% } %>
        </div>

        <div class="mb-3">
          <label class="form-label text-white-50">Upload ảnh mới (thay thế ảnh cũ)</label>
          <input type="file" name="image_file" class="form-control bg-dark text-white border-secondary" accept="image/jpeg,image/png,image/webp">
          <div class="form-text text-white-50">Tối đa 2 MB. Để trống để giữ ảnh cũ.</div>
        </div>

        <div class="mb-3">
          <label class="form-label text-white-50">Hoặc dán URL ảnh</label>
          <input
            type="text"
            name="image_url"
            class="form-control bg-dark text-white border-secondary"
            value="<%= trainer.image_url || '' %>"
            placeholder="https://..."
          />
        </div>

        <div class="mb-4">
          <label class="form-label text-white-50">Giới thiệu ngắn</label>
          <textarea
            name="description"
            class="form-control bg-dark text-white border-secondary"
            rows="4"
          >
<%= trainer.description %></textarea
          >
        </div>

        <div class="d-flex gap-3">
          <a
            href="/trainers"
            class="btn btn-secondary w-50 py-2 fw-bold"
            style="background-color: #6c757d; border: none"
          >
            Hủy
          </a>
          <button
            type="submit"
            class="btn btn-danger w-50 py-2 fw-bold"
            style="background-color: #d9534f; border: none"
          >
            Lưu thông tin
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
