<%- include('../partials/header') %>

<div class="container mt-5 mb-5 d-flex justify-content-center">
  <div class="col-md-8 col-lg-6">
    <div class="bg-dark p-4 rounded-4 shadow border border-secondary">
      <h4
        class="text-white text-uppercase mb-4 border-bottom border-secondary pb-2"
      >
        <i class="bi bi-person-plus text-danger me-2"></i>Chỉnh sửa thông tin
        HLV
      </h4>

      <form action="/trainers/edit/<%= trainer.id %>" method="POST">
        <div class="mb-3">
          <label class="form-label text-white-50">Họ và tên *</label>
          <input
            type="text"
            name="fullname"
            class="form-control bg-dark text-white border-secondary"
            value="<%= trainer.fullname %>"
            required
          />
        </div>

        <div class="row mb-3">
          <div class="col-md-6">
            <label class="form-label text-white-50">Số điện thoại *</label>
            <input
              type="text"
              name="phone"
              class="form-control bg-dark text-white border-secondary"
              value="<%= trainer.phone %>"
              required
            />
          </div>
          <div class="col-md-6 mt-3 mt-md-0">
            <label class="form-label text-white-50">Kinh nghiệm (Năm)</label>
            <input
              type="number"
              name="experience_years"
              class="form-control bg-dark text-white border-secondary"
              value="<%= trainer.experience_years || 0 %>"
            />
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label text-white-50">Thế mạnh / Chuyên môn</label>
          <input
            type="text"
            name="specialty"
            class="form-control bg-dark text-white border-secondary"
            value="<%= trainer.specialty %>"
          />
        </div>

        <div class="mb-3">
          <label class="form-label text-white-50">Link Ảnh (URL)</label>
          <input
            type="text"
            name="image_url"
            class="form-control bg-dark text-white border-secondary"
            value="<%= trainer.image_url %>"
          />
        </div>

        <div class="mb-4">
          <label class="form-label text-white-50">Giới thiệu ngắn</label>
          <textarea
            name="description"
            class="form-control bg-dark text-white border-secondary"
            rows="4"
          >
<%= trainer.description %></textarea
          >
        </div>

        <div class="d-flex gap-3">
          <a
            href="/trainers"
            class="btn btn-secondary w-50 py-2 fw-bold"
            style="background-color: #6c757d; border: none"
          >
            Hủy
          </a>
          <button
            type="submit"
            class="btn btn-danger w-50 py-2 fw-bold"
            style="background-color: #d9534f; border: none"
          >
            Lưu thông tin
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
