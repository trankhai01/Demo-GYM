<%- include('../partials/header') %>

<div class="container mt-5 mb-5 d-flex justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="bg-dark p-4 rounded-4 shadow border border-secondary">
            <h4 class="text-white text-uppercase mb-4 border-bottom border-secondary pb-2"><i class="bi bi-person-plus text-danger me-2"></i>Thêm Huấn Luyện Viên</h4>
            
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger py-2"><i class="bi bi-exclamation-triangle"></i> <%= error %></div>
            <% } %>

            <form action="/trainers/add" method="POST" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="mb-3">
                    <label class="form-label text-white-50 small">Họ và tên *</label>
                    <input type="text" name="fullname" class="form-control bg-transparent text-white border-secondary" value="<%= (locals.form && form.fullname) || '' %>" required>
                </div>
                
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label text-white-50 small">Số điện thoại *</label>
                        <input type="text" name="phone" class="form-control bg-transparent text-white border-secondary" value="<%= (locals.form && form.phone) || '' %>" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-white-50 small">Kinh nghiệm (Năm)</label>
                        <input type="number" name="experience_years" class="form-control bg-transparent text-white border-secondary" min="0" value="<%= (locals.form && form.experience_years) || 0 %>">
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-white-50 small">Thế mạnh / Chuyên môn</label>
                    <input type="text" name="specialty" class="form-control bg-transparent text-white border-secondary" value="<%= (locals.form && form.specialty) || '' %>" placeholder="VD: Giảm cân cấp tốc, Phục hồi chấn thương...">
                </div>

                <div class="mb-3">
                    <label class="form-label text-white-50 small">Trạng thái</label>
                    <select name="status" class="form-select bg-transparent text-white border-secondary">
                        <option value="<%= STATUS.TRAINER.ACTIVE %>" class="text-dark" <%= !locals.form || form.status !== STATUS.TRAINER.INACTIVE ? 'selected' : '' %>>Đang dạy</option>
                        <option value="<%= STATUS.TRAINER.INACTIVE %>" class="text-dark" <%= locals.form && form.status === STATUS.TRAINER.INACTIVE ? 'selected' : '' %>>Nghỉ</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label text-white-50 small">Upload ảnh HLV</label>
                    <input type="file" name="image_file" class="form-control bg-transparent text-white border-secondary" accept="image/jpeg,image/png,image/webp">
                    <div class="form-text text-white-50">Tối đa 2 MB. Chấp nhận JPG/PNG/WEBP.</div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-white-50 small">Hoặc dán URL ảnh</label>
                    <input type="text" name="image_url" class="form-control bg-transparent text-white border-secondary" value="<%= (locals.form && form.image_url) || '' %>" placeholder="https://...">
                </div>

                <div class="mb-4">
                    <label class="form-label text-white-50 small">Giới thiệu ngắn</label>
                    <textarea name="description" class="form-control bg-transparent text-white border-secondary" rows="3"><%= (locals.form && form.description) || '' %></textarea>
                </div>

                <div class="d-flex gap-2">
                    <a href="/trainers" class="btn btn-secondary w-50">Hủy</a>
                    <button type="submit" class="btn btn-danger w-50 fw-bold">Lưu thông tin</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
