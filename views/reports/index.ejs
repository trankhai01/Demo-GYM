<%- include('../partials/header') %>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
  .report-container {
    margin-top: 20px;
    margin-bottom: 50px;
  }
  .stat-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 30px;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
    position: relative;
    overflow: hidden;
    border-top: 4px solid #4f46e5;
  }
  .stat-card.cyan { border-top-color: #06b6d4; }
  .stat-card::after {
    content: "";
    position: absolute;
    top: -50%;
    right: -20%;
    width: 220px;
    height: 220px;
    background: radial-gradient(
      circle,
      rgba(79, 70, 229, 0.10) 0%,
      rgba(0, 0, 0, 0) 70%
    );
    border-radius: 50%;
    pointer-events: none;
  }
  .stat-card.cyan::after { background: radial-gradient(circle, rgba(6,182,212,0.10) 0%, rgba(0,0,0,0) 70%); }
  .stat-title {
    color: #64748b;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 10px;
  }
  .stat-value {
    font-family: "Oswald", sans-serif;
    font-size: 3rem;
    font-weight: 700;
    color: #4f46e5;
    line-height: 1;
    margin-bottom: 0;
  }
  .stat-value.cyan { color: #06b6d4; }
  .stat-value .unit { font-size: 1.1rem; color: #64748b; margin-left: 8px; font-weight: 500; text-transform: lowercase; letter-spacing: 0; }
  .stat-icon-wrap {
    background: linear-gradient(135deg, #4f46e5, #06b6d4);
    width: 56px; height: 56px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 8px 18px rgba(79, 70, 229, 0.30);
  }
  .stat-icon-wrap i { color: #fff; font-size: 1.4rem; }
  .chart-container {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 25px;
    margin-top: 30px;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
  }
  .chart-container h5 { color: #0f172a !important; }
  .report-header h2 { color: #0f172a !important; }
</style>

<div class="container report-container">
  <div
    class="report-header d-flex align-items-center mb-5 pb-3"
    style="border-bottom: 1px solid #e2e8f0;"
  >
    <i class="bi bi-bar-chart-line-fill fs-2 me-3" style="color:#4f46e5;"></i>
    <h2
      class="fw-bold text-uppercase m-0"
      style="letter-spacing: 1px; color:#0f172a;"
    >
      Báo cáo Doanh thu
    </h2>
  </div>

  <div class="row g-4">
    <div class="col-md-6">
      <div class="stat-card">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="stat-title">Doanh thu tháng này</div>
            <div class="stat-value">
              <%= current.total_revenue ? Number(current.total_revenue).toLocaleString('vi-VN') : '0' %><span class="unit">vnđ</span>
            </div>
          </div>
          <div class="stat-icon-wrap">
            <i class="bi bi-wallet2"></i>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="stat-card cyan">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="stat-title">Gói tập đã bán (Tháng này)</div>
            <div class="stat-value cyan">
              <%= current.total_sold || 0 %><span class="unit">Gói</span>
            </div>
          </div>
          <div class="stat-icon-wrap">
            <i class="bi bi-tags"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="chart-container">
        <h5 class="fw-bold text-uppercase mb-4">Biểu đồ doanh thu 10 ngày gần nhất</h5>
        
        <% 
            let labels = [];
            let dataPoints = [];
            if (chartData && chartData.length > 0) {
                labels = chartData.map(item => item.day_month);
                dataPoints = chartData.map(item => item.revenue);
            }
        %>

        <canvas id="revenueChart" height="100" 
                data-labels="<%= JSON.stringify(labels) %>" 
                data-points="<%= JSON.stringify(dataPoints) %>">
        </canvas>
    </div>
</div> <script>
    const canvas = document.getElementById('revenueChart');
    const ctx = canvas.getContext('2d');
    
    // Đọc dữ liệu từ dataset của thẻ canvas
    const chartLabels = JSON.parse(canvas.dataset.labels || '[]');
    const chartDataPoints = JSON.parse(canvas.dataset.points || '[]');
    
    let gradient = ctx.createLinearGradient(0, 0, 0, 400);
    gradient.addColorStop(0, 'rgba(79, 70, 229, 0.35)');
    gradient.addColorStop(1, 'rgba(6, 182, 212, 0.05)');

    new Chart(ctx, {
        type: 'line',
        data: {
            labels: chartLabels, 
            datasets: [{
                label: 'Doanh thu (VNĐ)',
                data: chartDataPoints, 
                borderColor: '#4f46e5',
                backgroundColor: gradient,
                borderWidth: 3,
                pointBackgroundColor: '#fff',
                pointBorderColor: '#4f46e5',
                pointBorderWidth: 2,
                pointRadius: 5,
                fill: true,
                tension: 0.4
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            let value = context.raw || 0;
                            return Number(value).toLocaleString('vi-VN') + ' vnđ';
                        }
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    grid: { color: 'rgba(15, 23, 42, 0.06)' },
                    ticks: { color: '#888' }
                },
                x: {
                    grid: { display: false },
                    ticks: { color: '#888' }
                }
            }
        }
    });
</script>

<%- include('../partials/footer') %>