<%- include('../partials/header') %>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
  .rep-wrap { margin: 16px 0 40px; }
  .rep-title { color:#0f172a; font-weight:700; letter-spacing:.5px; }

  .rep-filter {
    background:#fff; border:1px solid #e2e8f0; border-radius:18px;
    padding:18px 22px; box-shadow:0 6px 18px rgba(15,23,42,.05);
    display:flex; flex-wrap:wrap; align-items:end; gap:12px;
  }
  .rep-presets { display:flex; flex-wrap:wrap; gap:6px; }
  .rep-presets .btn {
    border-radius:999px; padding:6px 14px; font-size:.85rem; font-weight:600;
    border:1px solid #e2e8f0; background:#f8fafc; color:#475569;
  }
  .rep-presets .btn.active {
    background:linear-gradient(135deg,#4f46e5,#06b6d4);
    color:#fff; border-color:transparent;
    box-shadow:0 4px 12px rgba(79,70,229,.25);
  }

  .rep-export-grp { margin-left:auto; display:flex; gap:8px; }
  .rep-export-grp .btn { border-radius:10px; font-weight:600; }

  .kpi-card {
    background:#fff; border:1px solid #e2e8f0; border-radius:18px;
    padding:22px; position:relative; overflow:hidden;
    box-shadow:0 10px 24px rgba(15,23,42,.06);
    border-top:4px solid #4f46e5;
  }
  .kpi-card.cyan { border-top-color:#06b6d4; }
  .kpi-card.green { border-top-color:#10b981; }
  .kpi-card.amber { border-top-color:#f59e0b; }
  .kpi-label { color:#64748b; font-size:.78rem; text-transform:uppercase; letter-spacing:1px; font-weight:600; }
  .kpi-value { font-family:"Oswald",sans-serif; font-size:2.1rem; font-weight:700; color:#4f46e5; line-height:1; margin:8px 0 0; }
  .kpi-card.cyan .kpi-value { color:#06b6d4; }
  .kpi-card.green .kpi-value { color:#10b981; }
  .kpi-card.amber .kpi-value { color:#f59e0b; }
  .kpi-unit { font-size:.95rem; color:#64748b; font-weight:500; margin-left:4px; }
  .kpi-growth {
    display:inline-flex; align-items:center; gap:4px;
    margin-top:8px; font-size:.78rem; font-weight:700; padding:3px 10px; border-radius:999px;
  }
  .kpi-growth.up { background:#dcfce7; color:#15803d; }
  .kpi-growth.down { background:#fee2e2; color:#b91c1c; }
  .kpi-growth.flat { background:#f1f5f9; color:#64748b; }
  .kpi-icon {
    position:absolute; top:18px; right:18px;
    width:46px; height:46px; border-radius:50%;
    display:flex; align-items:center; justify-content:center;
    background:linear-gradient(135deg,#4f46e5,#06b6d4); color:#fff;
    box-shadow:0 6px 14px rgba(79,70,229,.25);
  }
  .kpi-card.cyan .kpi-icon { background:linear-gradient(135deg,#06b6d4,#0ea5e9); box-shadow:0 6px 14px rgba(6,182,212,.25); }
  .kpi-card.green .kpi-icon { background:linear-gradient(135deg,#10b981,#34d399); box-shadow:0 6px 14px rgba(16,185,129,.25); }
  .kpi-card.amber .kpi-icon { background:linear-gradient(135deg,#f59e0b,#fbbf24); box-shadow:0 6px 14px rgba(245,158,11,.25); }
  .kpi-prev { color:#94a3b8; font-size:.75rem; margin-top:8px; }

  .chart-box {
    background:#fff; border:1px solid #e2e8f0; border-radius:18px;
    padding:20px; box-shadow:0 8px 22px rgba(15,23,42,.05);
  }
  .chart-box h6 {
    color:#0f172a; font-weight:700; text-transform:uppercase;
    letter-spacing:.6px; font-size:.85rem; margin-bottom:12px;
  }
  .chart-canvas-wrap { position:relative; height:280px; }

  .txn-table {
    background:#fff; border:1px solid #e2e8f0; border-radius:18px;
    box-shadow:0 8px 22px rgba(15,23,42,.05); overflow:hidden;
  }
  .txn-table table { margin:0; }
  .txn-table thead th {
    background:#f8fafc; color:#4f46e5; font-size:.75rem;
    text-transform:uppercase; letter-spacing:.6px; font-weight:700;
    border-bottom:1px solid #e2e8f0;
  }
  .txn-table td { vertical-align:middle; font-size:.9rem; }
  .badge-kind-pkg { background:#eef2ff; color:#4f46e5; font-weight:600; padding:5px 10px; border-radius:999px; font-size:.75rem; }
  .badge-kind-pos { background:#ecfeff; color:#0e7490; font-weight:600; padding:5px 10px; border-radius:999px; font-size:.75rem; }
  .badge-status-success { background:#dcfce7; color:#15803d; font-weight:600; padding:5px 10px; border-radius:999px; font-size:.75rem; }
  .badge-status-pending { background:#fef3c7; color:#a16207; font-weight:600; padding:5px 10px; border-radius:999px; font-size:.75rem; }

  .empty-data { color:#94a3b8; font-style:italic; text-align:center; padding:30px 0; }
</style>

<div class="container-fluid rep-wrap">

  <div class="d-flex align-items-center justify-content-between mb-4 pb-3" style="border-bottom:1px solid #e2e8f0;">
    <div class="d-flex align-items-center gap-3">
      <i class="bi bi-bar-chart-line-fill" style="color:#4f46e5; font-size:1.8rem;"></i>
      <h2 class="rep-title mb-0 text-uppercase">Báo cáo & Phân tích</h2>
    </div>
    <div class="text-muted small">
      Kỳ này: <strong style="color:#4f46e5;"><%= from %></strong> → <strong style="color:#4f46e5;"><%= to %></strong>
      &nbsp;|&nbsp; So sánh kỳ trước: <%= prev.from %> → <%= prev.to %>
    </div>
  </div>

  <form method="get" action="/reports" class="rep-filter mb-4">
    <div class="rep-presets">
      <% const presets = [
        ['today','Hôm nay'],['7d','7 ngày'],['30d','30 ngày'],
        ['month','Tháng này'],['quarter','Quý này'],['year','Năm nay']
      ]; %>
      <% presets.forEach(([k,label])=>{ %>
        <button name="preset" value="<%= k %>" class="btn <%= preset===k?'active':'' %>"><%= label %></button>
      <% }) %>
    </div>
    <div style="min-width:160px;">
      <label class="form-label small text-uppercase fw-bold mb-1" style="color:#64748b; letter-spacing:.6px;">Từ ngày</label>
      <input type="date" name="from" value="<%= from %>" class="form-control">
    </div>
    <div style="min-width:160px;">
      <label class="form-label small text-uppercase fw-bold mb-1" style="color:#64748b; letter-spacing:.6px;">Đến ngày</label>
      <input type="date" name="to" value="<%= to %>" class="form-control">
    </div>
    <button class="btn btn-primary" style="border-radius:10px;"><i class="bi bi-funnel-fill"></i> Lọc</button>

    <div class="rep-export-grp">
      <a href="/reports/export/pdf?from=<%= from %>&to=<%= to %>" class="btn btn-outline-danger" target="_blank" rel="noopener">
        <i class="bi bi-file-pdf"></i> Xuất PDF
      </a>
      <a href="/reports/export/excel?from=<%= from %>&to=<%= to %>" class="btn btn-outline-success">
        <i class="bi bi-file-earmark-spreadsheet"></i> Xuất Excel
      </a>
    </div>
  </form>

  <% function growthTag(v){
       const cls = v > 0 ? 'up' : (v < 0 ? 'down' : 'flat');
       const ico = v > 0 ? 'arrow-up-short' : (v < 0 ? 'arrow-down-short' : 'dash');
       const sign = v > 0 ? '+' : (v < 0 ? '' : '±');
       return `<span class="kpi-growth ${cls}"><i class="bi bi-${ico}"></i>${sign}${v.toFixed(1)}%</span>`;
     } %>

  <div class="row g-3 mb-4">
    <div class="col-md-3 col-sm-6">
      <div class="kpi-card">
        <div class="kpi-icon"><i class="bi bi-wallet2"></i></div>
        <div class="kpi-label">Doanh thu</div>
        <div class="kpi-value">
          <%= Number(cur.revenue).toLocaleString('vi-VN') %><span class="kpi-unit">vnđ</span>
        </div>
        <%- growthTag(growth.revenue) %>
        <div class="kpi-prev">Kỳ trước: <%= Number(prv.revenue).toLocaleString('vi-VN') %> vnđ</div>
      </div>
    </div>
    <div class="col-md-3 col-sm-6">
      <div class="kpi-card cyan">
        <div class="kpi-icon"><i class="bi bi-tags-fill"></i></div>
        <div class="kpi-label">Gói tập đã bán</div>
        <div class="kpi-value">
          <%= cur.pkgSold %><span class="kpi-unit">gói</span>
        </div>
        <%- growthTag(growth.pkgSold) %>
        <div class="kpi-prev">Kỳ trước: <%= prv.pkgSold %> gói</div>
      </div>
    </div>
    <div class="col-md-3 col-sm-6">
      <div class="kpi-card green">
        <div class="kpi-icon"><i class="bi bi-door-open-fill"></i></div>
        <div class="kpi-label">Lượt check-in</div>
        <div class="kpi-value">
          <%= cur.checkins %><span class="kpi-unit">lượt</span>
        </div>
        <%- growthTag(growth.checkins) %>
        <div class="kpi-prev">Kỳ trước: <%= prv.checkins %> lượt</div>
      </div>
    </div>
    <div class="col-md-3 col-sm-6">
      <div class="kpi-card amber">
        <div class="kpi-icon"><i class="bi bi-person-plus-fill"></i></div>
        <div class="kpi-label">Hội viên mới</div>
        <div class="kpi-value">
          <%= cur.newMembers %><span class="kpi-unit">HV</span>
        </div>
        <%- growthTag(growth.newMembers) %>
        <div class="kpi-prev">Kỳ trước: <%= prv.newMembers %> HV</div>
      </div>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-lg-8">
      <div class="chart-box">
        <h6><i class="bi bi-graph-up-arrow"></i> Doanh thu theo ngày</h6>
        <div class="chart-canvas-wrap"><canvas id="chartDailyRev"></canvas></div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="chart-box h-100">
        <h6><i class="bi bi-pie-chart-fill"></i> Gói tập vs POS</h6>
        <div class="chart-canvas-wrap"><canvas id="chartPosVsPkg"></canvas></div>
      </div>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-lg-6">
      <div class="chart-box">
        <h6><i class="bi bi-bar-chart-fill"></i> Doanh thu theo gói tập</h6>
        <div class="chart-canvas-wrap"><canvas id="chartByPackage"></canvas></div>
      </div>
    </div>
    <div class="col-lg-6">
      <div class="chart-box">
        <h6><i class="bi bi-people-fill"></i> Top HLV (số buổi PT)</h6>
        <div class="chart-canvas-wrap"><canvas id="chartTopTrainers"></canvas></div>
      </div>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-12">
      <div class="chart-box">
        <h6><i class="bi bi-activity"></i> Lượt check-in theo ngày</h6>
        <div class="chart-canvas-wrap"><canvas id="chartCheckins"></canvas></div>
      </div>
    </div>
  </div>

  <div class="txn-table mb-4">
    <div class="d-flex justify-content-between align-items-center px-4 pt-3 pb-2">
      <h6 class="mb-0 text-uppercase fw-bold" style="color:#0f172a; letter-spacing:.6px;">
        <i class="bi bi-list-ul" style="color:#4f46e5;"></i> Giao dịch chi tiết
        <span class="badge" style="background:#eef2ff;color:#4f46e5;margin-left:6px;"><%= txnTotal %></span>
      </h6>
    </div>
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead>
          <tr>
            <th class="ps-4">ID</th>
            <th>Ngày</th>
            <th>Hội viên</th>
            <th>Loại</th>
            <th>Gói tập</th>
            <th class="text-end">Giá</th>
            <th class="text-end">Giảm</th>
            <th class="text-end">Thực thu</th>
            <th>Trạng thái</th>
            <th class="pe-4">Thanh toán</th>
          </tr>
        </thead>
        <tbody>
          <% if (!transactions || transactions.length === 0) { %>
            <tr><td colspan="10"><div class="empty-data">Không có giao dịch trong khoảng thời gian này.</div></td></tr>
          <% } else { transactions.forEach(t => {
              const dateObj = t.registration_date instanceof Date ? t.registration_date : (t.registration_date ? new Date(t.registration_date) : null);
              const pad = n => String(n).padStart(2,'0');
              const dateStr = dateObj ? `${pad(dateObj.getDate())}/${pad(dateObj.getMonth()+1)}/${dateObj.getFullYear()}` : '—';
              const price = Number(t.price)||0;
              const disc = Number(t.discount_amount)||0;
          %>
            <tr>
              <td class="ps-4 fw-bold" style="color:#4f46e5;">#<%= t.id %></td>
              <td><%= dateStr %></td>
              <td><%= t.member_name || '—' %></td>
              <td>
                <% if (t.kind === 'Gói tập') { %>
                  <span class="badge-kind-pkg"><%= t.kind %></span>
                <% } else { %>
                  <span class="badge-kind-pos"><%= t.kind %></span>
                <% } %>
              </td>
              <td><%= t.package_name || '' %></td>
              <td class="text-end"><%= price.toLocaleString('vi-VN') %></td>
              <td class="text-end" style="color:#dc2626;"><%= disc > 0 ? '-' + disc.toLocaleString('vi-VN') : '' %></td>
              <td class="text-end fw-bold" style="color:#0f172a;"><%= (price-disc).toLocaleString('vi-VN') %></td>
              <td>
                <% if (t.payment_status === STATUS.PAYMENT.SUCCESS) { %>
                  <span class="badge-status-success">Đã thanh toán</span>
                <% } else { %>
                  <span class="badge-status-pending">Chờ TT</span>
                <% } %>
              </td>
              <td class="pe-4"><%= t.payment_method || '' %></td>
            </tr>
          <% }) } %>
        </tbody>
      </table>
    </div>

    <% const totalPages = Math.max(1, Math.ceil(txnTotal / pageSize)); %>
    <% if (totalPages > 1) { %>
      <nav class="px-4 py-3" style="border-top:1px solid #e2e8f0;">
        <ul class="pagination justify-content-center mb-0">
          <% for (let p = 1; p <= totalPages; p++) { %>
            <li class="page-item <%= p===page?'active':'' %>">
              <a class="page-link" href="?from=<%= from %>&to=<%= to %>&page=<%= p %>"><%= p %></a>
            </li>
          <% } %>
        </ul>
      </nav>
    <% } %>
  </div>
</div>

<script id="rep-data" type="application/json"><%- JSON.stringify({
    dailyRev, dailyCk, byPackage, posVsPackage, topTrainers
}) %></script>

<script>
(function(){
  const data = JSON.parse(document.getElementById('rep-data').textContent);

  const palette = {
    indigo: '#4f46e5',
    cyan: '#06b6d4',
    green: '#10b981',
    amber: '#f59e0b',
    rose: '#f43f5e',
    violet: '#8b5cf6',
    slate: '#64748b'
  };
  const palArr = [palette.indigo, palette.cyan, palette.green, palette.amber, palette.rose, palette.violet, palette.slate];

  function mkLineChart(id, points, color, fmtY) {
    const el = document.getElementById(id);
    if (!el) return;
    const ctx = el.getContext('2d');
    const grad = ctx.createLinearGradient(0,0,0,260);
    grad.addColorStop(0, color + '55');
    grad.addColorStop(1, color + '08');
    new Chart(ctx, {
      type: 'line',
      data: {
        labels: points.map(p => p.label),
        datasets: [{
          label: '',
          data: points.map(p => p.value),
          borderColor: color,
          backgroundColor: grad,
          borderWidth: 2.5,
          fill: true,
          tension: .35,
          pointRadius: 3,
          pointBackgroundColor: color
        }]
      },
      options: {
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          y: {
            beginAtZero: true,
            ticks: { callback: v => fmtY ? fmtY(v) : v }
          }
        }
      }
    });
  }

  mkLineChart('chartDailyRev', data.dailyRev, palette.indigo, v => (v/1000).toFixed(0)+'k');
  mkLineChart('chartCheckins', data.dailyCk, palette.green);

  (function(){
    const el = document.getElementById('chartByPackage');
    if (!el || !data.byPackage.length) {
      if (el) el.parentElement.innerHTML = '<div style="height:280px;display:flex;align-items:center;justify-content:center;color:#94a3b8;font-style:italic;">Chưa có dữ liệu</div>';
      return;
    }
    new Chart(el.getContext('2d'), {
      type: 'bar',
      data: {
        labels: data.byPackage.map(p => p.name),
        datasets: [{
          label: 'Doanh thu',
          data: data.byPackage.map(p => p.revenue),
          backgroundColor: data.byPackage.map((_,i) => palArr[i % palArr.length] + 'cc'),
          borderRadius: 8,
          borderSkipped: false
        }]
      },
      options: {
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: true, ticks: { callback: v => (v/1000).toFixed(0)+'k' } } }
      }
    });
  })();

  (function(){
    const el = document.getElementById('chartPosVsPkg');
    if (!el) return;
    const pkg = data.posVsPackage.pkg, pos = data.posVsPackage.pos;
    if (pkg === 0 && pos === 0) {
      el.parentElement.innerHTML = '<div style="height:280px;display:flex;align-items:center;justify-content:center;color:#94a3b8;font-style:italic;">Chưa có dữ liệu</div>';
      return;
    }
    new Chart(el.getContext('2d'), {
      type: 'doughnut',
      data: {
        labels: ['Gói tập', 'POS'],
        datasets: [{
          data: [pkg, pos],
          backgroundColor: [palette.indigo, palette.cyan],
          borderWidth: 0
        }]
      },
      options: {
        maintainAspectRatio: false,
        cutout: '65%',
        plugins: {
          legend: { position: 'bottom' }
        }
      }
    });
  })();

  (function(){
    const el = document.getElementById('chartTopTrainers');
    if (!el || !data.topTrainers.length) {
      if (el) el.parentElement.innerHTML = '<div style="height:280px;display:flex;align-items:center;justify-content:center;color:#94a3b8;font-style:italic;">Chưa có dữ liệu</div>';
      return;
    }
    new Chart(el.getContext('2d'), {
      type: 'bar',
      data: {
        labels: data.topTrainers.map(t => t.name),
        datasets: [{
          label: 'Số buổi PT',
          data: data.topTrainers.map(t => t.sessions),
          backgroundColor: palette.violet + 'cc',
          borderRadius: 8
        }]
      },
      options: {
        maintainAspectRatio: false,
        indexAxis: 'y',
        plugins: { legend: { display: false } },
        scales: { x: { beginAtZero: true, ticks: { precision: 0 } } }
      }
    });
  })();
})();
</script>

<%- include('../partials/footer') %>
