<%- include('../partials/header') %>

<style>
    .pricing-card { 
        background: #ffffff; 
        border: 1px solid #e2e8f0; 
        border-radius: 24px; 
        transition: all 0.3s ease; 
        overflow: hidden; 
        box-shadow: 0 4px 20px rgba(15, 23, 42, 0.04);
    }
    .pricing-card:hover { 
        transform: translateY(-10px); 
        border-color: #4f46e5; 
        box-shadow: 0 15px 35px rgba(79, 70, 229, 0.18); 
    }
    .duration-badge { 
        background: rgba(79, 70, 229, 0.1); 
        color: #4f46e5; 
        padding: 6px 16px; 
        border-radius: 20px; 
        font-weight: 700; 
        font-size: 0.85rem; 
        letter-spacing: 1px;
    }
    .price-amount { 
        font-family: 'Oswald', sans-serif; 
        font-size: 3.2rem; 
        font-weight: 700; 
        color: #4f46e5; 
        line-height: 1.2;
    }
    .feature-list { 
        list-style: none; 
        padding: 0; 
        color: #64748b; 
        text-align: left; 
    }
    .feature-list li { 
        margin-bottom: 15px; 
        font-size: 0.95rem; 
    }
    .feature-list i { 
        color: #47cf73; 
        margin-right: 12px; 
        font-size: 1.1rem;
    }
    .action-box { 
        background: rgba(15, 23, 42, 0.06); 
        padding: 20px; 
        border-top: 1px solid #e2e8f0; 
    }
</style>

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h2 class="fw-bold text-uppercase m-0" style="letter-spacing: 1.5px; color:#0f172a;">Danh sách gói tập</h2>
        <a href="/packages/add" class="btn fw-bold px-4 py-2 rounded-pill shadow-sm" style="background:#4f46e5;color:#fff;">
            <i class="bi bi-plus-lg me-2"></i>Thêm gói mới
        </a>
    </div>

    <div class="row g-4">
        <% packages.forEach(pkg => { %>
        <div class="col-lg-4 col-md-6">
            <div class="pricing-card text-center h-100 d-flex flex-column">
                <div class="p-4 flex-grow-1 mt-2">
                    <div class="mb-4">
                        <span class="duration-badge text-uppercase"><%= pkg.duration_months %> Tháng</span>
                    </div>
                    
                    <h5 class="text-uppercase fw-bold mb-3" style="color:#475569;"><%= pkg.package_name %></h5>
                    
                    <div class="price-amount mb-4">
    <%= Number(pkg.price).toLocaleString('vi-VN') %><span class="fs-5 ms-2" style="color:#94a3b8;">vnđ</span>
</div>
                    
                    <hr class="mx-3 mb-4" style="border-color:#e2e8f0;opacity:1;">
                    
                    <div class="text-start mt-4 mb-4" style="min-height: 120px;">
    <% if (pkg.description) { %>
        <% 
            let benefits = pkg.description.split(/\r?\n/).filter(line => line.trim() !== ''); 
        %>
        <% benefits.forEach(benefit => { %>
            <div class="small mb-2 text-truncate" style="color:#475569;" title="<%= benefit.trim() %>">
                <i class="bi bi-check-circle-fill me-2" style="color:#10b981;"></i><%= benefit.trim() %>
            </div>
        <% }) %>
    <% } else { %>
        <div class="small fst-italic" style="color:#94a3b8;">Chưa có mô tả quyền lợi.</div>
    <% } %>
</div>
                </div>
                
                <div class="action-box d-flex gap-2 justify-content-center">
                    <a href="/packages/edit/<%= pkg.id %>" class="btn w-50 rounded-pill fw-bold" style="background:#4f46e5;color:#fff;border:none;">
                        <i class="bi bi-pencil-square me-1"></i>Sửa
                    </a>
                    <form action="/packages/delete/<%= pkg.id %>" method="POST" class="w-50"
                          data-confirm="Bạn chắc chắn muốn xóa gói này?">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn w-100 rounded-pill fw-bold" style="background:#dc2626;color:#fff;border:none;">
                            <i class="bi bi-trash me-1"></i>Xóa
                        </button>
                    </form>
                </div>
            </div>
        </div>
        <% }) %>
    </div>
</div>

<%- include('../partials/footer') %>
<% if (locals.notice) { %>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const messages = {
            delete_success: { type: 'success', text: 'Đã xóa gói tập thành công.' },
            delete_in_use: { type: 'warning', text: 'Không thể xóa gói tập đang có hội viên hoặc hóa đơn sử dụng.' },
            delete_error: { type: 'error', text: 'Không thể xóa gói tập. Vui lòng thử lại sau.' }
        };
        const item = messages[<%- JSON.stringify(notice) %>];
        if (item && window.Toast) Toast[item.type](item.text);
        window.history.replaceState({}, document.title, "/packages");
    });
</script>
<% } %>
