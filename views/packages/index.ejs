<%- include('../partials/header') %>

<style>
    .pricing-card { 
        background: linear-gradient(145deg, #1e1e1e 0%, #111 100%); 
        border: 1px solid #333; 
        border-radius: 24px; 
        transition: all 0.3s ease; 
        overflow: hidden; 
    }
    .pricing-card:hover { 
        transform: translateY(-10px); 
        border-color: #e50914; 
        box-shadow: 0 15px 35px rgba(229, 9, 20, 0.15); 
    }
    .duration-badge { 
        background: rgba(229, 9, 20, 0.1); 
        color: #e50914; 
        padding: 6px 16px; 
        border-radius: 20px; 
        font-weight: 700; 
        font-size: 0.85rem; 
        letter-spacing: 1px;
    }
    .price-amount { 
        font-family: 'Oswald', sans-serif; 
        font-size: 3.2rem; 
        font-weight: 700; 
        color: #fff; 
        line-height: 1.2;
    }
    .feature-list { 
        list-style: none; 
        padding: 0; 
        color: #aaa; 
        text-align: left; 
    }
    .feature-list li { 
        margin-bottom: 15px; 
        font-size: 0.95rem; 
    }
    .feature-list i { 
        color: #47cf73; 
        margin-right: 12px; 
        font-size: 1.1rem;
    }
    .action-box { 
        background: rgba(0, 0, 0, 0.4); 
        padding: 20px; 
        border-top: 1px solid #333; 
    }
</style>

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h2 class="fw-bold text-white text-uppercase m-0" style="letter-spacing: 1.5px;">Danh sách gói tập</h2>
        <a href="/packages/add" class="btn btn-danger fw-bold px-4 py-2 rounded-pill shadow-sm">
            <i class="bi bi-plus-lg me-2"></i>Thêm gói mới
        </a>
    </div>

    <div class="row g-4">
        <% packages.forEach(pkg => { %>
        <div class="col-lg-4 col-md-6">
            <div class="pricing-card text-center h-100 d-flex flex-column">
                <div class="p-4 flex-grow-1 mt-2">
                    <div class="mb-4">
                        <span class="duration-badge text-uppercase"><%= pkg.duration_months %> Tháng</span>
                    </div>
                    
                    <h5 class="text-white-50 text-uppercase fw-bold mb-3"><%= pkg.package_name %></h5>
                    
                    <div class="price-amount mb-4">
    <%= Number(pkg.price).toLocaleString('vi-VN') %><span class="fs-5 text-white-50 ms-2">vnđ</span>
</div>
                    
                    <hr class="border-secondary mx-3 opacity-50 mb-4">
                    
                    <div class="text-start mt-4 mb-4" style="min-height: 120px;">
    <% if (pkg.description) { %>
        <% 
            let benefits = pkg.description.split(/\r?\n/).filter(line => line.trim() !== ''); 
        %>
        <% benefits.forEach(benefit => { %>
            <div class="text-white-50 small mb-2 text-truncate" title="<%= benefit.trim() %>">
                <i class="bi bi-check-circle-fill text-success me-2"></i><%= benefit.trim() %>
            </div>
        <% }) %>
    <% } else { %>
        <div class="text-white-50 small fst-italic">Chưa có mô tả quyền lợi.</div>
    <% } %>
</div>
                </div>
                
                <div class="action-box d-flex gap-2 justify-content-center">
                    <a href="/packages/edit/<%= pkg.id %>" class="btn btn-outline-light w-50 rounded-pill fw-bold">Sửa</a>
                    <form action="/packages/delete/<%= pkg.id %>" method="POST" class="w-50"
                          onsubmit="return confirm('Bạn chắc chắn muốn xóa gói này?')">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-outline-danger w-100 rounded-pill fw-bold">Xóa</button>
                    </form>
                </div>
            </div>
        </div>
        <% }) %>
    </div>
</div>

<%- include('../partials/footer') %>