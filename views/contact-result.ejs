<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= ok ? 'Đã gửi' : 'Lỗi' %> — GYM BRO</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body { background:#0a0a0a; color:#fff; min-height:100vh; display:flex; align-items:center; justify-content:center; font-family:'Segoe UI', Tahoma, sans-serif; }
        .card { background:#1a1a1a; border:1px solid #333; border-radius:16px; max-width:520px; padding:40px; text-align:center; }
        .icon-wrap i { font-size:4rem; }
        .icon-ok { color:#22c55e; }
        .icon-err { color:#e50914; }
        .btn-gym { background:#e50914; color:#fff; padding:12px 28px; font-weight:600; border-radius:30px; }
        .btn-gym:hover { background:#b00610; color:#fff; }
    </style>
</head>
<body>
    <div class="card shadow-lg">
        <div class="icon-wrap mb-3">
            <% if (ok) { %>
                <i class="bi bi-check-circle-fill icon-ok"></i>
            <% } else { %>
                <i class="bi bi-exclamation-triangle-fill icon-err"></i>
            <% } %>
        </div>
        <h3 class="mb-3"><%= ok ? 'Cảm ơn bạn!' : 'Có lỗi xảy ra' %></h3>
        <p class="text-white-50"><%= message %></p>
        <a href="/" class="btn btn-gym mt-3"><i class="bi bi-arrow-left"></i> Về trang chủ</a>
    </div>
</body>
</html>
