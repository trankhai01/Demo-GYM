<!DOCTYPE html>
<html lang="<%= lang || 'vi' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <title>Thanh toán gói tập - <%= settings.gym_name || 'GYM BRO' %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        :root {
            --brand: #4f46e5;
            --brand-2: #06b6d4;
            --ink: #0f172a;
            --muted: #64748b;
            --line: #e2e8f0;
            --panel: #ffffff;
            --soft: #f8fafc;
        }
        body {
            min-height: 100vh;
            background:
                radial-gradient(circle at top left, rgba(79, 70, 229, .14), transparent 32rem),
                radial-gradient(circle at bottom right, rgba(6, 182, 212, .14), transparent 36rem),
                #f1f5f9;
            color: var(--ink);
            font-family: 'Segoe UI', system-ui, sans-serif;
        }
        .checkout-shell {
            width: min(1120px, calc(100% - 32px));
            margin: 0 auto;
            padding: 48px 0;
        }
        .checkout-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
        }
        .brand {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            font-weight: 900;
            letter-spacing: 1px;
            font-size: 2rem;
        }
        .brand i { color: var(--brand-2); }
        .checkout-card {
            background: var(--panel);
            border: 1px solid var(--line);
            border-radius: 14px;
            box-shadow: 0 24px 60px rgba(15, 23, 42, .10);
            overflow: hidden;
        }
        .order-panel {
            background: var(--soft);
            border-right: 1px solid var(--line);
            height: 100%;
        }
        .eyebrow {
            color: var(--brand);
            font-size: .82rem;
            font-weight: 800;
            letter-spacing: .06em;
            text-transform: uppercase;
        }
        .selected-package {
            border: 1px solid var(--line);
            border-left: 4px solid var(--brand);
            border-radius: 10px;
            background: #fff;
            padding: 18px;
        }
        .info-row {
            display: flex;
            justify-content: space-between;
            gap: 16px;
            padding: 16px 0;
            border-bottom: 1px solid var(--line);
        }
        .info-row span:first-child {
            color: var(--muted);
            font-weight: 700;
            text-transform: uppercase;
            font-size: .82rem;
        }
        .total {
            color: var(--brand);
            font-weight: 900;
            font-size: clamp(2.4rem, 5vw, 3.5rem);
            letter-spacing: -1px;
        }
        .payment-panel {
            display: flex;
            min-height: 620px;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 48px;
        }
        .qr-box {
            display: inline-block;
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 14px;
            padding: 16px;
            box-shadow: 0 18px 40px rgba(15, 23, 42, .12);
        }
        .qr-box img {
            width: min(280px, 72vw);
            height: auto;
            display: block;
        }
        .status-note {
            border: 1px solid #bae6fd;
            background: #ecfeff;
            color: #155e75;
            border-radius: 10px;
            padding: 14px 16px;
            text-align: left;
        }
        .success-icon {
            width: 88px;
            height: 88px;
            border-radius: 50%;
            background: #16a34a;
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            margin-bottom: 24px;
        }
        @media (max-width: 991px) {
            .order-panel { border-right: 0; border-bottom: 1px solid var(--line); }
            .payment-panel { min-height: auto; padding: 36px 22px; }
        }
    </style>
</head>
<body>
    <main class="checkout-shell">
        <div class="checkout-top">
            <a href="/" class="brand text-decoration-none text-dark">
                <i class="bi bi-heart-pulse-fill"></i>
                <span><%= settings.gym_name || 'GYM BRO' %></span>
            </a>
            <div class="d-flex align-items-center gap-2">
                <span class="text-secondary fw-semibold d-none d-sm-inline"><i class="bi bi-shield-lock-fill"></i> Thanh toán bảo mật</span>
                <a href="/" class="btn btn-light border" aria-label="Đóng"><i class="bi bi-x-lg"></i></a>
            </div>
        </div>

        <div class="checkout-card">
            <div class="row g-0">
                <div class="col-lg-5">
                    <section class="order-panel p-4 p-lg-5">
                        <div class="eyebrow mb-2">Thông tin đơn hàng</div>
                        <h1 class="fw-black mb-4">Hóa đơn #<%= invoice.id %></h1>

                        <div class="selected-package mb-4">
                            <div class="text-secondary fw-bold text-uppercase small mb-2">
                                <i class="bi bi-ticket-perforated"></i>
                                <%= invoice.upgrade_from_registration_id ? 'Gói tập nâng cấp' : 'Gói tập đã chọn' %>
                            </div>
                            <h4 class="fw-bold mb-1"><%= invoice.package_name %></h4>
                            <div class="text-secondary">
                                <%= invoice.duration_months %> tháng
                                <% if (Number(invoice.pt_sessions) > 0) { %>
                                    · <%= invoice.pt_sessions %> buổi PT
                                <% } %>
                            </div>
                        </div>

                        <% if (invoice.upgrade_from_registration_id) { %>
                            <div class="info-row">
                                <span>Gói hiện tại</span>
                                <strong><%= invoice.upgrade_from_package_name || 'Gói cũ' %></strong>
                            </div>
                            <div class="info-row">
                                <span>Giá gói mới</span>
                                <strong><%= Number(invoice.package_price || 0).toLocaleString('vi-VN') %>đ</strong>
                            </div>
                            <div class="info-row">
                                <span>Khấu trừ còn lại</span>
                                <strong class="text-success">-<%= Number(invoice.upgrade_credit_amount || 0).toLocaleString('vi-VN') %>đ</strong>
                            </div>
                            <% if (invoice.upgrade_days_remaining && invoice.upgrade_total_days) { %>
                                <div class="text-secondary small mb-3">
                                    Tính theo <%= invoice.upgrade_days_remaining %>/<%= invoice.upgrade_total_days %> ngày còn lại của gói hiện tại.
                                </div>
                            <% } %>
                        <% } %>

                        <div class="info-row">
                            <span>Hội viên</span>
                            <strong><%= invoice.member_name %></strong>
                        </div>
                        <div class="info-row">
                            <span>Số điện thoại</span>
                            <strong><%= invoice.member_phone %></strong>
                        </div>
                        <div class="info-row">
                            <span>Trạng thái</span>
                            <% if (invoice.payment_status === STATUS.PAYMENT.SUCCESS) { %>
                                <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2"><i class="bi bi-check-circle-fill"></i> Đã thanh toán</span>
                            <% } else { %>
                                <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis px-3 py-2"><i class="bi bi-clock-fill"></i> Chờ chuyển khoản</span>
                            <% } %>
                        </div>

                        <!-- Mã ưu đãi -->
                        <div class="mt-4 border-top pt-4">
                            <div class="eyebrow mb-2">Mã ưu đãi</div>
                            <div class="input-group mb-2">
                                <input type="text" id="discountInput" class="form-control" placeholder="Nhập mã ưu đãi" 
                                       value="<%= invoice.discount_code_id ? 'Đã áp dụng mã' : '' %>"
                                       <%= invoice.discount_code_id ? 'disabled' : '' %> style="text-transform:uppercase;">
                                <% if (invoice.discount_code_id) { %>
                                    <button class="btn btn-outline-danger shadow-sm fw-bold" type="button" id="btnRemoveDiscount">Hủy</button>
                                <% } else { %>
                                    <button class="btn btn-outline-primary shadow-sm fw-bold" type="button" id="btnApplyDiscount">Áp dụng</button>
                                <% } %>
                            </div>
                            <div id="discountStatus" class="small">
                                <% if (invoice.discount_code_id && Number(invoice.discount_amount) > 0) { %>
                                    <span class="text-success">
                                        <i class="bi bi-check-circle-fill"></i> Đã giảm -<%= Number(invoice.discount_amount).toLocaleString('vi-VN') %>đ
                                    </span>
                                <% } %>
                            </div>
                        </div>

                        <div class="mt-4 border-top pt-4">
                            <div class="text-secondary fw-bold text-uppercase small mb-2">Tổng thanh toán</div>
                            <div class="total"><%= Number(invoice.price).toLocaleString('vi-VN') %>đ</div>
                        </div>
                    </section>
                </div>

                <div class="col-lg-7">
                    <section class="payment-panel">
                        <% if (invoice.payment_status === STATUS.PAYMENT.SUCCESS) { %>
                            <div>
                                <div class="success-icon"><i class="bi bi-check-lg"></i></div>
                                <h2 class="fw-bold mb-3">Thanh toán thành công</h2>
                                <p class="text-secondary fs-5 mb-4">
                                    <%= invoice.upgrade_from_registration_id
                                        ? 'Gói tập đã được nâng cấp. Bạn có thể tiếp tục đặt lịch theo gói mới.'
                                        : 'Gói tập đã được kích hoạt. Bạn có thể bắt đầu đặt lịch tập ngay bây giờ.' %>
                                </p>
                                <a href="/dashboard" class="btn btn-primary btn-lg px-5 fw-bold">
                                    <i class="bi bi-arrow-right-circle"></i> Về trang tổng quan
                                </a>
                            </div>
                        <% } else { %>
                            <div class="w-100" style="max-width: 480px;">
                                <div class="eyebrow mb-2">Thanh toán qua payOS</div>
                                <h2 class="fw-bold mb-3">
                                    <%= invoice.upgrade_from_registration_id
                                        ? 'Quét mã QR để hoàn tất nâng cấp'
                                        : 'Quét mã QR để hoàn tất đăng ký' %>
                                </h2>
                                <p class="text-secondary mb-4">
                                    <%= invoice.upgrade_from_registration_id
                                        ? 'Gói mới sẽ được áp dụng tự động sau khi payOS xác nhận giao dịch.'
                                        : 'Gói tập sẽ được kích hoạt tự động sau khi payOS xác nhận giao dịch.' %>
                                </p>

                                <% if (payosPayment && payosPayment.qr_code) { %>
                                    <div class="qr-box mb-4">
                                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=320x320&data=<%= encodeURIComponent(payosPayment.qr_code) %>" alt="Mã QR payOS">
                                    </div>
                                <% } else { %>
                                    <div class="qr-box mb-4 text-secondary">
                                        <i class="bi bi-qr-code" style="font-size: 6rem;"></i>
                                    </div>
                                <% } %>

                                <% if (payosPayment && payosPayment.checkout_url) { %>
                                    <a href="<%= payosPayment.checkout_url %>" target="_blank" rel="noopener" class="btn btn-primary btn-lg w-100 fw-bold mb-3">
                                        <i class="bi bi-box-arrow-up-right"></i> Mở trang thanh toán payOS
                                    </a>
                                <% } %>

                                <% if (!payosConfigured) { %>
                                    <div class="alert alert-warning text-start">
                                        Chưa cấu hình payOS. Vui lòng thêm <code>PAYOS_CLIENT_ID</code>, <code>PAYOS_API_KEY</code> và <code>PAYOS_CHECKSUM_KEY</code> trong file <code>.env</code>.
                                    </div>
                                <% } else if (payosCreateError) { %>
                                    <div class="alert alert-warning text-start">
                                        Không thể tạo thanh toán payOS: <%= payosCreateError.message %>
                                    </div>
                                <% } else { %>
                                    <div class="status-note mb-4">
                                        <i class="bi bi-arrow-repeat me-1"></i>
                                        Đang chờ payOS xác nhận giao dịch.
                                    </div>
                                <% } %>

                                <form action="/membership/checkout/cancel/<%= invoice.id %>" method="POST"
                                      data-confirm="Hủy đơn đăng ký gói tập này?">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="btn btn-outline-secondary w-100 fw-bold">
                                        <i class="bi bi-x-circle"></i> Hủy đơn và chọn gói khác
                                    </button>
                                </form>
                            </div>
                        <% } %>
                    </section>
                </div>
            </div>
        </div>
    </main>

    <% if (invoice.payment_status !== STATUS.PAYMENT.SUCCESS) { %>
        <script>
            const statusUrl = "/membership/checkout/status/<%= invoice.id %>";
            setInterval(async () => {
                try {
                    const res = await fetch(statusUrl, { headers: { "Accept": "application/json" } });
                    if (!res.ok) return;
                    const data = await res.json();
                    if (data.payment_status === "<%= STATUS.PAYMENT.SUCCESS %>") {
                        window.location.reload();
                    }
                } catch (err) {}
            }, 3000);

            // Xử lý áp dụng/hủy mã ưu đãi
            const btnApply = document.getElementById('btnApplyDiscount');
            const btnRemove = document.getElementById('btnRemoveDiscount');
            const discountInput = document.getElementById('discountInput');
            const discountStatus = document.getElementById('discountStatus');
            const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

            if (btnApply) {
                btnApply.addEventListener('click', async () => {
                    const code = discountInput.value.trim();
                    if (!code) return alert('Vui lòng nhập mã ưu đãi.');

                    btnApply.disabled = true;
                    try {
                        const res = await fetch('/membership/checkout/<%= invoice.id %>/apply-discount', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'x-csrf-token': csrfToken
                            },
                            body: JSON.stringify({ code })
                        });
                        const data = await res.json();
                        if (data.ok) {
                            discountStatus.innerHTML = `<span class="text-success"><i class="bi bi-check-circle-fill"></i> ${data.message}</span>`;
                            setTimeout(() => window.location.reload(), 800);
                        } else {
                            discountStatus.innerHTML = `<span class="text-danger"><i class="bi bi-exclamation-triangle-fill"></i> ${data.error}</span>`;
                            btnApply.disabled = false;
                        }
                    } catch (err) {
                        alert('Có lỗi xảy ra, vui lòng thử lại.');
                        btnApply.disabled = false;
                    }
                });
            }

            if (btnRemove) {
                btnRemove.addEventListener('click', async () => {
                    btnRemove.disabled = true;
                    try {
                        const res = await fetch('/membership/checkout/<%= invoice.id %>/remove-discount', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'x-csrf-token': csrfToken
                            }
                        });
                        const data = await res.json();
                        if (data.ok) {
                            discountStatus.innerHTML = `<span class="text-success"><i class="bi bi-check-circle-fill"></i> ${data.message}</span>`;
                            setTimeout(() => window.location.reload(), 800);
                        } else {
                            discountStatus.innerHTML = `<span class="text-danger"><i class="bi bi-exclamation-triangle-fill"></i> ${data.error}</span>`;
                            btnRemove.disabled = false;
                        }
                    } catch (err) {
                        alert('Có lỗi xảy ra, vui lòng thử lại.');
                        btnRemove.disabled = false;
                    }
                });
            }
        </script>
    <% } %>
</body>
</html>
