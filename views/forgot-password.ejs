<!DOCTYPE html>
<html lang="<%= lang %>">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= t('forgot.title_tab') %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@600;700&display=swap" rel="stylesheet" />
    <style>
      :root {
        --gb-primary: #4f46e5;
        --gb-primary-600: #4338ca;
        --gb-accent: #06b6d4;
        --gb-bg: #f8fafc;
        --gb-surface: #ffffff;
        --gb-text: #0f172a;
      }
      body {
        background: linear-gradient(135deg, #eef2ff 0%, #ecfeff 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        margin: 0;
        font-family: "Inter", "Segoe UI", sans-serif;
        color: var(--gb-text);
      }
      .login-card {
        width: 460px;
        padding: 40px;
        border-radius: 16px;
        background: var(--gb-surface);
        border: 1px solid #e2e8f0;
        box-shadow: 0 12px 40px rgba(15, 23, 42, 0.08);
      }
      .brand-name {
        font-family: "Oswald", sans-serif;
        font-weight: 700;
        font-size: 2.4rem;
        letter-spacing: 3px;
        text-align: center;
        background: linear-gradient(90deg, var(--gb-primary), var(--gb-accent));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }
      .form-label { color: #334155; font-weight: 600; }
      .form-control:focus {
        border-color: var(--gb-primary);
        box-shadow: 0 0 0 0.2rem rgba(79, 70, 229, 0.15);
      }
      .btn-gym {
        background: linear-gradient(90deg, var(--gb-primary), var(--gb-accent));
        color: white;
        font-weight: 700;
        padding: 12px 0;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: 0.3s;
        border-radius: 8px;
        border: none;
      }
      .btn-gym:hover { filter: brightness(0.95); color: white; }
      .btn-gym:disabled { opacity: 0.7; cursor: not-allowed; }

      /* Step indicator */
      .step-indicator {
        display: flex;
        justify-content: center;
        gap: 8px;
        margin-bottom: 20px;
      }
      .step-dot {
        width: 10px; height: 10px;
        border-radius: 50%;
        background: #cbd5e1;
        transition: all 0.3s ease;
      }
      .step-dot.active {
        background: var(--gb-primary);
        transform: scale(1.3);
      }
      .step-dot.done {
        background: #22c55e;
      }

      /* OTP input styling */
      .otp-inputs {
        display: flex;
        gap: 8px;
        justify-content: center;
        margin: 20px 0;
      }
      .otp-inputs input {
        width: 48px; height: 56px;
        text-align: center;
        font-size: 1.5rem;
        font-weight: 700;
        border: 2px solid #e2e8f0;
        border-radius: 10px;
        color: var(--gb-primary-600);
        transition: border-color 0.2s, box-shadow 0.2s;
        outline: none;
      }
      .otp-inputs input:focus {
        border-color: var(--gb-primary);
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
      }

      /* Countdown timer */
      .countdown {
        text-align: center;
        font-size: 0.85rem;
        color: #64748b;
        margin-top: 12px;
      }
      .countdown strong { color: var(--gb-primary); }

      /* Step sections */
      .step-section { display: none; }
      .step-section.active { display: block; animation: fadeIn 0.3s ease; }
      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
      }

      /* Password strength */
      .pw-strength {
        height: 4px;
        border-radius: 2px;
        background: #e2e8f0;
        margin-top: 6px;
        overflow: hidden;
      }
      .pw-strength-bar {
        height: 100%;
        width: 0%;
        border-radius: 2px;
        transition: width 0.3s, background 0.3s;
      }

      /* Alert styles */
      .alert-box {
        padding: 10px 14px;
        border-radius: 8px;
        font-size: 0.88rem;
        margin-bottom: 16px;
        display: none;
      }
      .alert-box.show { display: block; animation: fadeIn 0.25s ease; }
      .alert-box.success { background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; }
      .alert-box.error { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }

      /* Toggle password */
      .input-password-wrap {
        position: relative;
      }
      .input-password-wrap .toggle-pw {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        color: #94a3b8;
        font-size: 1.1rem;
        background: none;
        border: none;
        padding: 0;
      }
      .input-password-wrap .toggle-pw:hover { color: var(--gb-primary); }
    </style>
  </head>
  <body>
    <div class="login-card">
      <div class="d-flex justify-content-end mb-2">
        <%- include('partials/lang-switch') %>
      </div>
      <div class="text-center mb-3">
        <h1 class="brand-name mb-0"><%= (systemSettings && systemSettings.gym_name) || 'GYM BRO' %></h1>
        <p class="text-muted small"><%= t('forgot.subtitle') %></p>
      </div>

      <!-- Step indicator -->
      <div class="step-indicator">
        <div class="step-dot active" id="dot-1"></div>
        <div class="step-dot" id="dot-2"></div>
        <div class="step-dot" id="dot-3"></div>
      </div>

      <!-- Alert box -->
      <div class="alert-box" id="alertBox"></div>

      <!-- =============== STEP 1: Nhập SĐT + Email =============== -->
      <div class="step-section active" id="step-1">
        <p class="text-muted small mb-3">
          Nhập số điện thoại và email đã đăng ký. Hệ thống sẽ gửi mã OTP về email của bạn.
        </p>
        <form id="formStep1">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="mb-3">
            <label class="form-label"><%= t('forgot.phone') %></label>
            <input type="text" name="phone" id="inputPhone" class="form-control"
                   placeholder="<%= t('forgot.phone_ph') %>" required autofocus />
          </div>
          <div class="mb-4">
            <label class="form-label">Email đã đăng ký</label>
            <input type="email" name="email" id="inputEmail" class="form-control"
                   placeholder="email@gmail.com" required />
          </div>
          <button type="submit" class="btn btn-gym w-100 shadow" id="btnStep1">
            <i class="bi bi-envelope-arrow-up"></i> Gửi mã OTP
          </button>
        </form>
      </div>

      <!-- =============== STEP 2: Nhập OTP =============== -->
      <div class="step-section" id="step-2">
        <p class="text-muted small mb-2 text-center">
          Nhập mã OTP 6 chữ số đã gửi đến email của bạn.
        </p>
        <form id="formStep2">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="otp-inputs" id="otpInputs">
            <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]" autocomplete="one-time-code" />
            <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]" />
            <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]" />
            <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]" />
            <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]" />
            <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]" />
          </div>
          <div class="countdown" id="countdown">
            Mã hết hạn sau <strong id="countdownTimer">5:00</strong>
          </div>
          <button type="submit" class="btn btn-gym w-100 shadow mt-3" id="btnStep2">
            <i class="bi bi-shield-check"></i> Xác thực OTP
          </button>
        </form>
        <div class="text-center mt-3">
          <button class="btn btn-link btn-sm text-decoration-none" id="btnResend" style="color: var(--gb-primary); display: none;">
            <i class="bi bi-arrow-repeat"></i> Gửi lại mã OTP
          </button>
        </div>
      </div>

      <!-- =============== STEP 3: Đặt mật khẩu mới =============== -->
      <div class="step-section" id="step-3">
        <p class="text-muted small mb-3 text-center">
          Nhập mật khẩu mới cho tài khoản của bạn.
        </p>
        <form id="formStep3">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="mb-3">
            <label class="form-label">Mật khẩu mới</label>
            <div class="input-password-wrap">
              <input type="password" name="password" id="inputNewPw" class="form-control"
                     placeholder="Tối thiểu 6 ký tự" required minlength="6" />
              <button type="button" class="toggle-pw" tabindex="-1"><i class="bi bi-eye"></i></button>
            </div>
            <div class="pw-strength"><div class="pw-strength-bar" id="pwStrengthBar"></div></div>
          </div>
          <div class="mb-4">
            <label class="form-label">Xác nhận mật khẩu mới</label>
            <div class="input-password-wrap">
              <input type="password" name="confirmPassword" id="inputConfirmPw" class="form-control"
                     placeholder="Nhập lại mật khẩu" required minlength="6" />
              <button type="button" class="toggle-pw" tabindex="-1"><i class="bi bi-eye"></i></button>
            </div>
          </div>
          <button type="submit" class="btn btn-gym w-100 shadow" id="btnStep3">
            <i class="bi bi-check2-circle"></i> Đặt mật khẩu mới
          </button>
        </form>
      </div>

      <!-- Back to login -->
      <div class="text-center mt-4">
        <a href="/login" style="color: var(--gb-primary); font-size: 0.9rem; text-decoration: none;">
          <i class="bi bi-arrow-left"></i> <%= t('forgot.back') %>
        </a>
      </div>
    </div>

    <script>
    (function() {
      const csrfToken = '<%= csrfToken %>';
      const alertBox = document.getElementById('alertBox');

      function showAlert(type, msg) {
        alertBox.className = 'alert-box show ' + type;
        alertBox.innerHTML = (type === 'error'
          ? '<i class="bi bi-exclamation-triangle-fill me-1"></i>'
          : '<i class="bi bi-check-circle-fill me-1"></i>') + msg;
      }
      function hideAlert() { alertBox.className = 'alert-box'; }

      function goToStep(n) {
        document.querySelectorAll('.step-section').forEach(s => s.classList.remove('active'));
        document.getElementById('step-' + n).classList.add('active');
        for (let i = 1; i <= 3; i++) {
          const dot = document.getElementById('dot-' + i);
          dot.classList.remove('active', 'done');
          if (i < n) dot.classList.add('done');
          else if (i === n) dot.classList.add('active');
        }
        hideAlert();
      }

      function setLoading(btn, loading) {
        if (loading) {
          btn.dataset.origHtml = btn.innerHTML;
          btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang xử lý...';
          btn.disabled = true;
        } else {
          btn.innerHTML = btn.dataset.origHtml;
          btn.disabled = false;
        }
      }

      // ─── STEP 1 ─────────────────────────────────────────────────
      document.getElementById('formStep1').addEventListener('submit', async function(e) {
        e.preventDefault();
        hideAlert();
        const btn = document.getElementById('btnStep1');
        const phone = document.getElementById('inputPhone').value.trim();
        const email = document.getElementById('inputEmail').value.trim();
        if (!phone || !email) return showAlert('error', 'Vui lòng điền đầy đủ thông tin.');

        setLoading(btn, true);
        try {
          const resp = await fetch('/forgot-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
            body: JSON.stringify({ phone, email })
          });
          const data = await resp.json();
          if (data.ok) {
            showAlert('success', data.message);
            setTimeout(() => { goToStep(2); startCountdown(); }, 1200);
          } else {
            showAlert('error', data.error);
          }
        } catch (err) {
          showAlert('error', 'Lỗi kết nối. Vui lòng thử lại.');
        }
        setLoading(btn, false);
      });

      // ─── STEP 2: OTP input handling ────────────────────────────
      const otpInputs = document.querySelectorAll('#otpInputs input');
      otpInputs.forEach((inp, i) => {
        inp.addEventListener('input', function() {
          this.value = this.value.replace(/\D/g, '');
          if (this.value && i < otpInputs.length - 1) otpInputs[i + 1].focus();
        });
        inp.addEventListener('keydown', function(e) {
          if (e.key === 'Backspace' && !this.value && i > 0) otpInputs[i - 1].focus();
        });
        inp.addEventListener('paste', function(e) {
          e.preventDefault();
          const pasted = (e.clipboardData.getData('text') || '').replace(/\D/g, '').slice(0, 6);
          pasted.split('').forEach((ch, idx) => { if (otpInputs[idx]) otpInputs[idx].value = ch; });
          if (pasted.length > 0) otpInputs[Math.min(pasted.length, 5)].focus();
        });
      });

      function getOtpValue() {
        return Array.from(otpInputs).map(i => i.value).join('');
      }

      let countdownInterval = null;
      function startCountdown() {
        let seconds = 300; // 5 minutes
        const timerEl = document.getElementById('countdownTimer');
        const resendBtn = document.getElementById('btnResend');
        resendBtn.style.display = 'none';
        clearInterval(countdownInterval);
        countdownInterval = setInterval(() => {
          seconds--;
          const m = Math.floor(seconds / 60);
          const s = seconds % 60;
          timerEl.textContent = m + ':' + String(s).padStart(2, '0');
          if (seconds <= 0) {
            clearInterval(countdownInterval);
            timerEl.textContent = '0:00';
            resendBtn.style.display = 'inline-block';
          }
        }, 1000);
      }

      document.getElementById('btnResend').addEventListener('click', function() {
        // Re-submit step 1 automatically
        goToStep(1);
      });

      document.getElementById('formStep2').addEventListener('submit', async function(e) {
        e.preventDefault();
        hideAlert();
        const btn = document.getElementById('btnStep2');
        const otp = getOtpValue();
        if (otp.length !== 6) return showAlert('error', 'Vui lòng nhập đủ 6 chữ số OTP.');

        setLoading(btn, true);
        try {
          const resp = await fetch('/forgot-password/verify-otp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
            body: JSON.stringify({ otp })
          });
          const data = await resp.json();
          if (data.ok) {
            clearInterval(countdownInterval);
            showAlert('success', data.message);
            setTimeout(() => goToStep(3), 800);
          } else {
            showAlert('error', data.error);
          }
        } catch (err) {
          showAlert('error', 'Lỗi kết nối. Vui lòng thử lại.');
        }
        setLoading(btn, false);
      });

      // ─── STEP 3: New password ──────────────────────────────────
      // Password strength indicator
      document.getElementById('inputNewPw').addEventListener('input', function() {
        const val = this.value;
        const bar = document.getElementById('pwStrengthBar');
        let strength = 0;
        if (val.length >= 6) strength++;
        if (val.length >= 8) strength++;
        if (/[A-Z]/.test(val)) strength++;
        if (/[0-9]/.test(val)) strength++;
        if (/[^A-Za-z0-9]/.test(val)) strength++;
        const pct = Math.min(strength * 20, 100);
        bar.style.width = pct + '%';
        if (pct <= 40) bar.style.background = '#ef4444';
        else if (pct <= 60) bar.style.background = '#f59e0b';
        else bar.style.background = '#22c55e';
      });

      // Toggle password visibility
      document.querySelectorAll('.toggle-pw').forEach(btn => {
        btn.addEventListener('click', function() {
          const input = this.parentElement.querySelector('input');
          const icon = this.querySelector('i');
          if (input.type === 'password') {
            input.type = 'text';
            icon.className = 'bi bi-eye-slash';
          } else {
            input.type = 'password';
            icon.className = 'bi bi-eye';
          }
        });
      });

      document.getElementById('formStep3').addEventListener('submit', async function(e) {
        e.preventDefault();
        hideAlert();
        const btn = document.getElementById('btnStep3');
        const password = document.getElementById('inputNewPw').value;
        const confirmPassword = document.getElementById('inputConfirmPw').value;

        if (password.length < 6) return showAlert('error', 'Mật khẩu phải có ít nhất 6 ký tự.');
        if (password !== confirmPassword) return showAlert('error', 'Mật khẩu xác nhận không khớp.');

        setLoading(btn, true);
        try {
          const resp = await fetch('/forgot-password/reset', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
            body: JSON.stringify({ password, confirmPassword })
          });
          const data = await resp.json();
          if (data.ok) {
            showAlert('success', data.message);
            setTimeout(() => { window.location.href = '/login'; }, 2000);
          } else {
            showAlert('error', data.error);
          }
        } catch (err) {
          showAlert('error', 'Lỗi kết nối. Vui lòng thử lại.');
        }
        setLoading(btn, false);
      });

    })();
    </script>
  </body>
</html>
