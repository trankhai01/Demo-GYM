<!DOCTYPE html>
<html lang="<%= lang %>">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= t('forgot.title_tab') %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@600;700&display=swap" rel="stylesheet" />
    <style>
      :root {
        --gb-primary: #4f46e5;
        --gb-primary-600: #4338ca;
        --gb-accent: #06b6d4;
        --gb-bg: #f8fafc;
        --gb-surface: #ffffff;
        --gb-text: #0f172a;
      }
      body {
        background: linear-gradient(135deg, #eef2ff 0%, #ecfeff 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        margin: 0;
        font-family: "Inter", "Segoe UI", sans-serif;
        color: var(--gb-text);
      }
      .login-card {
        width: 460px;
        padding: 40px;
        border-radius: 16px;
        background: var(--gb-surface);
        border: 1px solid #e2e8f0;
        box-shadow: 0 12px 40px rgba(15, 23, 42, 0.08);
      }
      .brand-name {
        font-family: "Oswald", sans-serif;
        font-weight: 700;
        font-size: 2.4rem;
        letter-spacing: 3px;
        text-align: center;
        background: linear-gradient(90deg, var(--gb-primary), var(--gb-accent));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }
      .form-label { color: #334155; font-weight: 600; }
      .form-control:focus {
        border-color: var(--gb-primary);
        box-shadow: 0 0 0 0.2rem rgba(79, 70, 229, 0.15);
      }
      .btn-gym {
        background: linear-gradient(90deg, var(--gb-primary), var(--gb-accent));
        color: white;
        font-weight: 700;
        padding: 12px 0;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: 0.3s;
        border-radius: 8px;
        border: none;
      }
      .btn-gym:hover { filter: brightness(0.95); color: white; }
    </style>
  </head>
  <body>
    <div class="login-card">
      <div class="d-flex justify-content-end mb-2">
        <%- include('partials/lang-switch') %>
      </div>
      <div class="text-center mb-4">
        <h1 class="brand-name mb-0"><%= (systemSettings && systemSettings.gym_name) || 'GYM BRO' %></h1>
        <p class="text-muted small"><%= t('forgot.subtitle') %></p>
      </div>

      <% if (locals.message) { %>
        <div class="alert alert-success p-3 mb-3" style="font-size: 0.9rem; border-radius: 8px;">
          <i class="bi bi-check-circle-fill me-1"></i> <%= message %>
        </div>
      <% } %>

      <% if (locals.error) { %>
        <div class="alert alert-danger text-center p-2 mb-3" style="font-size: 0.9rem; border-radius: 8px;">
          <i class="bi bi-exclamation-triangle-fill me-1"></i> <%= error %>
        </div>
      <% } %>

      <% if (!locals.message) { %>
        <p class="text-muted small mb-3">
          Nhập số điện thoại và email đã đăng ký. Hệ thống sẽ gửi mật khẩu mới về email của bạn.
        </p>

        <form action="/forgot-password" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="mb-3">
            <label class="form-label"><%= t('forgot.phone') %></label>
            <input type="text" name="phone" class="form-control"
                   placeholder="<%= t('forgot.phone_ph') %>"
                   value="<%= locals.phone || '' %>" required autofocus />
          </div>
          <div class="mb-4">
            <label class="form-label">Email đã đăng ký</label>
            <input type="email" name="email" class="form-control"
                   placeholder="email@gmail.com"
                   value="<%= locals.email || '' %>" required />
          </div>
          <button type="submit" class="btn btn-gym w-100 shadow">
            <i class="bi bi-envelope-arrow-up"></i> Gửi mật khẩu mới qua email
          </button>
        </form>
      <% } %>

      <div class="text-center mt-4">
        <a href="/login" style="color: var(--gb-primary); font-size: 0.9rem; text-decoration: none;">
          <i class="bi bi-arrow-left"></i> <%= t('forgot.back') %>
        </a>
      </div>
    </div>
  </body>
</html>
