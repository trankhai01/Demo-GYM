<!DOCTYPE html>
<html lang="<%= lang %>">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= t('forgot.title_tab') %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@600;700&display=swap" rel="stylesheet" />
    <style>
      body {
        background-color: #121212;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100vh;
        margin: 0;
        font-family: "Segoe UI", sans-serif;
      }
      .login-card {
        width: 440px;
        padding: 40px;
        border-radius: 15px;
        background: #1e1e1e;
        border: 1px solid #333;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.7);
      }
      .brand-name {
        font-family: "Oswald", sans-serif;
        color: #e50914;
        font-weight: 700;
        font-size: 2.4rem;
        letter-spacing: 3px;
        text-align: center;
      }
      .form-control {
        background-color: #2a2a2a;
        border: 1px solid #444;
        color: #fff;
      }
      .form-control:focus {
        background-color: #2a2a2a;
        border-color: #e50914;
        color: #fff;
        box-shadow: 0 0 0 0.25rem rgba(229, 9, 20, 0.25);
      }
      .form-control::placeholder { color: #777; }
      .form-label { color: #d1d1d1; font-weight: 600; }
      .btn-gym {
        background-color: #e50914;
        color: white;
        font-weight: 700;
        padding: 12px 0;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: 0.3s;
        border-radius: 8px;
      }
      .btn-gym:hover { background-color: #b20710; color: white; }
    </style>
  </head>
  <body>
    <div class="login-card">
      <div class="d-flex justify-content-end mb-2">
        <%- include('partials/lang-switch') %>
      </div>
      <div class="text-center mb-4">
        <h1 class="brand-name mb-0">GYM BRO</h1>
        <p class="text-white-50 small"><%= t('forgot.subtitle') %></p>
      </div>

      <% if (locals.message) { %>
        <div class="alert alert-success p-3 mb-3" style="font-size: 0.9rem; border-radius: 8px;">
          <i class="bi bi-check-circle-fill me-1"></i> <%= message %>
        </div>
      <% } %>

      <% if (locals.error) { %>
        <div class="alert alert-danger text-center p-2 mb-3" style="font-size: 0.9rem; border-radius: 8px;">
          <i class="bi bi-exclamation-triangle-fill me-1"></i> <%= error %>
        </div>
      <% } %>

      <% if (!locals.message) { %>
        <p class="text-white-50 small mb-3">
          <%= t('forgot.instructions') %>
        </p>

        <form action="/forgot-password" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="mb-3">
            <label class="form-label"><%= t('forgot.phone') %></label>
            <input
              type="text"
              name="phone"
              class="form-control"
              placeholder="<%= t('forgot.phone_ph') %>"
              value="<%= locals.phone || '' %>"
              required
              autofocus
            />
          </div>
          <div class="mb-4">
            <label class="form-label"><%= t('forgot.note') %></label>
            <input
              type="text"
              name="note"
              class="form-control"
              placeholder="<%= t('forgot.note_ph') %>"
              maxlength="255"
            />
          </div>
          <button type="submit" class="btn btn-gym w-100 shadow">
            <i class="bi bi-send"></i> <%= t('forgot.submit') %>
          </button>
        </form>
      <% } %>

      <div class="text-center mt-4">
        <a href="/login" style="color: #888; font-size: 0.9rem; text-decoration: none;">
          <i class="bi bi-arrow-left"></i> <%= t('forgot.back') %>
        </a>
      </div>
    </div>
  </body>
</html>
