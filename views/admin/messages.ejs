<%- include('../partials/header') %>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="text-white mb-0"><i class="bi bi-envelope-paper text-danger me-2"></i> Tin nhắn liên hệ</h2>
            <small class="text-white-50">Tin nhắn khách gửi từ form Liên hệ trên trang chủ.</small>
        </div>
        <div class="btn-group">
            <a href="/admin/messages" class="btn btn-sm <%= filter === 'all' ? 'btn-danger' : 'btn-outline-danger' %>">
                Tất cả
            </a>
            <a href="/admin/messages?filter=unread" class="btn btn-sm <%= filter === 'unread' ? 'btn-danger' : 'btn-outline-danger' %>">
                Chưa đọc
                <% if (unreadCount > 0) { %>
                    <span class="badge bg-light text-dark ms-1"><%= unreadCount %></span>
                <% } %>
            </a>
        </div>
    </div>

    <% if (!messages || messages.length === 0) { %>
        <div class="card p-5 text-center">
            <i class="bi bi-inbox text-white-50" style="font-size:3rem;"></i>
            <p class="text-white-50 mt-3 mb-0">
                <%= filter === 'unread' ? 'Không có tin nhắn chưa đọc.' : 'Chưa có tin nhắn nào.' %>
            </p>
        </div>
    <% } else { %>
        <div class="row g-3">
            <% messages.forEach(m => { %>
                <div class="col-12">
                    <div class="card <%= m.is_read ? '' : 'border-danger' %>">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                <div>
                                    <h5 class="mb-1">
                                        <%= m.fullname %>
                                        <% if (!m.is_read) { %>
                                            <span class="badge bg-danger ms-2">Mới</span>
                                        <% } %>
                                    </h5>
                                    <div class="small text-white-50">
                                        <i class="bi bi-envelope me-1"></i>
                                        <a href="mailto:<%= m.email %>" class="text-info"><%= m.email %></a>
                                        <% if (m.phone) { %>
                                            &nbsp;·&nbsp;<i class="bi bi-telephone me-1"></i>
                                            <a href="tel:<%= m.phone %>" class="text-info"><%= m.phone %></a>
                                        <% } %>
                                    </div>
                                    <div class="small text-white-50 mt-1">
                                        <i class="bi bi-clock me-1"></i>
                                        <%= new Date(m.created_at).toLocaleString('vi-VN') %>
                                    </div>
                                </div>
                                <div class="d-flex gap-2">
                                    <% if (!m.is_read) { %>
                                        <form method="POST" action="/admin/messages/<%= m.id %>/read" class="d-inline">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <input type="hidden" name="filter" value="<%= filter %>">
                                            <button type="submit" class="btn btn-sm btn-outline-success">
                                                <i class="bi bi-check2"></i> Đánh dấu đã đọc
                                            </button>
                                        </form>
                                    <% } %>
                                    <form method="POST" action="/admin/messages/<%= m.id %>/delete" class="d-inline"
                                          onsubmit="return confirm('Xóa tin nhắn này?');">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <input type="hidden" name="filter" value="<%= filter %>">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i> Xóa
                                        </button>
                                    </form>
                                </div>
                            </div>
                            <% if (m.subject) { %>
                                <div class="mt-3">
                                    <strong class="text-warning">Chủ đề:</strong> <%= m.subject %>
                                </div>
                            <% } %>
                            <div class="mt-2 p-3 rounded" style="background:#0f0f0f; border-left:4px solid #e50914; white-space:pre-wrap;">
<%= m.message %>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>
</div>

</body>
</html>
