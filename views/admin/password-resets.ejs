<%- include('../partials/header', { user: user }) %>

<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-key-fill text-primary"></i> Lịch sử đặt lại mật khẩu</h2>
    <span class="text-muted">Tổng: <%= history.length %> yêu cầu</span>
  </div>

  <div class="alert alert-info border-0 shadow-sm">
    <i class="bi bi-info-circle"></i>
    Hội viên dùng mục <a href="/forgot-password">Quên mật khẩu</a> sẽ được hệ thống tự động sinh mật khẩu mới và gửi qua email.
    Trang này hiển thị nhật ký để admin theo dõi.
  </div>

  <div class="card">
    <div class="card-header">
      <i class="bi bi-clock-history"></i> Lịch sử (50 gần nhất)
    </div>
    <div class="card-body p-0">
      <% if (history.length === 0) { %>
        <p class="text-center text-muted my-4 mb-0">Chưa có yêu cầu reset mật khẩu nào.</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>#</th>
                <th>Hội viên</th>
                <th>SĐT</th>
                <th>Email</th>
                <th>Thời gian xử lý</th>
                <th>Ghi chú</th>
                <th>Trạng thái</th>
              </tr>
            </thead>
            <tbody>
              <% history.forEach(h => { %>
                <tr>
                  <td><%= h.id %></td>
                  <td><strong><%= h.fullname %></strong></td>
                  <td><%= h.phone %></td>
                  <td class="small text-muted"><%= h.email || '—' %></td>
                  <td><%= h.resolved_at ? new Date(h.resolved_at).toLocaleString('vi-VN') : new Date(h.requested_at).toLocaleString('vi-VN') %></td>
                  <td class="small text-muted"><%= h.note || '—' %></td>
                  <td>
                    <% if (h.status === 'resolved') { %>
                      <span class="badge bg-success">Đã reset</span>
                    <% } else if (h.status === 'dismissed') { %>
                      <span class="badge bg-secondary">Bỏ qua</span>
                    <% } else { %>
                      <span class="badge bg-warning text-dark">Pending</span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
