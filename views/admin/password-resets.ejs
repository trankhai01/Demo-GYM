<%- include('../partials/header', { user: user }) %>

<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-white"><i class="bi bi-key-fill text-danger"></i> Yêu cầu đổi mật khẩu</h2>
    <span class="text-muted">Tổng: <%= pending.length %> yêu cầu chờ xử lý</span>
  </div>

  <% if (tempPassword) { %>
    <div class="alert alert-success border-0 shadow-sm mb-4">
      <h5 class="mb-2"><i class="bi bi-shield-check"></i> Đã đặt lại mật khẩu thành công</h5>
      <p class="mb-1">Hội viên ID <strong>#<%= tempMember %></strong> dùng mật khẩu tạm thời sau để đăng nhập:</p>
      <div class="p-3 rounded mt-2 mb-2 text-center" style="background:#eef2ff;border:1px dashed #4f46e5;font-family: 'Courier New', monospace; font-size: 1.4rem; letter-spacing: 4px; color: #4338ca;">
        <%= tempPassword %>
      </div>
      <% if (typeof tempEmailSent !== 'undefined' && tempEmailSent) { %>
        <p class="small mb-1"><i class="bi bi-envelope-check text-success"></i> Đã gửi email tới <strong><%= tempEmailSent %></strong>.</p>
      <% } %>
      <p class="small mb-0">
        <i class="bi bi-info-circle"></i> Mật khẩu này chỉ hiển thị 1 lần. Hội viên nên đăng nhập rồi vào <a href="/profile/change-password">Đổi mật khẩu</a> để chọn mật khẩu mới.
      </p>
    </div>
  <% } %>

  <div class="card mb-4">
    <div class="card-header bg-dark text-white border-0">
      <i class="bi bi-hourglass-split text-warning"></i> Đang chờ xử lý
    </div>
    <div class="card-body p-0">
      <% if (pending.length === 0) { %>
        <div class="text-center py-4 text-muted">
          <i class="bi bi-inbox" style="font-size: 2rem;"></i>
          <p class="mb-0 mt-2">Không có yêu cầu nào đang chờ xử lý.</p>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>#</th>
                <th>Hội viên</th>
                <th>Số điện thoại</th>
                <th>Thời gian gửi</th>
                <th>Ghi chú</th>
                <th class="text-end">Hành động</th>
              </tr>
            </thead>
            <tbody>
              <% pending.forEach(p => { %>
                <tr>
                  <td><%= p.id %></td>
                  <td><strong><%= p.fullname %></strong></td>
                  <td><%= p.phone %></td>
                  <td><%= new Date(p.requested_at).toLocaleString('vi-VN') %></td>
                  <td class="text-muted small"><%= p.note || '—' %></td>
                  <td class="text-end">
                    <form action="/admin/password-resets/<%= p.id %>/reset" method="POST" class="d-inline"
                          onsubmit="return confirm('Sinh mật khẩu mới cho hội viên này? Mật khẩu cũ sẽ không còn dùng được.');">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <button class="btn btn-sm btn-success">
                        <i class="bi bi-key-fill"></i> Reset mật khẩu
                      </button>
                    </form>
                    <form action="/admin/password-resets/<%= p.id %>/dismiss" method="POST" class="d-inline"
                          onsubmit="return confirm('Bỏ qua yêu cầu này?');">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <button class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-x-circle"></i> Bỏ qua
                      </button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-header bg-dark text-white border-0">
      <i class="bi bi-clock-history"></i> Lịch sử (30 gần nhất)
    </div>
    <div class="card-body p-0">
      <% if (history.length === 0) { %>
        <p class="text-center text-muted my-4 mb-0">Chưa có yêu cầu nào được xử lý.</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>#</th>
                <th>Hội viên</th>
                <th>SĐT</th>
                <th>Gửi lúc</th>
                <th>Xử lý lúc</th>
                <th>Bởi</th>
                <th>Trạng thái</th>
              </tr>
            </thead>
            <tbody>
              <% history.forEach(h => { %>
                <tr>
                  <td><%= h.id %></td>
                  <td><%= h.fullname %></td>
                  <td><%= h.phone %></td>
                  <td><%= new Date(h.requested_at).toLocaleString('vi-VN') %></td>
                  <td><%= h.resolved_at ? new Date(h.resolved_at).toLocaleString('vi-VN') : '—' %></td>
                  <td><%= h.resolver_name || '—' %></td>
                  <td>
                    <% if (h.status === 'resolved') { %>
                      <span class="badge bg-success">Đã reset</span>
                    <% } else { %>
                      <span class="badge bg-secondary">Bỏ qua</span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
