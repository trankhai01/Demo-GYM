<%- include('../partials/header') %>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="text-white mb-0"><i class="bi bi-sliders text-danger me-2"></i> Cấu hình hệ thống</h2>
            <small class="text-white-50">Quản lý thông tin hiển thị công khai của phòng gym.</small>
        </div>
        <a href="/" target="_blank" class="btn btn-outline-light"><i class="bi bi-box-arrow-up-right"></i> Xem trang chủ</a>
    </div>

    <% if (success) { %>
        <div class="alert alert-success"><i class="bi bi-check-circle-fill me-2"></i>Đã lưu cấu hình hệ thống.</div>
    <% } %>
    <% if (error) { %>
        <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %></div>
    <% } %>

    <form method="POST" action="/admin/settings" class="card p-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="row g-4">
            <div class="col-lg-6">
                <label class="form-label fw-semibold">Tên phòng gym *</label>
                <input type="text" name="gym_name" class="form-control" maxlength="120" required value="<%= settings.gym_name || '' %>">
            </div>
            <div class="col-lg-6">
                <label class="form-label fw-semibold">Email liên hệ *</label>
                <input type="email" name="email" class="form-control" maxlength="255" required value="<%= settings.email || '' %>">
            </div>
            <div class="col-lg-6">
                <label class="form-label fw-semibold">Hotline *</label>
                <input type="text" name="hotline" class="form-control" maxlength="40" required value="<%= settings.hotline || '' %>">
                <div class="form-text">Dùng cho nút gọi điện và thông tin liên hệ.</div>
            </div>
            <div class="col-lg-6">
                <label class="form-label fw-semibold">Số Zalo</label>
                <input type="text" name="zalo_phone" class="form-control" maxlength="40" value="<%= settings.zalo_phone || '' %>">
                <div class="form-text">Chỉ nhập số điện thoại, hệ thống tự tạo link Zalo.</div>
            </div>
            <div class="col-lg-6">
                <label class="form-label fw-semibold">Địa chỉ</label>
                <textarea name="address" class="form-control" rows="3" maxlength="500"><%= settings.address || '' %></textarea>
            </div>
            <div class="col-lg-6">
                <label class="form-label fw-semibold">Giờ hoạt động</label>
                <textarea name="opening_hours" class="form-control" rows="3" maxlength="500"><%= settings.opening_hours || '' %></textarea>
            </div>
            <div class="col-12">
                <hr>
                <h5 class="fw-bold mb-1"><i class="bi bi-qr-code me-2"></i>Thanh toán QR</h5>
                <div class="text-muted small">Dùng để tạo mã QR chuyển khoản ở POS và trang khách tự đăng ký gói tập.</div>
            </div>
            <div class="col-lg-4">
                <label class="form-label fw-semibold">Mã ngân hàng *</label>
                <input type="text" name="bank_bin" class="form-control" maxlength="40" required value="<%= settings.bank_bin || '' %>">
                <div class="form-text">Ví dụ: mbbank, vcb, acb.</div>
            </div>
            <div class="col-lg-4">
                <label class="form-label fw-semibold">Số tài khoản *</label>
                <input type="text" name="bank_account" class="form-control" maxlength="80" required value="<%= settings.bank_account || '' %>">
            </div>
            <div class="col-lg-4">
                <label class="form-label fw-semibold">Tên chủ tài khoản *</label>
                <input type="text" name="bank_account_name" class="form-control" maxlength="120" required value="<%= settings.bank_account_name || '' %>">
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">Google Maps embed URL</label>
                <textarea name="map_embed_url" class="form-control" rows="3" maxlength="3000"><%= settings.map_embed_url || '' %></textarea>
                <div class="form-text">Dán link trong thuộc tính <code>src</code> của iframe Google Maps.</div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a href="/admin" class="btn btn-outline-light">Quay lại</a>
            <button type="submit" class="btn btn-danger fw-bold">
                <i class="bi bi-save"></i> Lưu cấu hình
            </button>
        </div>
    </form>
</div>

<%- include('../partials/footer') %>
