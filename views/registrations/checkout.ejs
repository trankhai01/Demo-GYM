<%- include('../partials/header') %>

<div class="container mt-5 mb-5 d-flex justify-content-center">
    <div class="col-md-10 col-lg-8">
        <div class="d-flex align-items-center mb-4 pb-3 border-bottom border-secondary">
            <i class="bi bi-wallet2 text-danger fs-2 me-3"></i>
            <h2 class="fw-bold text-white text-uppercase m-0">Thanh Toán Hóa Đơn #<%= invoice.id %></h2>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <div class="bg-dark p-4 rounded border border-secondary h-100 shadow">
                    <h5 class="text-white-50 text-uppercase mb-4">Chi tiết giao dịch</h5>
                    
                    <p class="text-white mb-2"><span class="text-secondary d-inline-block" style="width: 100px;">Khách hàng:</span> <strong class="fs-5"><%= invoice.member_name || 'Khách lẻ' %></strong></p>
                    <p class="text-white mb-2"><span class="text-secondary d-inline-block" style="width: 100px;">SĐT:</span> <%= invoice.member_phone || '—' %></p>
                    <hr class="border-secondary">
                    <p class="text-white mb-2"><span class="text-secondary d-inline-block" style="width: 100px;">Gói tập:</span> <%= invoice.package_name || 'Mua lẻ sản phẩm' %></p>

                    <% if (locals.details && details.length > 0) { %>
                        <hr class="border-secondary">
                        <h6 class="text-white-50 text-uppercase mb-3 small">Sản phẩm đính kèm</h6>
                        <ul class="list-unstyled text-white mb-3 ps-0">
                            <% details.forEach(item => { %>
                                <li class="d-flex justify-content-between mb-2 small">
                                    <span>
                                        <i class="bi bi-box-seam me-1 text-secondary"></i>
                                        <%= item.product_name %>
                                        <span class="text-muted">x<%= item.quantity %></span>
                                    </span>
                                    <span><%= Number(item.price * item.quantity).toLocaleString('vi-VN') %>đ</span>
                                </li>
                            <% }) %>
                        </ul>
                    <% } %>

                    <p class="text-white mb-4"><span class="text-secondary d-inline-block" style="width: 100px;">Trạng thái:</span>
                        <% if (invoice.payment_status === STATUS.PAYMENT.SUCCESS) { %>
                            <span class="badge bg-success px-3 py-2"><i class="bi bi-check-circle-fill me-1"></i>Đã thanh toán</span>
                        <% } else { %>
                            <span class="badge bg-warning text-dark px-3 py-2"><i class="bi bi-hourglass-split me-1"></i>Chờ thanh toán</span>
                        <% } %>
                    </p>

                    <div class="bg-black p-3 rounded border border-secondary mb-3">
                        <div class="d-flex justify-content-between text-secondary mb-2 small">
                            <span>Tạm tính:</span>
                            <span class="text-white"><%= (Number(invoice.price) + Number(invoice.discount_amount)).toLocaleString('vi-VN') %>đ</span>
                        </div>
                        <% if (Number(invoice.discount_amount) > 0) { %>
                            <div class="d-flex justify-content-between text-success mb-2 small">
                                <span>Giảm giá:</span>
                                <span>-<%= Number(invoice.discount_amount).toLocaleString('vi-VN') %>đ</span>
                            </div>
                        <% } %>
                        <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top border-secondary">
                            <span class="text-white-50 small text-uppercase">Cần thu khách</span>
                            <span class="text-danger fw-bold fs-4" style="font-family: 'Oswald', sans-serif;"><%= Number(invoice.price).toLocaleString('vi-VN') %>đ</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="bg-dark p-4 rounded border border-secondary h-100 shadow text-center">
                    <% if (invoice.payment_status === STATUS.PAYMENT.SUCCESS) { %>
                        <div class="py-4 d-flex flex-column align-items-center justify-content-center h-100">
                            <div class="bg-success rounded-circle d-flex align-items-center justify-content-center mb-4 shadow"
                                 style="width: 96px; height: 96px;">
                                <i class="bi bi-check-lg text-white" style="font-size: 3.5rem;"></i>
                            </div>
                            <p class="text-success fw-bold text-uppercase mb-2">Thanh toán hoàn tất</p>
                            <h3 class="text-white fw-bold mb-3">Giao dịch thành công</h3>
                            <p class="text-white-50 mb-4">
                                Hóa đơn #<%= invoice.id %> đã được xác nhận thanh toán.
                            </p>

                            <div class="bg-black p-3 rounded border border-success w-100 mb-4">
                                <p class="text-secondary mb-1 text-uppercase small">Đã thu</p>
                                <h2 class="text-success fw-bold m-0" style="font-family: 'Oswald', sans-serif;">
                                    <%= Number(invoice.price).toLocaleString('vi-VN') %>đ
                                </h2>
                            </div>

                            <div class="d-grid gap-2 w-100">
                                <a href="/registrations/invoices" class="btn btn-success btn-lg fw-bold">
                                    <i class="bi bi-receipt me-2"></i>Về danh sách hóa đơn
                                </a>
                                <a href="/registrations" class="btn btn-outline-light fw-bold">
                                    <i class="bi bi-plus-circle me-2"></i>Tạo hóa đơn mới
                                </a>
                            </div>
                        </div>
                    <% } else { %>
                        <ul class="nav nav-pills justify-content-center mb-4" id="pills-tab" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active fw-bold" data-bs-toggle="pill" data-bs-target="#qr-tab" type="button">Quét mã QR</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link fw-bold" data-bs-toggle="pill" data-bs-target="#cash-tab" type="button">Tiền mặt</button>
                            </li>
                        </ul>

                        <form action="/registrations/checkout/confirm/<%= invoice.id %>" method="POST" id="checkoutForm"
                              data-confirm="Bạn xác nhận ĐÃ THU TIỀN thành công?">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <div class="tab-content" id="pills-tabContent">
                                <div class="tab-pane fade show active" id="qr-tab" role="tabpanel">
                                    <% if (payosPayment && payosPayment.qr_code) { %>
                                        <div class="bg-white p-3 rounded d-inline-block mb-3 shadow">
                                            <img src="https://api.qrserver.com/v1/create-qr-code/?size=260x260&data=<%= encodeURIComponent(payosPayment.qr_code) %>"
                                                 alt="Mã QR payOS" width="220" class="img-fluid rounded">
                                        </div>
                                        <% if (payosPayment.checkout_url) { %>
                                            <a href="<%= payosPayment.checkout_url %>" target="_blank" rel="noopener" class="btn btn-primary w-100 fw-bold mb-3">
                                                <i class="bi bi-box-arrow-up-right"></i> Mở trang thanh toán payOS
                                            </a>
                                        <% } %>
                                        <div class="d-flex align-items-center justify-content-center gap-2 text-white-50 small mb-0 py-2 border border-secondary rounded bg-black">
                                            <div class="spinner-border spinner-border-sm text-warning" role="status" style="width: 1rem; height: 1rem;"></div>
                                            <span class="fw-medium">Đang chờ thanh toán...</span>
                                        </div>
                                    <% } else { %>
                                        <div class="bg-white p-4 rounded d-inline-block mb-3 shadow text-secondary">
                                            <i class="bi bi-qr-code" style="font-size:5rem;"></i>
                                        </div>
                                        <% if (!payosConfigured) { %>
                                            <div class="alert alert-warning text-start">
                                                Chưa cấu hình payOS trong file .env.
                                            </div>
                                        <% } else if (payosCreateError) { %>
                                            <div class="alert alert-warning text-start">
                                                Không thể tạo thanh toán payOS: <%= payosCreateError.message %>
                                            </div>
                                        <% } %>
                                    <% } %>
                                </div>

                                <div class="tab-pane fade" id="cash-tab" role="tabpanel">
                                    <i class="bi bi-cash-stack text-success" style="font-size: 5rem;"></i>
                                    <p class="text-white mt-3 fs-5">Nhận tiền mặt tại quầy</p>
                                    <p class="text-white-50 small">Vui lòng kiểm đếm đủ <strong class="text-white"><%= Number(invoice.price).toLocaleString('vi-VN') %>đ</strong> trước khi bấm xác nhận.</p>
                                    <input type="hidden" name="payment_method" value="Tiền mặt" id="methodInput">
                                </div>
                            </div>

                            <button type="submit" class="btn btn-danger btn-lg w-100 fw-bold mt-4 shadow d-none" id="cashConfirmBtn">
                                <i class="bi bi-check-circle-fill me-2"></i>XÁC NHẬN ĐÃ NHẬN TIỀN MẶT
                            </button>
                        </form>

                        <form action="/registrations/checkout/cancel/<%= invoice.id %>" method="POST" class="mt-2"
                              data-confirm="Hủy hóa đơn này? Thao tác này sẽ xóa hóa đơn chờ thanh toán.">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="return_to" value="/registrations">
                            <button type="submit" class="btn btn-outline-secondary w-100 fw-bold">
                                <i class="bi bi-x-circle me-2"></i>HỦY ĐƠN
                            </button>
                        </form>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    <% if (invoice.payment_status !== STATUS.PAYMENT.SUCCESS) { %>
        const cashConfirmBtn = document.getElementById('cashConfirmBtn');
        document.querySelectorAll('.nav-link').forEach(tab => {
            tab.addEventListener('click', function() {
                if (this.dataset.bsTarget === '#cash-tab') {
                    document.getElementById('methodInput').value = 'Tiền mặt';
                    cashConfirmBtn.classList.remove('d-none');
                } else {
                    cashConfirmBtn.classList.add('d-none');
                }
            });
        });

        const statusUrl = "/registrations/checkout/status/<%= invoice.id %>";
        setInterval(async () => {
            try {
                const res = await fetch(statusUrl, { headers: { "Accept": "application/json" } });
                if (!res.ok) return;
                const data = await res.json();
                if (data.payment_status === "<%= STATUS.PAYMENT.SUCCESS %>") {
                    window.location.reload();
                }
            } catch (err) {}
        }, 3000);
    <% } %>
</script>
<% if (locals.notice) { %>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const messages = {
            cancel_paid: { type: 'warning', text: 'Không thể hủy hóa đơn đã thanh toán.' },
            cancel_error: { type: 'error', text: 'Không thể hủy hóa đơn. Vui lòng thử lại sau.' }
        };
        const item = messages[<%- JSON.stringify(notice) %>];
        if (item && window.Toast) Toast[item.type](item.text);
        window.history.replaceState({}, document.title, "/registrations/checkout/<%= invoice.id %>");
    });
</script>
<% } %>

<%- include('../partials/footer') %>
