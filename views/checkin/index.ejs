<%- include('../partials/header') %>

<script src="https://unpkg.com/html5-qrcode"></script>

<div class="container mt-4 mb-5">
    <h2 class="text-white text-uppercase mb-4 fw-bold text-center" style="letter-spacing: 1px;">
        <i class="bi bi-qr-code-scan text-danger me-2"></i>MÁY CHECK-IN / CHECK-OUT TỰ ĐỘNG
    </h2>

    <div class="row justify-content-center">
        <!-- Cột trái: máy check-in -->
        <div class="col-lg-5 mb-4">
            <div class="bg-dark p-3 rounded-4 border border-secondary shadow-lg mb-4">
                <div id="reader" width="100%"></div>
            </div>

            <div class="bg-dark p-4 rounded-4 border border-secondary shadow-lg">
                <h6 class="text-white-50 text-uppercase mb-3 small fw-bold">Nhập thủ công</h6>
                <div class="input-group">
                    <input type="text" id="manual-input" class="form-control bg-dark text-white border-secondary" placeholder="Nhập Số điện thoại hoặc ID..." onkeypress="handleManualInput(event)">
                    <button class="btn btn-warning fw-bold" type="button" onclick="processManualCheckin()">
                        <i class="bi bi-search"></i> KIỂM TRA
                    </button>
                </div>
            </div>

            <div id="result-box" class="mt-4 p-4 rounded-4 shadow-lg" style="display: none;">
                <h3 id="result-name" class="fw-bold mb-2 text-uppercase text-center"></h3>
                <h5 id="result-msg" class="mb-3 fw-bold text-center"></h5>

                <div class="d-flex gap-3 mt-3" id="action-buttons" style="display: none;">
                    <button class="btn btn-outline-light fw-bold w-50 py-2" onclick="cancelCheckin()">
                        <i class="bi bi-x-circle me-2"></i> HỦY
                    </button>
                    <button id="primary-action-btn" class="btn btn-light text-success fw-bold w-50 py-2" onclick="confirmCheckin()">
                        <i class="bi bi-check-circle-fill me-2"></i> XÁC NHẬN
                    </button>
                </div>
            </div>
        </div>

        <!-- Cột phải: danh sách hội viên đang trong phòng -->
        <div class="col-lg-5">
            <div class="bg-dark p-4 rounded-4 border border-secondary shadow-lg">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="text-white-50 text-uppercase small fw-bold m-0">
                        <i class="bi bi-people-fill text-warning me-2"></i>Đang trong phòng
                        <span id="active-count" class="badge bg-warning text-dark ms-2">0</span>
                    </h6>
                    <button class="btn btn-sm btn-outline-light" onclick="loadActiveSessions()">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>
                <div id="active-list" class="d-flex flex-column gap-2" style="max-height: 600px; overflow-y: auto;">
                    <div class="text-white-50 text-center py-4">Chưa có ai đang trong phòng</div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let isScanning = false;
    let currentMemberId = null;
    let currentSessionId = null;
    let currentMode = 'checkin'; 
    const audioSuccess = new Audio('https://assets.mixkit.co/active_storage/sfx/2568/2568-preview.mp3');
    const audioError = new Audio('https://assets.mixkit.co/active_storage/sfx/2573/2573-preview.mp3');

    function csrfToken() {
        return document.querySelector('meta[name="csrf-token"]').content;
    }

    function processCheckin(searchVal) {
        if (isScanning) return;
        isScanning = true;

        fetch('/checkin/process', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': csrfToken()
            },
            body: JSON.stringify({ search_val: searchVal })
        })
        .then(res => res.json())
        .then(data => {
            const resBox = document.getElementById('result-box');
            const resName = document.getElementById('result-name');
            const resMsg = document.getElementById('result-msg');
            const actionBtns = document.getElementById('action-buttons');
            const primaryBtn = document.getElementById('primary-action-btn');

            resBox.style.display = 'block';
            resName.innerText = data.member ? data.member.fullname : 'KHÔNG XÁC ĐỊNH';
            resMsg.innerText = data.message || (data.status === 'Success' ? 'Hợp lệ' : 'Lỗi');

            if (data.status === 'Success') {
                resBox.className = 'mt-4 p-4 rounded-4 shadow-lg bg-success text-white';
                actionBtns.style.display = 'flex';
                currentMemberId = data.member.id;
                currentSessionId = null;
                currentMode = 'checkin';
                primaryBtn.className = 'btn btn-light text-success fw-bold w-50 py-2';
                primaryBtn.innerHTML = '<i class="bi bi-check-circle-fill me-2"></i> XÁC NHẬN CHECK-IN';
                audioSuccess.play().catch(() => {});
            } else if (data.status === 'Already') {
                resBox.className = 'mt-4 p-4 rounded-4 shadow-lg bg-warning text-dark';
                actionBtns.style.display = 'flex';
                currentMemberId = data.member.id;
                currentSessionId = data.session_id;
                currentMode = 'checkout';
                primaryBtn.className = 'btn btn-dark fw-bold w-50 py-2';
                primaryBtn.innerHTML = '<i class="bi bi-box-arrow-right me-2"></i> CHECK-OUT';
                audioSuccess.play().catch(() => {});
            } else {
                resBox.className = 'mt-4 p-4 rounded-4 shadow-lg bg-danger text-white';
                actionBtns.style.display = 'none';
                currentMemberId = null;
                currentSessionId = null;
                audioError.play().catch(() => {});

                setTimeout(() => {
                    resBox.style.display = 'none';
                    isScanning = false;
                }, 3000);
            }
            document.getElementById('manual-input').value = '';
        })
        .catch(() => {
            isScanning = false;
        });
    }

    function onScanSuccess(decodedText) {
        processCheckin(decodedText);
    }

    function processManualCheckin() {
        const inputVal = document.getElementById('manual-input').value.trim();
        if (inputVal === '') {
            alert("Vui lòng nhập Số điện thoại hoặc ID!");
            return;
        }
        processCheckin(inputVal);
    }

    function handleManualInput(event) {
        if (event.key === "Enter") {
            processManualCheckin();
        }
    }

    function confirmCheckin() {
        if (currentMode === 'checkout' && currentSessionId) {
            doCheckout(currentSessionId, true);
            return;
        }
        if (!currentMemberId) return;

        fetch('/checkin/confirm', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': csrfToken()
            },
            body: JSON.stringify({ member_id: currentMemberId })
        })
        .then(res => Promise.all([res.ok, res.json()]))
        .then(([ok, data]) => {
            const resBox = document.getElementById('result-box');
            const resMsg = document.getElementById('result-msg');
            const actionBtns = document.getElementById('action-buttons');

            resMsg.innerText = data.message || (ok ? 'Đã check-in' : 'Lỗi');

            if (ok && data.status === 'Success') {
                actionBtns.style.display = 'none';
                audioSuccess.play().catch(() => {});
                setTimeout(() => {
                    resBox.style.display = 'none';
                    isScanning = false;
                    currentMemberId = null;
                    currentSessionId = null;
                    currentMode = 'checkin';
                }, 2000);
            } else {
                resBox.className = 'mt-4 p-4 rounded-4 shadow-lg bg-danger text-white';
                actionBtns.style.display = 'none';
                audioError.play().catch(() => {});
                setTimeout(() => {
                    resBox.style.display = 'none';
                    isScanning = false;
                    currentMemberId = null;
                    currentSessionId = null;
                    currentMode = 'checkin';
                }, 3000);
            }

            loadActiveSessions();
        })
        .catch(() => {
            isScanning = false;
        });
    }

    function cancelCheckin() {
        document.getElementById('result-box').style.display = 'none';
        document.getElementById('action-buttons').style.display = 'none';
        currentMemberId = null;
        currentSessionId = null;
        currentMode = 'checkin';
        isScanning = false;
    }

    function doCheckout(sessionId, hideResultBox) {
        fetch('/checkin/checkout/' + sessionId, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': csrfToken()
            }
        })
        .then(res => Promise.all([res.ok, res.json()]))
        .then(([ok, data]) => {
            if (ok && data.status === 'Success') {
                audioSuccess.play().catch(() => {});
                if (hideResultBox) {
                    document.getElementById('result-box').style.display = 'none';
                    document.getElementById('action-buttons').style.display = 'none';
                }
                // Reset trạng thái local để lần kế tiếp không bị kẹt ở 'checkout'.
                currentMemberId = null;
                currentSessionId = null;
                currentMode = 'checkin';
                isScanning = false;
            } else {
                audioError.play().catch(() => {});
                alert(data.message || 'Không check-out được');
            }
            loadActiveSessions();
        })
        .catch(() => {
            audioError.play().catch(() => {});
            isScanning = false;
        });
    }

    function formatDuration(startIso) {
        const ms = Date.now() - new Date(startIso).getTime();
        if (ms < 0) return '—';
        const totalMin = Math.floor(ms / 60000);
        const h = Math.floor(totalMin / 60);
        const m = totalMin % 60;
        if (h > 0) return h + 'h ' + m + 'p';
        return m + ' phút';
    }

    function formatTime(iso) {
        const d = new Date(iso);
        const hh = String(d.getHours()).padStart(2, '0');
        const mm = String(d.getMinutes()).padStart(2, '0');
        return hh + ':' + mm;
    }

    function renderActiveSessions(sessions) {
        const list = document.getElementById('active-list');
        const count = document.getElementById('active-count');
        count.innerText = sessions.length;

        if (sessions.length === 0) {
            list.innerHTML = '<div class="text-white-50 text-center py-4">Chưa có ai đang trong phòng</div>';
            return;
        }

        list.innerHTML = sessions.map(s => `
            <div class="d-flex align-items-center justify-content-between bg-secondary bg-opacity-25 rounded-3 px-3 py-2 border border-secondary">
                <div class="text-white">
                    <div class="fw-bold">${escapeHtml(s.fullname)}</div>
                    <div class="small text-white-50">
                        SĐT ${escapeHtml(s.phone || '—')} •
                        Vào lúc ${formatTime(s.checkin_time)} •
                        <span class="text-warning">${formatDuration(s.checkin_time)}</span>
                    </div>
                </div>
                <button class="btn btn-sm btn-outline-warning fw-bold" onclick="doCheckout(${s.id}, false)">
                    <i class="bi bi-box-arrow-right"></i> Check-out
                </button>
            </div>
        `).join('');
    }

    function escapeHtml(s) {
        if (s == null) return '';
        return String(s)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function loadActiveSessions() {
        fetch('/checkin/active', { headers: { 'X-CSRF-Token': csrfToken() } })
            .then(res => res.json())
            .then(data => {
                if (data.status === 'Success') {
                    renderActiveSessions(data.sessions || []);
                }
            })
            .catch(() => {});
    }

    // Auto-refresh thời lượng + danh sách mỗi 30 giây.
    loadActiveSessions();
    setInterval(loadActiveSessions, 30000);

    // Khởi tạo máy quét QR
    let html5QrcodeScanner = new Html5QrcodeScanner("reader", { fps: 10, qrbox: { width: 250, height: 250 } }, false);
    html5QrcodeScanner.render(onScanSuccess, () => {});
</script>

<%- include('../partials/footer') %>
