<%- include('partials/header') %>

<style>
    .profile-container {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #121212;
        padding: 20px;
    }
    .gym-card {
        background: linear-gradient(135deg, #1e1e1e 0%, #111 100%);
        border: 1px solid #333;
        border-radius: 20px;
        width: 100%;
        max-width: 500px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.8);
        position: relative;
        overflow: hidden;
    }
    .gym-card::before {
        content: '';
        position: absolute;
        top: -50px;
        right: -50px;
        width: 150px;
        height: 150px;
        background-color: #e50914;
        transform: rotate(45deg);
        z-index: 0;
        opacity: 0.8;
    }
    .card-content {
        position: relative;
        z-index: 1;
        padding: 40px 30px;
    }
    .qr-box {
        background: white;
        padding: 10px;
        border-radius: 10px;
        display: inline-block;
        margin-bottom: 20px;
    }
    .info-label {
        color: #a0a0a0;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 3px;
    }
    .info-value {
        color: white;
        font-size: 1.1rem;
        font-weight: bold;
        margin-bottom: 15px;
    }
    .stat-box {
        text-align: center;
        padding: 10px 0;
    }
    .stat-value {
        font-size: 1.4rem;
        font-weight: bold;
        color: #e50914;
    }
</style>

<div class="profile-container">
    <div class="gym-card">
        <div class="card-content text-center">
            
            <h2 class="fw-bold mb-4" style="color: #e50914; font-family: 'Oswald', sans-serif; letter-spacing: 2px;">POWER GYM</h2>

            <% if (locals.success) { %>
                <div class="alert alert-success py-2 text-center border-0" style="font-size: 0.9rem; background-color: rgba(25, 135, 84, 0.2); color: #47cf73;">
                    <i class="bi bi-check-circle-fill me-1"></i> Cập nhật hồ sơ thành công!
                </div>
            <% } %>
            
            <div class="qr-box shadow-lg">
                <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=POWERGYM-<%= member.phone %>" alt="QR Code">
            </div>

            <div class="text-start mt-4 px-3">
                <div class="row">
                    <div class="col-7">
                        <div class="info-label">Họ và Tên</div>
                        <div class="info-value"><%= member.fullname %></div>
                    </div>
                    <div class="col-5 text-end">
                        <div class="info-label">Mã thẻ</div>
                        <div class="info-value" style="color: #e50914;">#<%= member.id %></div>
                    </div>
                </div>

                <div class="row mt-2">
                    <div class="col-7">
                        <div class="info-label">Căn cước / Quê quán</div>
                        <div class="info-value" style="font-size: 0.95rem;">
                            <%= member.cccd || '---' %> <br>
                            <span class="text-white-50"><%= member.hometown || '---' %></span>
                        </div>
                    </div>
                    <div class="col-5 text-end">
                        <div class="info-label">Liên hệ</div>
                        <div class="info-value" style="font-size: 0.95rem;"><%= member.phone %></div>
                    </div>
                </div>
            </div>

            <div class="row mt-3 mx-2 pt-3 border-top border-secondary">
                <div class="col-4 stat-box">
                    <div class="info-label">Chiều cao</div>
                    <div class="stat-value"><%= member.height ? member.height : '--' %><span class="fs-6 text-white-50">cm</span></div>
                </div>
                <div class="col-4 stat-box border-start border-end border-secondary">
                    <div class="info-label">Cân nặng</div>
                    <div class="stat-value"><%= member.weight ? member.weight : '--' %><span class="fs-6 text-white-50">kg</span></div>
                </div>
                <div class="col-4 stat-box">
                    <div class="info-label">Năm sinh</div>
                    <div class="stat-value"><%= member.birth_year || '--' %></div>
                </div>
            </div>

            <hr class="border-secondary mt-3 mb-4">
            
            <div class="d-flex justify-content-between align-items-center px-3 mb-2">
                <span class="badge bg-dark border border-secondary p-2 px-3 text-white-50">
                    <i class="bi bi-gender-ambiguous me-1"></i> <%= member.gender %>
                </span>
                <button class="btn btn-outline-light btn-sm" data-bs-toggle="modal" data-bs-target="#editProfileModal">
                    <i class="bi bi-pencil-square"></i> Cập nhật hồ sơ
                </button>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="editProfileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark text-white border-secondary shadow-lg">
            <div class="modal-header border-secondary">
                <h5 class="modal-title fw-bold text-uppercase" style="color: #e50914; letter-spacing: 1px;">
                    Cập nhật hồ sơ hội viên
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form action="/my-profile/edit" method="POST">
                    
                    <h6 class="text-danger border-bottom border-secondary pb-2 mb-3">Thông tin cơ bản</h6>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-white-50 small text-uppercase">Họ và Tên *</label>
                            <input type="text" name="fullname" class="form-control bg-dark text-white border-secondary" value="<%= member.fullname %>" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-white-50 small text-uppercase">Số điện thoại *</label>
                            <input type="tel" name="phone" class="form-control bg-dark text-white <%= locals.error === 'duplicate_phone' ? 'border-danger shadow-none' : 'border-secondary' %>" value="<%= member.phone %>" required>
                            <% if (locals.error === 'duplicate_phone') { %>
                                <div class="text-danger mt-1 small fw-bold">Số điện thoại đã tồn tại!</div>
                            <% } %>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-white-50 small text-uppercase">Giới tính *</label>
                            <select name="gender" class="form-select bg-dark text-white border-secondary">
                                <option value="Nam" <%= member.gender === 'Nam' ? 'selected' : '' %>>Nam</option>
                                <option value="Nữ" <%= member.gender === 'Nữ' ? 'selected' : '' %>>Nữ</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-white-50 small text-uppercase">Năm sinh</label>
                            <input type="number" name="birth_year" class="form-control bg-dark text-white border-secondary" value="<%= member.birth_year %>" placeholder="VD: 1999">
                        </div>
                    </div>

                    <h6 class="text-danger border-bottom border-secondary pb-2 mb-3 mt-3">Chỉ số cơ thể</h6>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-white-50 small text-uppercase">Chiều cao (cm)</label>
                            <input type="number" step="0.1" name="height" class="form-control bg-dark text-white border-secondary" value="<%= member.height %>" placeholder="VD: 175">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-white-50 small text-uppercase">Cân nặng (kg)</label>
                            <input type="number" step="0.1" name="weight" class="form-control bg-dark text-white border-secondary" value="<%= member.weight %>" placeholder="VD: 68.5">
                        </div>
                    </div>

                    <h6 class="text-danger border-bottom border-secondary pb-2 mb-3 mt-3">Định danh cá nhân</h6>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-white-50 small text-uppercase">Số CCCD</label>
                            <input type="text" name="cccd" class="form-control bg-dark text-white border-secondary" value="<%= member.cccd %>">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-white-50 small text-uppercase">Quê quán</label>
                            <input type="text" name="hometown" class="form-control bg-dark text-white border-secondary" value="<%= member.hometown %>">
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-white-50 small text-uppercase">Địa chỉ hiện tại</label>
                        <input type="text" name="address" class="form-control bg-dark text-white border-secondary" value="<%= member.address %>">
                    </div>
                    
                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top border-secondary">
                        <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-danger fw-bold px-4">LƯU HỒ SƠ</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<% if (locals.error === 'duplicate_phone') { %>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        var myModal = new bootstrap.Modal(document.getElementById('editProfileModal'));
        myModal.show();
        window.history.replaceState({}, document.title, "/my-profile");
    });
</script>
<% } %>

<% if (locals.success) { %>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        window.history.replaceState({}, document.title, "/my-profile");
    });
</script>
<% } %>

<%- include('partials/footer') %>