        <div class="container">
            <div class="text-center mb-5">
                <h2 class="section-title text-white"><%= t('home.contact.title_1') %> <span><%= t('home.contact.title_2') %></span></h2>
                <p class="section-sub"><%= t('home.contact.subtitle') %></p>
            </div>

            <div class="row g-4">
                <!-- Form -->
