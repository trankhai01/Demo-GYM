<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <title>GYM BRO — Hệ thống Gym Đẳng cấp</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --gym-red: #e50914;
            --gym-red-dark: #b20710;
            --gym-bg: #0a0a0a;
            --gym-card: #1a1a1a;
            --gym-card-2: #222;
            --gym-text-mute: #b0b0b0;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--gym-bg);
            color: #fff;
            scroll-behavior: smooth;
        }
        h1, h2, h3, .nav-link, .btn, .section-title {
            font-family: 'Oswald', sans-serif;
            text-transform: uppercase;
        }
        .section-title {
            font-weight: 700;
            letter-spacing: 2px;
            font-size: 2.4rem;
        }
        .section-title span { color: var(--gym-red); }
        .section-sub {
            color: var(--gym-text-mute);
            max-width: 720px;
            margin: 0 auto 3rem;
            text-transform: none;
        }

        /* Navbar */
        .navbar {
            background-color: rgba(0, 0, 0, 0.85) !important;
            backdrop-filter: blur(10px);
            transition: background-color .3s;
        }
        .navbar-brand {
            font-weight: 700;
            font-size: 1.8rem;
            color: var(--gym-red) !important;
            letter-spacing: 2px;
            font-family: 'Oswald', sans-serif;
        }
        .nav-link {
            font-size: 0.95rem;
            letter-spacing: 1px;
            transition: color .2s;
        }
        .nav-link:hover { color: var(--gym-red) !important; }

        /* Hero */
        .hero-section {
            background: linear-gradient(rgba(0,0,0,0.55), rgba(0,0,0,0.85)),
                        url('https://images.unsplash.com/photo-1534438327276-14e5300c3a48?q=80&w=2070&auto=format&fit=crop') no-repeat center center;
            background-size: cover;
            min-height: 100vh;
            display: flex;
            align-items: center;
            text-align: center;
            position: relative;
        }
        .hero-title {
            font-size: clamp(2.5rem, 6vw, 5rem);
            font-weight: 700;
            line-height: 1.1;
            margin-bottom: 20px;
        }
        .hero-title span { color: var(--gym-red); }
        .hero-tag {
            display: inline-block;
            border: 1px solid var(--gym-red);
            color: var(--gym-red);
            padding: 6px 18px;
            border-radius: 30px;
            letter-spacing: 3px;
            font-size: 0.85rem;
            font-family: 'Oswald', sans-serif;
            margin-bottom: 18px;
        }
        .btn-gym {
            background-color: var(--gym-red);
            color: #fff;
            border: none;
            padding: 14px 36px;
            font-size: 1rem;
            font-weight: 600;
            letter-spacing: 1px;
            transition: 0.25s;
        }
        .btn-gym:hover {
            background-color: var(--gym-red-dark);
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(229, 9, 20, 0.4);
        }
        .btn-ghost {
            background: transparent;
            border: 2px solid #fff;
            color: #fff;
            padding: 12px 34px;
            transition: 0.25s;
        }
        .btn-ghost:hover {
            background: #fff;
            color: var(--gym-bg);
        }
        .scroll-down {
            position: absolute;
            bottom: 30px; left: 50%;
            transform: translateX(-50%);
            color: rgba(255,255,255,0.7);
            font-size: 1.5rem;
            animation: bounce 2s infinite;
        }
        @keyframes bounce {
            0%, 20%, 50%, 80%, 100% { transform: translateX(-50%) translateY(0); }
            40% { transform: translateX(-50%) translateY(-10px); }
            60% { transform: translateX(-50%) translateY(-5px); }
        }

        /* Stats */
        .stats-section {
            background: linear-gradient(135deg, var(--gym-red) 0%, var(--gym-red-dark) 100%);
            padding: 50px 0;
        }
        .stat-number {
            font-family: 'Oswald', sans-serif;
            font-size: 3rem;
            font-weight: 700;
            color: #fff;
            line-height: 1;
        }
        .stat-label {
            color: rgba(255,255,255,0.85);
            text-transform: uppercase;
            letter-spacing: 2px;
            font-size: 0.85rem;
            margin-top: 6px;
        }

        /* USP */
        .usp-card {
            background: var(--gym-card);
            border: 1px solid #2a2a2a;
            border-radius: 12px;
            padding: 32px 24px;
            text-align: center;
            height: 100%;
            transition: 0.3s;
        }
        .usp-card:hover {
            border-color: var(--gym-red);
            transform: translateY(-6px);
            box-shadow: 0 15px 35px rgba(229, 9, 20, 0.15);
        }
        .usp-icon {
            width: 70px; height: 70px;
            margin: 0 auto 18px;
            background: rgba(229, 9, 20, 0.12);
            color: var(--gym-red);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
        }
        .usp-title {
            font-family: 'Oswald', sans-serif;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 600;
            margin-bottom: 10px;
        }
        .usp-desc { color: var(--gym-text-mute); font-size: 0.95rem; }

        /* Packages */
        .pkg-card {
            background: var(--gym-card);
            border: 1px solid #2a2a2a;
            border-radius: 14px;
            overflow: hidden;
            height: 100%;
            display: flex; flex-direction: column;
            transition: 0.3s;
        }
        .pkg-card:hover { transform: translateY(-6px); border-color: var(--gym-red); }
        .pkg-card.featured { border: 2px solid var(--gym-red); position: relative; }
        .pkg-card.featured::before {
            content: 'PHỔ BIẾN';
            position: absolute; top: 14px; right: -32px;
            background: var(--gym-red); color: #fff;
            padding: 4px 36px; font-size: 0.75rem; letter-spacing: 2px;
            transform: rotate(45deg);
            font-family: 'Oswald', sans-serif;
        }
        .pkg-head { background: #111; padding: 30px 24px; text-align: center; border-bottom: 1px solid #2a2a2a; }
        .pkg-name { font-family: 'Oswald', sans-serif; font-size: 1.3rem; letter-spacing: 1.5px; margin-bottom: 12px; }
        .pkg-price {
            font-family: 'Oswald', sans-serif;
            font-size: 2.3rem; font-weight: 700;
            color: var(--gym-red); line-height: 1;
        }
        .pkg-price small { color: var(--gym-text-mute); font-size: 0.85rem; font-weight: normal; letter-spacing: 1px; }
        .pkg-body { padding: 24px; flex-grow: 1; display: flex; flex-direction: column; }
        .pkg-feat-list { list-style: none; padding: 0; margin: 0 0 20px 0; flex-grow: 1; }
        .pkg-feat-list li {
            padding: 8px 0;
            color: #d0d0d0;
            border-bottom: 1px dashed #2a2a2a;
            font-size: 0.95rem;
        }
        .pkg-feat-list li i { color: #28a745; margin-right: 8px; }

        /* Trainers */
        .trainer-card {
            background: var(--gym-card);
            border: 1px solid #2a2a2a;
            border-radius: 14px;
            overflow: hidden;
            transition: 0.3s;
            height: 100%;
        }
        .trainer-card:hover { border-color: var(--gym-red); transform: translateY(-6px); }
        .trainer-img-wrap {
            height: 280px;
            background: #111;
            display: flex; align-items: center; justify-content: center;
            position: relative;
            overflow: hidden;
        }
        .trainer-img-wrap img {
            width: 100%; height: 100%; object-fit: cover;
        }
        .trainer-img-wrap .ph-icon {
            font-size: 5rem; color: #333;
        }
        .trainer-body { padding: 22px; }
        .trainer-name {
            font-family: 'Oswald', sans-serif;
            font-size: 1.25rem; letter-spacing: 1px;
            margin-bottom: 4px;
        }
        .trainer-spec { color: var(--gym-red); text-transform: uppercase; letter-spacing: 2px; font-size: 0.8rem; }
        .trainer-exp { color: var(--gym-text-mute); font-size: 0.9rem; margin-top: 10px; }

        /* BMI */
        .bmi-section {
            background:
                linear-gradient(rgba(0,0,0,0.85), rgba(0,0,0,0.95)),
                url('https://images.unsplash.com/photo-1517836357463-d25dfeac3438?q=80&w=2070&auto=format&fit=crop') no-repeat center center;
            background-size: cover;
        }
        .bmi-card {
            background: var(--gym-card);
            border: 1px solid #2a2a2a;
            border-radius: 16px;
            padding: 36px 32px;
        }
        .bmi-input {
            background: #0f0f0f !important;
            border: 1px solid #333 !important;
            color: #fff !important;
            padding: 12px 16px !important;
            border-radius: 8px !important;
        }
        .bmi-input:focus {
            border-color: var(--gym-red) !important;
            box-shadow: 0 0 0 0.2rem rgba(229, 9, 20, 0.2) !important;
        }
        .bmi-result {
            background: #0a0a0a;
            border: 2px solid #2a2a2a;
            border-radius: 12px;
            padding: 24px;
            text-align: center;
            min-height: 100%;
        }
        .bmi-value {
            font-family: 'Oswald', sans-serif;
            font-size: 4rem;
            font-weight: 700;
            line-height: 1;
            margin: 14px 0 6px;
        }
        .bmi-category {
            font-family: 'Oswald', sans-serif;
            letter-spacing: 2px;
            text-transform: uppercase;
            font-size: 1.1rem;
            margin-bottom: 12px;
        }
        .bmi-bar {
            display: flex;
            height: 10px;
            border-radius: 5px;
            overflow: hidden;
            margin: 18px 0 10px;
        }
        .bmi-bar > div { flex: 1; }
        .bmi-bar .b1 { background: #3b82f6; }
        .bmi-bar .b2 { background: #22c55e; }
        .bmi-bar .b3 { background: #eab308; }
        .bmi-bar .b4 { background: #ef4444; }
        .bmi-legend {
            display: flex;
            justify-content: space-between;
            font-size: 0.72rem;
            color: var(--gym-text-mute);
        }
        .bmi-tip {
            color: var(--gym-text-mute);
            font-size: 0.92rem;
            margin-top: 12px;
            line-height: 1.55;
        }

        /* Contact section */
        .contact-section {
            background:
                linear-gradient(rgba(0,0,0,0.85), rgba(0,0,0,0.95)),
                url('https://images.unsplash.com/photo-1534438327276-14e5300c3a48?q=80&w=2070&auto=format&fit=crop') no-repeat center center;
            background-size: cover;
        }
        .contact-card {
            background: var(--gym-card);
            border: 1px solid #2a2a2a;
            border-radius: 16px;
            padding: 36px 32px;
        }
        .contact-info-item {
            display: flex; align-items: flex-start; gap: 14px;
            padding: 16px 0;
            border-bottom: 1px solid #222;
        }
        .contact-info-item:last-child { border-bottom: none; }
        .contact-info-item i {
            color: var(--gym-red);
            font-size: 1.4rem;
            min-width: 28px;
            margin-top: 4px;
        }
        .contact-info-item .title {
            color: #fff; font-weight: 600; margin-bottom: 4px;
        }
        .contact-info-item .desc {
            color: var(--gym-text-mute); font-size: 0.92rem; margin: 0;
        }
        .map-wrap {
            border-radius: 16px;
            overflow: hidden;
            border: 1px solid #2a2a2a;
            line-height: 0;
        }
        .map-wrap iframe { width: 100%; height: 320px; border: 0; filter: grayscale(40%) invert(0.92) hue-rotate(180deg); }

        /* Footer */
        footer {
            background: #050505;
            border-top: 1px solid #1a1a1a;
            padding: 50px 0 20px;
        }
        footer h5 {
            color: var(--gym-red);
            font-family: 'Oswald', sans-serif;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            margin-bottom: 18px;
        }
        footer a { color: var(--gym-text-mute); text-decoration: none; transition: color .2s; }
        footer a:hover { color: var(--gym-red); }
        footer .social a {
            display: inline-flex;
            align-items: center; justify-content: center;
            width: 38px; height: 38px;
            border: 1px solid #2a2a2a;
            border-radius: 50%;
            margin-right: 8px;
            color: #fff;
        }
        footer .social a:hover { background: var(--gym-red); border-color: var(--gym-red); }
        .copyright {
            border-top: 1px solid #1a1a1a;
            padding-top: 18px;
            margin-top: 40px;
            color: #555;
            font-size: 0.85rem;
            text-align: center;
        }

        section { padding: 80px 0; }
    </style>
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="bi bi-fire"></i> GYM BRO
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link text-white" href="#about">Về chúng tôi</a></li>
                    <li class="nav-item"><a class="nav-link text-white" href="#packages">Gói tập</a></li>
                    <li class="nav-item"><a class="nav-link text-white" href="#trainers">Huấn luyện viên</a></li>
                    <li class="nav-item"><a class="nav-link text-white" href="#bmi">Tính BMI</a></li>
                    <li class="nav-item"><a class="nav-link text-white" href="#contact">Liên hệ</a></li>
                </ul>
                <div class="d-flex align-items-center gap-2">
                    <% if (user) { %>
                        <span class="text-white-50 me-2 small">Xin chào, <strong class="text-white"><%= user.username %></strong></span>
                        <a href="<%= homePath %>" class="btn btn-outline-light btn-sm">
                            <% if (user.role === 'admin') { %>Trang Quản trị<% } else if (user.role === 'staff') { %>Trang Lễ tân<% } else { %>Bảng điều khiển<% } %>
                        </a>
                        <a href="/logout" class="btn btn-danger btn-sm">Đăng xuất</a>
                    <% } else { %>
                        <a href="/login" class="btn btn-outline-light btn-sm">Đăng nhập</a>
                        <a href="/register" class="btn btn-gym btn-sm">Đăng ký</a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero -->
    <section class="hero-section">
        <div class="container">
            <span class="hero-tag">SỨC MẠNH — KỶ LUẬT — VƯỢT GIỚI HẠN</span>
            <h1 class="hero-title">ĐÁNH THỨC <span>SỨC MẠNH</span><br>BÊN TRONG BẠN</h1>
            <p class="lead text-light mb-4 fs-5 mx-auto" style="max-width: 720px;">
                Cơ sở vật chất chuẩn 5 sao. Đội ngũ huấn luyện viên chứng chỉ quốc tế.
                Lộ trình cá nhân hóa — đạt mục tiêu nhanh hơn 2 lần.
            </p>
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <% if (!user) { %>
                    <a href="/register" class="btn btn-gym rounded-pill shadow-lg">
                        <i class="bi bi-lightning-charge-fill"></i> Đăng ký ngay
                    </a>
                    <a href="#packages" class="btn btn-ghost rounded-pill">
                        Xem gói tập <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                <% } else { %>
                    <a href="<%= homePath %>" class="btn btn-gym rounded-pill shadow-lg">
                        <i class="bi bi-speedometer2"></i> Vào trang chính
                    </a>
                    <a href="#packages" class="btn btn-ghost rounded-pill">
                        Xem gói tập <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                <% } %>
            </div>
        </div>
        <a href="#stats" class="scroll-down"><i class="bi bi-chevron-double-down"></i></a>
    </section>

    <!-- Stats -->
    <section id="stats" class="stats-section" style="padding: 50px 0;">
        <div class="container">
            <div class="row text-center g-4">
                <div class="col-6 col-md-3">
                    <div class="stat-number"><%= stats.members %>+</div>
                    <div class="stat-label">Hội viên</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="stat-number"><%= stats.trainers %></div>
                    <div class="stat-label">Huấn luyện viên</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="stat-number"><%= stats.packages %></div>
                    <div class="stat-label">Gói tập</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="stat-number"><%= stats.checkins %>+</div>
                    <div class="stat-label">Lượt check-in</div>
                </div>
            </div>
        </div>
    </section>

    <!-- About / USP -->
    <section id="about">
        <div class="container">
            <div class="text-center">
                <h2 class="section-title">Tại sao chọn <span>GYM BRO?</span></h2>
                <p class="section-sub">
                    Hơn cả một phòng tập — chúng tôi là cộng đồng những người tin rằng cơ thể khỏe mạnh là khởi đầu cho mọi thành công.
                </p>
            </div>
            <div class="row g-4">
                <div class="col-md-6 col-lg-3">
                    <div class="usp-card">
                        <div class="usp-icon"><i class="bi bi-lightning-charge-fill"></i></div>
                        <h5 class="usp-title">Thiết bị hiện đại</h5>
                        <p class="usp-desc">Máy móc nhập khẩu Hammer Strength, Life Fitness — bảo trì hàng tuần.</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="usp-card">
                        <div class="usp-icon"><i class="bi bi-person-badge-fill"></i></div>
                        <h5 class="usp-title">HLV chứng chỉ quốc tế</h5>
                        <p class="usp-desc">Đội ngũ PT có chứng chỉ ACE, NASM — kèm cặp 1-1 cá nhân hoá.</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="usp-card">
                        <div class="usp-icon"><i class="bi bi-clock-history"></i></div>
                        <h5 class="usp-title">Mở cửa 5h – 23h</h5>
                        <p class="usp-desc">Phục vụ tất cả các ngày trong tuần — kể cả lễ Tết.</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="usp-card">
                        <div class="usp-icon"><i class="bi bi-shield-check"></i></div>
                        <h5 class="usp-title">Hỗ trợ tận tâm</h5>
                        <p class="usp-desc">Lễ tân hỗ trợ check-in/out nhanh, phòng tắm sạch sẽ, gửi đồ miễn phí.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Packages -->
    <section id="packages" style="background: #0d0d0d;">
        <div class="container">
            <div class="text-center">
                <h2 class="section-title">Gói tập <span>linh hoạt</span></h2>
                <p class="section-sub">Chọn gói phù hợp với mục tiêu và lịch trình của bạn — tất cả đều có thể nâng cấp.</p>
            </div>
            <% if (packages && packages.length > 0) { %>
                <div class="row g-4 justify-content-center">
                    <% packages.forEach((pkg, idx) => { %>
                        <div class="col-md-6 col-lg-4">
                            <div class="pkg-card <%= idx === 1 ? 'featured' : '' %>">
                                <div class="pkg-head">
                                    <div class="pkg-name"><%= pkg.package_name %></div>
                                    <div class="pkg-price">
                                        <%= Number(pkg.price).toLocaleString('vi-VN') %><small>đ</small>
                                    </div>
                                    <div class="text-white-50 small mt-1"><%= pkg.duration_months %> tháng</div>
                                </div>
                                <div class="pkg-body">
                                    <ul class="pkg-feat-list">
                                        <li><i class="bi bi-check-circle-fill"></i> Tập không giới hạn trong giờ mở cửa</li>
                                        <% if (pkg.pt_sessions > 0) { %>
                                            <li><i class="bi bi-check-circle-fill"></i> <%= pkg.pt_sessions %> buổi tập với HLV cá nhân</li>
                                        <% } else { %>
                                            <li><i class="bi bi-check-circle-fill"></i> Tự tập có hỗ trợ lễ tân</li>
                                        <% } %>
                                        <li><i class="bi bi-check-circle-fill"></i> Sử dụng tất cả thiết bị</li>
                                        <li><i class="bi bi-check-circle-fill"></i> Phòng tắm + tủ gửi đồ</li>
                                        <% if (pkg.description) { %>
                                            <li class="text-white-50 small fst-italic" style="border:0;"><%= pkg.description %></li>
                                        <% } %>
                                    </ul>
                                    <a href="<%= user ? '#contact' : '/register' %>" class="btn btn-gym w-100 rounded-pill">
                                        <%= user ? 'Liên hệ đăng ký' : 'Đăng ký ngay' %>
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="text-center text-white-50 py-5">
                    <i class="bi bi-box-seam fs-1 d-block mb-3"></i>
                    Đang cập nhật gói tập mới — vui lòng quay lại sau.
                </div>
            <% } %>
        </div>
    </section>

    <!-- Trainers -->
    <section id="trainers">
        <div class="container">
            <div class="text-center">
                <h2 class="section-title">Đội ngũ <span>huấn luyện viên</span></h2>
                <p class="section-sub">Những chuyên gia tận tâm sẽ đồng hành cùng bạn trên hành trình chinh phục mục tiêu.</p>
            </div>
            <% if (trainers && trainers.length > 0) { %>
                <div class="row g-4">
                    <% trainers.forEach(t => { %>
                        <div class="col-md-6 col-lg-4">
                            <div class="trainer-card">
                                <div class="trainer-img-wrap">
                                    <% if (t.image_url) { %>
                                        <img src="<%= t.image_url %>" alt="<%= t.fullname %>">
                                    <% } else { %>
                                        <i class="bi bi-person-fill ph-icon"></i>
                                    <% } %>
                                </div>
                                <div class="trainer-body">
                                    <div class="trainer-name"><%= t.fullname %></div>
                                    <div class="trainer-spec"><%= t.specialty || 'Đa năng' %></div>
                                    <% if (t.experience_years) { %>
                                        <div class="trainer-exp">
                                            <i class="bi bi-award text-danger me-1"></i>
                                            <%= t.experience_years %> năm kinh nghiệm
                                        </div>
                                    <% } %>
                                    <% if (t.description) { %>
                                        <p class="text-white-50 small mt-2 mb-0" style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
                                            <%= t.description %>
                                        </p>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="text-center text-white-50 py-5">
                    <i class="bi bi-people fs-1 d-block mb-3"></i>
                    Đội ngũ đang được tuyển chọn — sớm có mặt.
                </div>
            <% } %>
        </div>
    </section>

    <!-- BMI Calculator -->
    <section class="bmi-section" id="bmi">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="section-title">Tính chỉ số <span>BMI</span></h2>
                <p class="section-sub">Nhập chiều cao và cân nặng để biết tình trạng cơ thể, chúng tôi sẽ gợi ý gói tập phù hợp.</p>
            </div>
            <div class="row g-4 align-items-stretch justify-content-center">
                <div class="col-lg-6">
                    <div class="bmi-card h-100">
                        <form id="bmiForm" onsubmit="return false;">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label text-white-50">Chiều cao (cm)</label>
                                    <input type="number" class="form-control bmi-input" id="bmiHeight"
                                           min="80" max="250" step="0.1" placeholder="VD: 170" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-white-50">Cân nặng (kg)</label>
                                    <input type="number" class="form-control bmi-input" id="bmiWeight"
                                           min="20" max="300" step="0.1" placeholder="VD: 65" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-white-50">Tuổi</label>
                                    <input type="number" class="form-control bmi-input" id="bmiAge"
                                           min="10" max="120" step="1" placeholder="VD: 25">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-white-50">Giới tính</label>
                                    <select class="form-control bmi-input" id="bmiGender">
                                        <option value="">— Tuỳ chọn —</option>
                                        <option value="male">Nam</option>
                                        <option value="female">Nữ</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <button type="button" id="bmiCalcBtn" class="btn btn-gym rounded-pill w-100 mt-2">
                                        <i class="bi bi-calculator"></i> Tính BMI
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="bmi-result" id="bmiResult">
                        <div class="text-white-50 small">CHỈ SỐ BMI CỦA BẠN</div>
                        <div class="bmi-value" id="bmiValue">--</div>
                        <div class="bmi-category" id="bmiCategory">Chờ thông tin</div>
                        <div class="bmi-bar">
                            <div class="b1"></div>
                            <div class="b2"></div>
                            <div class="b3"></div>
                            <div class="b4"></div>
                        </div>
                        <div class="bmi-legend">
                            <span>&lt;18.5 Gầy</span>
                            <span>18.5–24.9 Bình thường</span>
                            <span>25–29.9 Thừa cân</span>
                            <span>≥30 Béo phì</span>
                        </div>
                        <div class="bmi-tip" id="bmiTip">
                            Nhập chiều cao và cân nặng, sau đó bấm "Tính BMI" để xem kết quả.
                        </div>
                        <a href="#packages" id="bmiCta" class="btn btn-outline-danger rounded-pill mt-3" style="display:none;">
                            <i class="bi bi-fire"></i> Xem gói tập gợi ý
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact form + map -->
    <section class="contact-section" id="contact">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="section-title text-white">Liên hệ <span>với chúng tôi</span></h2>
                <p class="section-sub">Để lại lời nhắn — đội ngũ GymBro sẽ phản hồi trong vòng 24 giờ. Hoặc ghé trực tiếp phòng tập theo địa chỉ bên dưới.</p>
            </div>

            <div class="row g-4">
                <!-- Form -->
                <div class="col-lg-7">
                    <div class="contact-card">
                        <h4 class="text-white mb-4"><i class="bi bi-pencil-square text-danger me-2"></i> Gửi tin nhắn</h4>
                        <form method="POST" action="/contact" autocomplete="off">
                            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label text-white-50">Họ và tên <span class="text-danger">*</span></label>
                                    <input type="text" name="fullname" class="form-control bmi-input"
                                           required maxlength="150" placeholder="Nguyễn Văn A">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-white-50">Email <span class="text-danger">*</span></label>
                                    <input type="email" name="email" class="form-control bmi-input"
                                           required maxlength="255" placeholder="email@example.com">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-white-50">Số điện thoại</label>
                                    <input type="text" name="phone" class="form-control bmi-input"
                                           maxlength="30" placeholder="0900 000 000">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-white-50">Chủ đề</label>
                                    <input type="text" name="subject" class="form-control bmi-input"
                                           maxlength="255" placeholder="VD: Tư vấn gói tập">
                                </div>
                                <div class="col-12">
                                    <label class="form-label text-white-50">Nội dung <span class="text-danger">*</span></label>
                                    <textarea name="message" rows="5" class="form-control bmi-input"
                                              required maxlength="4000" placeholder="Bạn cần hỗ trợ gì? Hãy chia sẻ với chúng tôi..."></textarea>
                                </div>
                                <div class="col-12">
                                    <button type="submit" class="btn btn-gym rounded-pill px-4 mt-2">
                                        <i class="bi bi-send-fill"></i> Gửi tin nhắn
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Info + map -->
                <div class="col-lg-5">
                    <div class="contact-card mb-4">
                        <h4 class="text-white mb-3"><i class="bi bi-info-circle text-danger me-2"></i> Thông tin liên hệ</h4>
                        <div class="contact-info-item">
                            <i class="bi bi-geo-alt-fill"></i>
                            <div>
                                <div class="title">Địa chỉ</div>
                                <p class="desc">123 Đường Số 1, Phường Bến Nghé, Quận 1, TP. Hồ Chí Minh</p>
                            </div>
                        </div>
                        <div class="contact-info-item">
                            <i class="bi bi-telephone-fill"></i>
                            <div>
                                <div class="title">Điện thoại</div>
                                <p class="desc"><a href="tel:0900000000" class="text-white-50">0900 000 000</a></p>
                            </div>
                        </div>
                        <div class="contact-info-item">
                            <i class="bi bi-envelope-fill"></i>
                            <div>
                                <div class="title">Email</div>
                                <p class="desc"><a href="mailto:hello@gymbro.vn" class="text-white-50">hello@gymbro.vn</a></p>
                            </div>
                        </div>
                        <div class="contact-info-item">
                            <i class="bi bi-clock-fill"></i>
                            <div>
                                <div class="title">Giờ mở cửa</div>
                                <p class="desc">5:00 — 23:00, mọi ngày trong tuần</p>
                            </div>
                        </div>
                    </div>
                    <div class="map-wrap">
                        <iframe
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3919.434088447635!2d106.6983107!3d10.776530892315796!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31752f4670702e9d%3A0xb8b7460491acdd84!2zUXXhuq1uIDEsIFRow6BuaCBwaOG7kSBI4buTIENow60gTWluaA!5e0!3m2!1svi!2s!4v1700000000000"
                            allowfullscreen="" loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade" title="Bản đồ phòng gym">
                        </iframe>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script>
    (function() {
        const $h = document.getElementById('bmiHeight');
        const $w = document.getElementById('bmiWeight');
        const $btn = document.getElementById('bmiCalcBtn');
        const $val = document.getElementById('bmiValue');
        const $cat = document.getElementById('bmiCategory');
        const $tip = document.getElementById('bmiTip');
        const $cta = document.getElementById('bmiCta');

        function classify(bmi) {
            if (bmi < 18.5) return {
                label: 'Gầy',
                color: '#3b82f6',
                tip: 'Cơ thể bạn đang thiếu cân. Nên tăng dinh dưỡng và tập gym tăng cơ — gợi ý gói có HLV cá nhân để xây dựng lộ trình.'
            };
            if (bmi < 25) return {
                label: 'Bình thường',
                color: '#22c55e',
                tip: 'Tuyệt vời! Cơ thể bạn cân đối. Duy trì lối sống năng động bằng gói tập linh hoạt — kết hợp cardio và sức mạnh.'
            };
            if (bmi < 30) return {
                label: 'Thừa cân',
                color: '#eab308',
                tip: 'Bạn đang hơi thừa cân. Gợi ý gói tập kết hợp cardio (HIIT) + dinh dưỡng — tham khảo gói có HLV để đốt mỡ hiệu quả.'
            };
            return {
                label: 'Béo phì',
                color: '#ef4444',
                tip: 'Bạn nên tham khảo bác sĩ + đăng ký gói có HLV chuyên giảm cân. GymBro có lộ trình giảm cân an toàn 1-1.'
            };
        }

        function calc() {
            const h = parseFloat($h.value);
            const w = parseFloat($w.value);
            if (!Number.isFinite(h) || !Number.isFinite(w) || h < 80 || h > 250 || w < 20 || w > 300) {
                $val.textContent = '--';
                $val.style.color = '#fff';
                $cat.textContent = 'Dữ liệu không hợp lệ';
                $tip.textContent = 'Vui lòng kiểm tra lại chiều cao (80–250 cm) và cân nặng (20–300 kg).';
                $cta.style.display = 'none';
                return;
            }
            const bmi = w / Math.pow(h / 100, 2);
            const c = classify(bmi);
            $val.textContent = bmi.toFixed(1);
            $val.style.color = c.color;
            $cat.textContent = c.label;
            $cat.style.color = c.color;
            $tip.textContent = c.tip;
            $cta.style.display = 'inline-block';
        }

        $btn.addEventListener('click', calc);
        [$h, $w].forEach(el => el.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') { e.preventDefault(); calc(); }
        }));
    })();
    </script>

    <!-- Footer -->
    <footer>
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h5><i class="bi bi-fire"></i> GYM BRO</h5>
                    <p class="text-white-50 small">
                        Phòng tập đẳng cấp với phương châm "Sức mạnh — Kỷ luật — Vượt giới hạn". Đồng hành cùng bạn trên hành trình thay đổi bản thân.
                    </p>
                    <div class="social mt-3">
                        <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="#" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
                        <a href="#" aria-label="TikTok"><i class="bi bi-tiktok"></i></a>
                    </div>
                </div>
                <div class="col-md-4 col-6">
                    <h5>Liên hệ</h5>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><i class="bi bi-geo-alt-fill text-danger me-2"></i><span class="text-white-50">123 Đường Số 1, Q.1, TP.HCM</span></li>
                        <li class="mb-2"><i class="bi bi-telephone-fill text-danger me-2"></i><a href="tel:0900000000">0900 000 000</a></li>
                        <li class="mb-2"><i class="bi bi-envelope-fill text-danger me-2"></i><a href="mailto:hello@gymbro.vn">hello@gymbro.vn</a></li>
                        <li class="mb-2"><i class="bi bi-clock-fill text-danger me-2"></i><span class="text-white-50">5:00 — 23:00 mỗi ngày</span></li>
                    </ul>
                </div>
                <div class="col-md-4 col-6">
                    <h5>Liên kết nhanh</h5>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="#about">Về chúng tôi</a></li>
                        <li class="mb-2"><a href="#packages">Gói tập</a></li>
                        <li class="mb-2"><a href="#trainers">Huấn luyện viên</a></li>
                        <% if (!user) { %>
                            <li class="mb-2"><a href="/login">Đăng nhập</a></li>
                            <li class="mb-2"><a href="/register">Đăng ký hội viên</a></li>
                        <% } else { %>
                            <li class="mb-2"><a href="<%= homePath %>">Trang chính của tôi</a></li>
                            <li class="mb-2"><a href="/logout">Đăng xuất</a></li>
                        <% } %>
                    </ul>
                </div>
            </div>
            <div class="copyright">
                &copy; <%= new Date().getFullYear() %> GYM BRO. Demo phục vụ thực tập tốt nghiệp — không phải sản phẩm thương mại.
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Navbar đổi nền khi cuộn xuống.
        const nav = document.querySelector('.navbar');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 50) nav.style.backgroundColor = 'rgba(0,0,0,0.95)';
            else nav.style.backgroundColor = 'rgba(0,0,0,0.85)';
        });
    </script>

    <%- include('partials/chatbot') %>
</body>
</html>
