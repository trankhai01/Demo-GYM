    <!-- BMI Calculator -->
    <section class="bmi-section" id="bmi">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="section-title"><%= t('home.bmi.title_1') %> <span><%= t('home.bmi.title_2') %></span></h2>
                <p class="section-sub"><%= t('home.bmi.subtitle') %></p>
            </div>
            <div class="row g-4 align-items-stretch justify-content-center">
                <div class="col-lg-6">
                    <div class="bmi-card h-100">
                        <form id="bmiForm" onsubmit="return false;">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label text-white-50"><%= t('home.bmi.height') %></label>
                                    <input type="number" class="form-control bmi-input" id="bmiHeight"
                                           min="80" max="250" step="0.1" placeholder="170" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-white-50"><%= t('home.bmi.weight') %></label>
                                    <input type="number" class="form-control bmi-input" id="bmiWeight"
                                           min="20" max="300" step="0.1" placeholder="65" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-white-50"><%= t('home.bmi.age') %></label>
                                    <input type="number" class="form-control bmi-input" id="bmiAge"
                                           min="10" max="120" step="1" placeholder="25">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-white-50"><%= t('home.bmi.gender') %></label>
                                    <select class="form-control bmi-input" id="bmiGender">
                                        <option value=""><%= t('home.bmi.gender_optional') %></option>
                                        <option value="male"><%= t('home.bmi.gender_male') %></option>
                                        <option value="female"><%= t('home.bmi.gender_female') %></option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <button type="button" id="bmiCalcBtn" class="btn btn-gym rounded-pill w-100 mt-2">
                                        <i class="bi bi-calculator"></i> <%= t('home.bmi.calc') %>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="bmi-result" id="bmiResult">
                        <div class="text-white-50 small"><%= t('home.bmi.your_bmi') %></div>
                        <div class="bmi-value" id="bmiValue">--</div>
                        <div class="bmi-category" id="bmiCategory"><%= t('home.bmi.waiting') %></div>
                        <div class="bmi-bar">
                            <div class="b1"></div>
                            <div class="b2"></div>
                            <div class="b3"></div>
                            <div class="b4"></div>
                        </div>
                        <div class="bmi-legend">
                            <span><%= t('home.bmi.legend_under') %></span>
                            <span><%= t('home.bmi.legend_normal') %></span>
                            <span><%= t('home.bmi.legend_over') %></span>
                            <span><%= t('home.bmi.legend_obese') %></span>
                        </div>
                        <div class="bmi-tip" id="bmiTip">
                            <%= t('home.bmi.waiting_tip') %>
                        </div>
                        <a href="#packages" id="bmiCta" class="btn btn-outline-danger rounded-pill mt-3" style="display:none;">
                            <i class="bi bi-fire"></i> <%= t('home.bmi.see_packages') %>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact form + map -->
