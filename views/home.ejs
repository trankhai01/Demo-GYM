<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <title><%= t('home.title_tab') %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --gym-red: #4f46e5;
            --gym-red-dark: #4338ca;
            --gym-accent: #06b6d4;
            --gym-bg: #f8fafc;
            --gym-card: #ffffff;
            --gym-card-2: #f1f5f9;
            --gym-text-mute: #64748b;
            --gym-border: #e2e8f0;
            --gym-text: #0f172a;
        }
        body {
            font-family: 'Inter', 'Segoe UI', Tahoma, sans-serif;
            background-color: var(--gym-bg);
            color: var(--gym-text);
            scroll-behavior: smooth;
        }
        h1, h2, h3, .nav-link, .btn, .section-title {
            font-family: 'Oswald', sans-serif;
            text-transform: uppercase;
        }
        .section-title {
            font-weight: 700;
            letter-spacing: 2px;
            font-size: 2.4rem;
        }
        .section-title span { color: var(--gym-red); }
        .section-sub {
            color: var(--gym-text-mute);
            max-width: 720px;
            margin: 0 auto 3rem;
            text-transform: none;
        }

        /* Navbar */
        .navbar {
            background-color: rgba(15, 23, 42, 0.78) !important;
            backdrop-filter: blur(10px);
            transition: background-color .3s;
        }
        .navbar-brand {
            font-weight: 700;
            font-size: 1.8rem;
            color: var(--gym-red) !important;
            letter-spacing: 2px;
            font-family: 'Oswald', sans-serif;
        }
        .nav-link {
            font-size: 0.95rem;
            letter-spacing: 1px;
            transition: color .2s;
        }
        .nav-link:hover { color: var(--gym-red) !important; }

        /* Hero */
        .hero-section {
            background: linear-gradient(rgba(0,0,0,0.55), rgba(15, 23, 42, 0.78)),
                        url('https://images.unsplash.com/photo-1534438327276-14e5300c3a48?q=80&w=2070&auto=format&fit=crop') no-repeat center center;
            background-size: cover;
            min-height: 100vh;
            display: flex;
            align-items: center;
            text-align: center;
            position: relative;
        }
        .hero-title {
            font-size: clamp(2.5rem, 6vw, 5rem);
            font-weight: 700;
            line-height: 1.1;
            margin-bottom: 20px;
        }
        .hero-title span { color: var(--gym-red); }
        .hero-tag {
            display: inline-block;
            border: 1px solid var(--gym-red);
            color: var(--gym-red);
            padding: 6px 18px;
            border-radius: 30px;
            letter-spacing: 3px;
            font-size: 0.85rem;
            font-family: 'Oswald', sans-serif;
            margin-bottom: 18px;
        }
        .btn-gym {
            background-color: var(--gym-red);
            color: #fff;
            border: none;
            padding: 14px 36px;
            font-size: 1rem;
            font-weight: 600;
            letter-spacing: 1px;
            transition: 0.25s;
        }
        .btn-gym:hover {
            background-color: var(--gym-red-dark);
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(79, 70, 229, 0.30);
        }
        .btn-ghost {
            background: transparent;
            border: 2px solid #fff;
            color: #fff;
            padding: 12px 34px;
            transition: 0.25s;
        }
        .btn-ghost:hover {
            background: #fff;
            color: var(--gym-bg);
        }
        .scroll-down {
            position: absolute;
            bottom: 30px; left: 50%;
            transform: translateX(-50%);
            color: rgba(255,255,255,0.7);
            font-size: 1.5rem;
            animation: bounce 2s infinite;
        }
        @keyframes bounce {
            0%, 20%, 50%, 80%, 100% { transform: translateX(-50%) translateY(0); }
            40% { transform: translateX(-50%) translateY(-10px); }
            60% { transform: translateX(-50%) translateY(-5px); }
        }

        /* Stats */
        .stats-section {
            background: linear-gradient(135deg, var(--gym-red) 0%, var(--gym-red-dark) 100%);
            padding: 50px 0;
        }
        .stat-number {
            font-family: 'Oswald', sans-serif;
            font-size: 3rem;
            font-weight: 700;
            color: #fff;
            line-height: 1;
        }
        .stat-label {
            color: rgba(255,255,255,0.85);
            text-transform: uppercase;
            letter-spacing: 2px;
            font-size: 0.85rem;
            margin-top: 6px;
        }

        /* USP */
        .usp-card {
            background: var(--gym-card);
            border: 1px solid var(--gym-border);
            border-radius: 12px;
            padding: 32px 24px;
            text-align: center;
            height: 100%;
            transition: 0.3s;
        }
        .usp-card:hover {
            border-color: var(--gym-red);
            transform: translateY(-6px);
            box-shadow: 0 15px 35px rgba(79, 70, 229, 0.15);
        }
        .usp-icon {
            width: 70px; height: 70px;
            margin: 0 auto 18px;
            background: rgba(79, 70, 229, 0.12);
            color: var(--gym-red);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
        }
        .usp-title {
            font-family: 'Oswald', sans-serif;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 600;
            margin-bottom: 10px;
        }
        .usp-desc { color: var(--gym-text-mute); font-size: 0.95rem; }

        /* Packages */
        .pkg-card {
            background: var(--gym-card);
            border: 1px solid var(--gym-border);
            border-radius: 14px;
            overflow: hidden;
            height: 100%;
            display: flex; flex-direction: column;
            transition: 0.3s;
        }
        .pkg-card:hover { transform: translateY(-6px); border-color: var(--gym-red); }
        .pkg-card.featured { border: 2px solid var(--gym-red); position: relative; }
        .pkg-card.featured::before {
            content: 'PHỔ BIẾN';
            position: absolute; top: 14px; right: -32px;
            background: var(--gym-red); color: #fff;
            padding: 4px 36px; font-size: 0.75rem; letter-spacing: 2px;
            transform: rotate(45deg);
            font-family: 'Oswald', sans-serif;
        }
        .pkg-head { background: var(--gym-card-2); padding: 30px 24px; text-align: center; border-bottom: 1px solid var(--gym-border); }
        .pkg-name { font-family: 'Oswald', sans-serif; font-size: 1.3rem; letter-spacing: 1.5px; margin-bottom: 12px; }
        .pkg-price {
            font-family: 'Oswald', sans-serif;
            font-size: 2.3rem; font-weight: 700;
            color: var(--gym-red); line-height: 1;
        }
        .pkg-price small { color: var(--gym-text-mute); font-size: 0.85rem; font-weight: normal; letter-spacing: 1px; }
        .pkg-body { padding: 24px; flex-grow: 1; display: flex; flex-direction: column; }
        .pkg-feat-list { list-style: none; padding: 0; margin: 0 0 20px 0; flex-grow: 1; }
        .pkg-feat-list li {
            padding: 8px 0;
            color: #d0d0d0;
            border-bottom: 1px dashed var(--gym-border);
            font-size: 0.95rem;
        }
        .pkg-feat-list li i { color: #28a745; margin-right: 8px; }

        /* Trainers */
        .trainer-card {
            background: var(--gym-card);
            border: 1px solid var(--gym-border);
            border-radius: 14px;
            overflow: hidden;
            transition: 0.3s;
            height: 100%;
        }
        .trainer-card:hover { border-color: var(--gym-red); transform: translateY(-6px); }
        .trainer-img-wrap {
            height: 280px;
            background: var(--gym-card-2);
            display: flex; align-items: center; justify-content: center;
            position: relative;
            overflow: hidden;
        }
        .trainer-img-wrap img {
            width: 100%; height: 100%; object-fit: cover;
        }
        .trainer-img-wrap .ph-icon {
            font-size: 5rem; color: var(--gym-text-mute);
        }
        .trainer-body { padding: 22px; }
        .trainer-name {
            font-family: 'Oswald', sans-serif;
            font-size: 1.25rem; letter-spacing: 1px;
            margin-bottom: 4px;
        }
        .trainer-spec { color: var(--gym-red); text-transform: uppercase; letter-spacing: 2px; font-size: 0.8rem; }
        .trainer-exp { color: var(--gym-text-mute); font-size: 0.9rem; margin-top: 10px; }

        /* BMI */
        .bmi-section {
            background:
                linear-gradient(rgba(79, 70, 229, 0.85), rgba(8, 145, 178, 0.85)),
                url('https://images.unsplash.com/photo-1517836357463-d25dfeac3438?q=80&w=2070&auto=format&fit=crop') no-repeat center center;
            background-size: cover;
        }
        .bmi-card {
            background: var(--gym-card);
            border: 1px solid var(--gym-border);
            border-radius: 16px;
            padding: 36px 32px;
        }
        .bmi-input {
            background: var(--gym-card-2) !important;
            border: 1px solid var(--gym-border) !important;
            color: var(--gym-text) !important;
            padding: 12px 16px !important;
            border-radius: 8px !important;
        }
        .bmi-input:focus {
            border-color: var(--gym-red) !important;
            box-shadow: 0 0 0 0.2rem rgba(79, 70, 229, 0.2) !important;
        }
        .bmi-result {
            background: var(--gym-card);
            border: 2px solid var(--gym-border);
            border-radius: 12px;
            padding: 24px;
            text-align: center;
            min-height: 100%;
        }
        .bmi-value {
            font-family: 'Oswald', sans-serif;
            font-size: 4rem;
            font-weight: 700;
            line-height: 1;
            margin: 14px 0 6px;
        }
        .bmi-category {
            font-family: 'Oswald', sans-serif;
            letter-spacing: 2px;
            text-transform: uppercase;
            font-size: 1.1rem;
            margin-bottom: 12px;
        }
        .bmi-bar {
            display: flex;
            height: 10px;
            border-radius: 5px;
            overflow: hidden;
            margin: 18px 0 10px;
        }
        .bmi-bar > div { flex: 1; }
        .bmi-bar .b1 { background: #3b82f6; }
        .bmi-bar .b2 { background: #22c55e; }
        .bmi-bar .b3 { background: #eab308; }
        .bmi-bar .b4 { background: #ef4444; }
        .bmi-legend {
            display: flex;
            justify-content: space-between;
            font-size: 0.72rem;
            color: var(--gym-text-mute);
        }
        .bmi-tip {
            color: var(--gym-text-mute);
            font-size: 0.92rem;
            margin-top: 12px;
            line-height: 1.55;
        }

        /* Contact section */
        .contact-section {
            background:
                linear-gradient(rgba(15, 23, 42, 0.85), rgba(15, 23, 42, 0.92)),
                url('https://images.unsplash.com/photo-1534438327276-14e5300c3a48?q=80&w=2070&auto=format&fit=crop') no-repeat center center;
            background-size: cover;
        }
        .contact-card {
            background: var(--gym-card);
            border: 1px solid var(--gym-border);
            border-radius: 16px;
            padding: 36px 32px;
        }
        .contact-info-item {
            display: flex; align-items: flex-start; gap: 14px;
            padding: 16px 0;
            border-bottom: 1px solid var(--gym-border);
        }
        .contact-info-item:last-child { border-bottom: none; }
        .contact-info-item i {
            color: var(--gym-red);
            font-size: 1.4rem;
            min-width: 28px;
            margin-top: 4px;
        }
        .contact-info-item .title {
            color: #fff; font-weight: 600; margin-bottom: 4px;
        }
        .contact-card .contact-info-item .title { color: var(--gym-text); }
        .contact-info-item .desc {
            color: var(--gym-text-mute); font-size: 0.92rem; margin: 0;
        }
        .map-wrap {
            border-radius: 16px;
            overflow: hidden;
            border: 1px solid var(--gym-border);
            line-height: 0;
        }
        .map-wrap iframe { width: 100%; height: 320px; border: 0; }

        /* Footer */
        footer {
            background: #1e293b;
            border-top: 1px solid var(--gym-border);
            padding: 50px 0 20px;
        }
        footer h5 {
            color: var(--gym-red);
            font-family: 'Oswald', sans-serif;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            margin-bottom: 18px;
        }
        footer a { color: var(--gym-text-mute); text-decoration: none; transition: color .2s; }
        footer a:hover { color: var(--gym-red); }
        footer .social a {
            display: inline-flex;
            align-items: center; justify-content: center;
            width: 38px; height: 38px;
            border: 1px solid var(--gym-border);
            border-radius: 50%;
            margin-right: 8px;
            color: #fff;
        }
        footer .social a:hover { background: var(--gym-red); border-color: var(--gym-red); }
        .copyright {
            border-top: 1px solid var(--gym-border);
            padding-top: 18px;
            margin-top: 40px;
            color: #555;
            font-size: 0.85rem;
            text-align: center;
        }

        section { padding: 80px 0; }
    </style>
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="bi bi-fire"></i> GYM BRO
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link text-white" href="#about"><%= t('nav.about') %></a></li>
                    <li class="nav-item"><a class="nav-link text-white" href="#packages"><%= t('nav.packages') %></a></li>
                    <li class="nav-item"><a class="nav-link text-white" href="#trainers"><%= t('nav.trainers') %></a></li>
                    <li class="nav-item"><a class="nav-link text-white" href="#bmi"><%= t('nav.bmi') %></a></li>
                    <li class="nav-item"><a class="nav-link text-white" href="#contact"><%= t('nav.contact') %></a></li>
                </ul>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <%- include('partials/lang-switch') %>
                    <% if (user) { %>
                        <span class="text-white-50 me-2 small"><%= t('nav.greeting', { name: user.username }) %></span>
                        <a href="<%= homePath %>" class="btn btn-outline-light btn-sm">
                            <% if (user.role === 'admin') { %><%= t('nav.panel_admin') %><% } else if (user.role === 'staff') { %><%= t('nav.panel_staff') %><% } else { %><%= t('nav.panel_member') %><% } %>
                        </a>
                        <a href="/logout" class="btn btn-danger btn-sm"><%= t('nav.logout') %></a>
                    <% } else { %>
                        <a href="/login" class="btn btn-outline-light btn-sm"><%= t('nav.login') %></a>
                        <a href="/register" class="btn btn-gym btn-sm"><%= t('nav.register') %></a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero -->
    <section class="hero-section">
        <div class="container">
            <span class="hero-tag"><%= t('home.hero.tag') %></span>
            <h1 class="hero-title"><%= t('home.hero.title_1') %><br><span><%= t('home.hero.title_2') %></span></h1>
            <p class="lead text-light mb-4 fs-5 mx-auto" style="max-width: 720px;">
                <%= t('home.hero.subtitle') %>
            </p>
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <% if (!user) { %>
                    <a href="/register" class="btn btn-gym rounded-pill shadow-lg">
                        <i class="bi bi-lightning-charge-fill"></i> <%= t('home.hero.cta_register') %>
                    </a>
                    <a href="#packages" class="btn btn-ghost rounded-pill">
                        <%= t('nav.packages') %> <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                <% } else { %>
                    <a href="<%= homePath %>" class="btn btn-gym rounded-pill shadow-lg">
                        <i class="bi bi-speedometer2"></i> <%= t('home.hero.cta_dashboard') %>
                    </a>
                    <a href="#packages" class="btn btn-ghost rounded-pill">
                        <%= t('nav.packages') %> <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                <% } %>
            </div>
        </div>
        <a href="#stats" class="scroll-down"><i class="bi bi-chevron-double-down"></i></a>
    </section>

    <!-- Stats -->
    <section id="stats" class="stats-section" style="padding: 50px 0;">
        <div class="container">
            <div class="row text-center g-4">
                <div class="col-6 col-md-3">
                    <div class="stat-number"><%= stats.members %>+</div>
                    <div class="stat-label"><%= t('home.stats.members') %></div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="stat-number"><%= stats.trainers %></div>
                    <div class="stat-label"><%= t('home.stats.trainers') %></div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="stat-number"><%= stats.packages %></div>
                    <div class="stat-label"><%= t('home.stats.packages') %></div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="stat-number"><%= stats.checkins %>+</div>
                    <div class="stat-label"><%= t('home.stats.checkins') %></div>
                </div>
            </div>
        </div>
    </section>

    <!-- About / USP -->
    <section id="about">
        <div class="container">
            <div class="text-center">
                <h2 class="section-title"><%= t('home.about.title_1') %> <span><%= t('home.about.title_2') %></span></h2>
                <p class="section-sub">
                    <%= t('home.about.subtitle') %>
                </p>
            </div>
            <div class="row g-4">
                <div class="col-md-6 col-lg-3">
                    <div class="usp-card">
                        <div class="usp-icon"><i class="bi bi-lightning-charge-fill"></i></div>
                        <h5 class="usp-title"><%= t('home.about.f1_title') %></h5>
                        <p class="usp-desc"><%= t('home.about.f1_desc') %></p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="usp-card">
                        <div class="usp-icon"><i class="bi bi-person-badge-fill"></i></div>
                        <h5 class="usp-title"><%= t('home.about.f2_title') %></h5>
                        <p class="usp-desc"><%= t('home.about.f2_desc') %></p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="usp-card">
                        <div class="usp-icon"><i class="bi bi-clock-history"></i></div>
                        <h5 class="usp-title"><%= t('home.about.f3_title') %></h5>
                        <p class="usp-desc"><%= t('home.about.f3_desc') %></p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="usp-card">
                        <div class="usp-icon"><i class="bi bi-shield-check"></i></div>
                        <h5 class="usp-title"><%= t('home.about.f4_title') %></h5>
                        <p class="usp-desc"><%= t('home.about.f4_desc') %></p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Packages -->
    <section id="packages" style="background: #0d0d0d;">
        <div class="container">
            <div class="text-center">
                <h2 class="section-title"><%= t('home.packages.title_1') %> <span><%= t('home.packages.title_2') %></span></h2>
                <p class="section-sub"><%= t('home.packages.subtitle') %></p>
            </div>
            <% if (packages && packages.length > 0) { %>
                <div class="row g-4 justify-content-center">
                    <% packages.forEach((pkg, idx) => { %>
                        <div class="col-md-6 col-lg-4">
                            <div class="pkg-card <%= idx === 1 ? 'featured' : '' %>">
                                <div class="pkg-head">
                                    <div class="pkg-name"><%= pkg.package_name %></div>
                                    <div class="pkg-price">
                                        <%= Number(pkg.price).toLocaleString(lang === 'vi' ? 'vi-VN' : 'en-US') %><small><%= t('home.packages.currency') %></small>
                                    </div>
                                    <div class="text-white-50 small mt-1"><%= pkg.duration_months %> <%= t('home.packages.duration_unit') %></div>
                                </div>
                                <div class="pkg-body">
                                    <ul class="pkg-feat-list">
                                        <li><i class="bi bi-check-circle-fill"></i> <%= t('home.packages.feat_unlimited') %></li>
                                        <% if (pkg.pt_sessions > 0) { %>
                                            <li><i class="bi bi-check-circle-fill"></i> <%= t('home.packages.feat_pt', { n: pkg.pt_sessions }) %></li>
                                        <% } else { %>
                                            <li><i class="bi bi-check-circle-fill"></i> <%= t('home.packages.feat_self') %></li>
                                        <% } %>
                                        <li><i class="bi bi-check-circle-fill"></i> <%= t('home.packages.feat_equipment') %></li>
                                        <li><i class="bi bi-check-circle-fill"></i> <%= t('home.packages.feat_facility') %></li>
                                        <% if (pkg.description) { %>
                                            <li class="text-white-50 small fst-italic" style="border:0;"><%= pkg.description %></li>
                                        <% } %>
                                    </ul>
                                    <a href="<%= user ? '#contact' : '/register' %>" class="btn btn-gym w-100 rounded-pill">
                                        <%= user ? t('nav.contact') : t('home.hero.cta_register') %>
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="text-center text-white-50 py-5">
                    <i class="bi bi-box-seam fs-1 d-block mb-3"></i>
                    <%= t('home.packages.no_packages') %>
                </div>
            <% } %>
        </div>
    </section>

    <!-- Trainers -->
    <section id="trainers">
        <div class="container">
            <div class="text-center">
                <h2 class="section-title"><%= t('home.trainers.title_1') %> <span><%= t('home.trainers.title_2') %></span></h2>
                <p class="section-sub"><%= t('home.trainers.subtitle') %></p>
            </div>
            <% if (trainers && trainers.length > 0) { %>
                <div class="row g-4">
                    <% trainers.forEach(tr => { %>
                        <div class="col-md-6 col-lg-4">
                            <div class="trainer-card">
                                <div class="trainer-img-wrap">
                                    <% if (tr.image_url) { %>
                                        <img src="<%= tr.image_url %>" alt="<%= tr.fullname %>">
                                    <% } else { %>
                                        <i class="bi bi-person-fill ph-icon"></i>
                                    <% } %>
                                </div>
                                <div class="trainer-body">
                                    <div class="trainer-name"><%= tr.fullname %></div>
                                    <div class="trainer-spec"><%= tr.specialty || t('home.trainers.specialty_default') %></div>
                                    <% if (tr.experience_years) { %>
                                        <div class="trainer-exp">
                                            <i class="bi bi-award text-danger me-1"></i>
                                            <%= t('home.trainers.experience', { n: tr.experience_years }) %>
                                        </div>
                                    <% } %>
                                    <% if (tr.description) { %>
                                        <p class="text-white-50 small mt-2 mb-0" style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
                                            <%= tr.description %>
                                        </p>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="text-center text-white-50 py-5">
                    <i class="bi bi-people fs-1 d-block mb-3"></i>
                    <%= t('home.trainers.empty') %>
                </div>
            <% } %>
        </div>
