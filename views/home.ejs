                            </div>
                        </div>
                        <div class="contact-info-item">
                            <i class="bi bi-telephone-fill"></i>
                            <div>
                                <div class="title"><%= t('home.contact.info_phone') %></div>
                                <p class="desc"><a href="tel:0900000000" class="text-white-50">0900 000 000</a></p>
                            </div>
                        </div>
                        <div class="contact-info-item">
                            <i class="bi bi-envelope-fill"></i>
                            <div>
                                <div class="title"><%= t('home.contact.info_email') %></div>
                                <p class="desc"><a href="mailto:hello@gymbro.vn" class="text-white-50">hello@gymbro.vn</a></p>
                            </div>
                        </div>
                        <div class="contact-info-item">
                            <i class="bi bi-clock-fill"></i>
