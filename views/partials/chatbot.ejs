<%# Trợ lý ảo Gemini - bubble nổi góc phải dưới. Include trên mọi trang trừ login/register/forgot-password. %>
<style>
    .gymbro-chat-bubble {
        position: fixed;
        right: 24px;
        bottom: 24px;
        z-index: 1080;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: #4f46e5;
        color: white;
        border: none;
        box-shadow: 0 8px 24px rgba(229, 9, 20, 0.45);
        font-size: 1.7rem;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .gymbro-chat-bubble:hover {
        transform: scale(1.08);
        box-shadow: 0 12px 32px rgba(229, 9, 20, 0.6);
    }
    .gymbro-chat-panel {
        position: fixed;
        right: 24px;
        bottom: 100px;
        z-index: 1080;
        width: 380px;
        max-width: calc(100vw - 32px);
        height: 540px;
        max-height: calc(100vh - 140px);
        background: #1a1a1a;
        border: 1px solid #333;
        border-radius: 16px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.7);
        display: none;
        flex-direction: column;
        overflow: hidden;
    }
    .gymbro-chat-panel.open { display: flex; }
    .gymbro-chat-header {
        background: linear-gradient(135deg, #4f46e5 0%, #b00610 100%);
        color: white;
        padding: 14px 16px;
        font-weight: 700;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .gymbro-chat-header .subtitle { font-size: 0.75rem; font-weight: 400; opacity: 0.9; }
    .gymbro-chat-header button {
        background: transparent; border: none; color: white; font-size: 1.3rem; cursor: pointer;
    }
    .gymbro-chat-body {
        flex: 1;
        overflow-y: auto;
        padding: 14px;
        background: #121212;
        font-size: 0.92rem;
    }
    .gymbro-msg { margin-bottom: 10px; display: flex; }
    .gymbro-msg.user { justify-content: flex-end; }
    .gymbro-msg .bubble {
        max-width: 80%;
        padding: 9px 13px;
        border-radius: 14px;
        line-height: 1.45;
        white-space: pre-wrap;
        word-wrap: break-word;
    }
    .gymbro-msg.user .bubble { background: #4f46e5; color: white; border-bottom-right-radius: 4px; }
    .gymbro-msg.bot .bubble { background: #2a2a2a; color: #e0e0e0; border-bottom-left-radius: 4px; }
    .gymbro-msg.bot.typing .bubble { font-style: italic; opacity: 0.7; }
    .gymbro-suggestions {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        padding: 0 14px 8px;
        background: #121212;
    }
    .gymbro-suggestion {
        background: #2a2a2a;
        border: 1px solid #444;
        color: #e0e0e0;
        font-size: 0.8rem;
        padding: 5px 10px;
        border-radius: 14px;
        cursor: pointer;
        transition: 0.15s;
    }
    .gymbro-suggestion:hover { background: #333; border-color: #4f46e5; color: #fff; }
    .gymbro-chat-input {
        padding: 10px;
        border-top: 1px solid #333;
        background: #1a1a1a;
        display: flex;
        gap: 8px;
    }
    .gymbro-chat-input input {
        flex: 1;
        background: #2a2a2a;
        border: 1px solid #444;
        color: #fff;
        border-radius: 20px;
        padding: 8px 14px;
        font-size: 0.9rem;
    }
    .gymbro-chat-input input:focus { outline: none; border-color: #4f46e5; }
    .gymbro-chat-input button {
        background: #4f46e5;
        color: white;
        border: none;
        border-radius: 20px;
        padding: 0 16px;
        font-weight: 600;
        cursor: pointer;
    }
    .gymbro-chat-input button:disabled { opacity: 0.5; cursor: not-allowed; }
    @media (max-width: 480px) {
        .gymbro-chat-panel { right: 8px; left: 8px; width: auto; bottom: 88px; }
        .gymbro-chat-bubble { right: 16px; bottom: 16px; }
    }
</style>

<button class="gymbro-chat-bubble" id="gymbroChatToggle" type="button" aria-label="<%= t('chatbot.open_aria') %>">
    <i class="bi bi-chat-dots-fill"></i>
</button>

<div class="gymbro-chat-panel" id="gymbroChatPanel" role="dialog" aria-label="<%= t('chatbot.title') %>">
    <div class="gymbro-chat-header">
        <div>
            <div><%= t('chatbot.title') %> <i class="bi bi-stars" style="font-size:0.9rem;"></i></div>
            <div class="subtitle"><%= t('chatbot.subtitle') %></div>
        </div>
        <button type="button" id="gymbroChatClose" aria-label="<%= t('chatbot.close_aria') %>">&times;</button>
    </div>
    <div class="gymbro-chat-body" id="gymbroChatBody"></div>
    <div class="gymbro-suggestions" id="gymbroSuggestions">
        <button type="button" class="gymbro-suggestion"><%= t('chatbot.sugg_packages') %></button>
        <button type="button" class="gymbro-suggestion"><%= t('chatbot.sugg_booking') %></button>
        <% if (typeof user !== 'undefined' && user && user.role === 'member') { %>
            <button type="button" class="gymbro-suggestion"><%= t('chatbot.sugg_my_pt') %></button>
            <button type="button" class="gymbro-suggestion"><%= t('chatbot.sugg_my_bookings') %></button>
        <% } else { %>
            <button type="button" class="gymbro-suggestion"><%= t('chatbot.sugg_hours') %></button>
            <button type="button" class="gymbro-suggestion"><%= t('chatbot.sugg_trainers') %></button>
        <% } %>
    </div>
    <form class="gymbro-chat-input" id="gymbroChatForm" autocomplete="off">
        <input type="text" id="gymbroChatInput" placeholder="<%= t('chatbot.input_ph') %>" maxlength="1000" required>
        <button type="submit" id="gymbroChatSend" aria-label="<%= t('chatbot.send_aria') %>"><i class="bi bi-send-fill"></i></button>
    </form>
</div>

<script>
(function() {
    const STORAGE_KEY = 'gymbro_chat_history_v1';
    const OWNER_KEY = 'gymbro_chat_owner_v1';
    const LANG_KEY = 'gymbro_chat_lang_v1';
    const MAX_HISTORY = 30;
    const currentOwner = <%- JSON.stringify(typeof user !== 'undefined' && user ? String(user.id) : 'guest') %>;
    const currentLang = <%- JSON.stringify(lang) %>;
    const I18N = {
        greeting: <%- JSON.stringify(t('chatbot.greeting')) %>,
        typing: <%- JSON.stringify(t('chatbot.typing')) %>,
        no_reply: <%- JSON.stringify(t('chatbot.no_reply')) %>,
        network_error: <%- JSON.stringify(t('chatbot.network_error')) %>
    };

    try {
        const storedOwner = localStorage.getItem(OWNER_KEY);
        const storedLang = localStorage.getItem(LANG_KEY);
        // Reset history khi đổi user hoặc đổi ngôn ngữ — bảo mật + tránh trộn VI/EN
        if (storedOwner !== currentOwner || storedLang !== currentLang) {
            localStorage.removeItem(STORAGE_KEY);
            localStorage.setItem(OWNER_KEY, currentOwner);
            localStorage.setItem(LANG_KEY, currentLang);
        }
    } catch (e) {}

    const $toggle = document.getElementById('gymbroChatToggle');
    const $panel = document.getElementById('gymbroChatPanel');
    const $close = document.getElementById('gymbroChatClose');
    const $body = document.getElementById('gymbroChatBody');
    const $form = document.getElementById('gymbroChatForm');
    const $input = document.getElementById('gymbroChatInput');
    const $send = document.getElementById('gymbroChatSend');
    const $suggestions = document.getElementById('gymbroSuggestions');

    let history = [];
    try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) history = JSON.parse(raw) || [];
    } catch (e) { history = []; }

    function saveHistory() {
        try {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(history.slice(-MAX_HISTORY)));
        } catch (e) {}
    }

    /* Markdown nhẹ: escape HTML trước, sau đó parse **bold**, *italic*,
       `code`, link, bullet `*`/`-` đầu dòng, và xuống dòng. Tránh XSS bằng
       cách KHÔNG cho phép tag thô từ server. */
    function escapeHTML(s) {
        return String(s)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }
    function renderMarkdown(text) {
        let s = escapeHTML(text);
        // Bullet đầu dòng: "* item" hoặc "- item" -> "• item"
        s = s.replace(/(^|\n)\s*[\*\-]\s+/g, '$1• ');
        // Bold **text**
        s = s.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
        // Italic *text* (sau khi đã thay bullet và bold)
        s = s.replace(/(^|[^\*])\*(?!\s)([^\*\n]+?)\*(?!\*)/g, '$1<em>$2</em>');
        // `inline code`
        s = s.replace(/`([^`]+)`/g, '<code>$1</code>');
        // Link [text](url)
        s = s.replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');
        // Newline -> <br>
        s = s.replace(/\n/g, '<br>');
        return s;
    }

    function appendMessage(role, text, opts) {
        const wrap = document.createElement('div');
        wrap.className = 'gymbro-msg ' + (role === 'user' ? 'user' : 'bot') + (opts && opts.typing ? ' typing' : '');
        const bubble = document.createElement('div');
        bubble.className = 'bubble';
        if (role === 'bot' && !(opts && opts.typing)) {
            bubble.innerHTML = renderMarkdown(text);
        } else {
            bubble.textContent = text;
        }
        wrap.appendChild(bubble);
        $body.appendChild(wrap);
        $body.scrollTop = $body.scrollHeight;
        return wrap;
    }

    function renderHistory() {
        $body.innerHTML = '';
        if (history.length === 0) {
            appendMessage('bot', I18N.greeting);
        } else {
            history.forEach(h => appendMessage(h.role, h.text));
        }
    }

    async function send(text) {
        if (!text || !text.trim()) return;
        text = text.trim();

        appendMessage('user', text);
        history.push({ role: 'user', text });
        saveHistory();

        $input.value = '';
        $send.disabled = true;
        const typing = appendMessage('bot', I18N.typing, { typing: true });

        try {
            const csrfToken = document.querySelector('meta[name="csrf-token"]');
            const headers = { 'Content-Type': 'application/json' };
            if (csrfToken && csrfToken.content) headers['x-csrf-token'] = csrfToken.content;

            const r = await fetch('/api/chat', {
                method: 'POST',
                headers,
                credentials: 'same-origin',
                body: JSON.stringify({ message: text, history: history.slice(-12, -1) })
            });
            const data = await r.json().catch(() => ({ ok: false, reply: I18N.no_reply }));
            typing.remove();
            const reply = (data && data.reply) || I18N.no_reply;
            appendMessage('bot', reply);
            history.push({ role: 'model', text: reply });
            saveHistory();
        } catch (e) {
            typing.remove();
            appendMessage('bot', I18N.network_error);
        } finally {
            $send.disabled = false;
            $input.focus();
        }
    }

    $toggle.addEventListener('click', () => {
        $panel.classList.add('open');
        if ($body.children.length === 0) renderHistory();
        setTimeout(() => $input.focus(), 100);
    });
    $close.addEventListener('click', () => $panel.classList.remove('open'));

    $form.addEventListener('submit', (e) => {
        e.preventDefault();
        send($input.value);
    });

    $suggestions.addEventListener('click', (e) => {
        if (e.target.classList.contains('gymbro-suggestion')) {
            send(e.target.textContent);
        }
    });

    renderHistory();
})();
</script>
