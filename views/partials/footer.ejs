</div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
    // Mobile sidebar toggle
    (function () {
        const sb = document.getElementById('gymSidebar');
        const bd = document.getElementById('gymSidebarBackdrop');
        const hb = document.getElementById('gymHamburger');
        if (!sb || !bd || !hb) return;
        function open() { sb.classList.add('is-open'); bd.classList.add('show'); }
        function close() { sb.classList.remove('is-open'); bd.classList.remove('show'); }
        hb.addEventListener('click', open);
        bd.addEventListener('click', close);
        // Đóng khi click vào nav-item
        sb.querySelectorAll('.nav-item').forEach(a => a.addEventListener('click', () => {
            if (window.innerWidth < 992) close();
        }));
        // Đóng khi resize lên desktop
        window.addEventListener('resize', () => { if (window.innerWidth >= 992) close(); });
    })();
    </script>
</body>
</html>