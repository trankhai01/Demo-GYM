<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <title>Hệ thống Quản trị GYM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Oswald:wght@600;700&display=swap" rel="stylesheet">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="stylesheet" href="/css/theme.css">
    <script src="/js/ui-helpers.js"></script>
    <style>
        /* Sidebar dark — tăng tương phản so với main content sáng */
        .sidebar {
            min-height: 100vh;
            position: fixed;
            width: 250px;
            left: 0; top: 0;
            background: linear-gradient(180deg, #0f172a 0%, #1e1b4b 100%) !important;
            border-right: 1px solid rgba(255, 255, 255, 0.08) !important;
            box-shadow: 4px 0 24px rgba(15, 23, 42, 0.18);
            color: rgba(255, 255, 255, 0.85);
            z-index: 1030;
            overflow-y: auto;
        }
        .sidebar .sidebar-header {
            padding: 24px 16px 20px 16px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.10);
            text-align: center;
        }
        .sidebar .navbar-brand {
            font-family: 'Oswald', sans-serif;
            font-weight: 700;
            font-size: 2rem;
            letter-spacing: 2px;
            text-decoration: none;
            background: linear-gradient(90deg, #818cf8, #22d3ee) !important;
            -webkit-background-clip: text !important;
            -webkit-text-fill-color: transparent !important;
            background-clip: text !important;
            color: transparent !important;
        }
        .sidebar .greeting-text {
            font-size: 0.88rem;
            color: rgba(255, 255, 255, 0.65);
            margin-top: 12px;
        }
        .sidebar .greeting-text strong { color: #ffffff; }
        .sidebar .btn-logout {
            margin-top: 14px;
            width: 100%;
            font-size: 0.85rem;
            font-weight: 600;
            background: rgba(239, 68, 68, 0.12);
            color: #fca5a5;
            border: 1px solid rgba(239, 68, 68, 0.35);
            transition: all .2s;
            padding: 6px 12px;
            border-radius: 8px;
        }
        .sidebar .btn-logout:hover {
            background: rgba(239, 68, 68, 0.85);
            color: #ffffff;
            border-color: transparent;
        }
        .sidebar .nav-section {
            padding: 12px 0;
        }
        .sidebar a.nav-item {
            text-decoration: none;
            padding: 13px 22px;
            display: flex;
            align-items: center;
            gap: 12px;
            transition: all .25s ease;
            font-weight: 500;
            font-size: 0.95rem;
            color: rgba(255, 255, 255, 0.78) !important;
            border-left: 3px solid transparent;
            position: relative;
        }
        .sidebar a.nav-item i {
            font-size: 1.1rem;
            width: 22px;
            text-align: center;
            color: rgba(255, 255, 255, 0.55);
            transition: color .25s ease;
        }
        .sidebar a.nav-item:hover {
            background: rgba(255, 255, 255, 0.06) !important;
            color: #ffffff !important;
            border-left-color: rgba(34, 211, 238, 0.6) !important;
        }
        .sidebar a.nav-item:hover i { color: #22d3ee; }
        .sidebar a.nav-item.active {
            background: linear-gradient(90deg, rgba(79, 70, 229, 0.45), rgba(6, 182, 212, 0.18)) !important;
            color: #ffffff !important;
            border-left-color: #22d3ee !important;
            font-weight: 600;
            box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
        }
        .sidebar a.nav-item.active i { color: #22d3ee; }
        .sidebar a.nav-item.active::after {
            content: '';
            position: absolute;
            right: 12px; top: 50%;
            transform: translateY(-50%);
            width: 6px; height: 6px;
            background: #22d3ee;
            border-radius: 50%;
            box-shadow: 0 0 8px #22d3ee;
        }
        .sidebar .badge.unread {
            background: #ef4444;
            color: #fff;
            font-size: 0.7rem;
            margin-left: auto;
            padding: 3px 7px;
            border-radius: 999px;
        }
        /* Custom scrollbar trong sidebar */
        .sidebar::-webkit-scrollbar { width: 6px; }
        .sidebar::-webkit-scrollbar-track { background: transparent; }
        .sidebar::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.15); border-radius: 3px; }
        .sidebar::-webkit-scrollbar-thumb:hover { background: rgba(255, 255, 255, 0.30); }

        .main-content {
            margin-left: 250px;
            padding: 30px;
            min-height: 100vh;
        }
        .card { border-radius: 14px; }

        /* Mobile hamburger toggle (chỉ hiện <992px) */
        .mobile-hamburger {
            display: none;
            position: fixed;
            top: 14px; left: 14px;
            width: 44px; height: 44px;
            background: linear-gradient(135deg, #4f46e5, #06b6d4);
            color: #ffffff;
            border: 0;
            border-radius: 12px;
            font-size: 1.4rem;
            z-index: 1040;
            box-shadow: 0 6px 16px rgba(15, 23, 42, .25);
            cursor: pointer;
            align-items: center; justify-content: center;
        }
        .sidebar-backdrop {
            display: none;
            position: fixed; inset: 0;
            background: rgba(15, 23, 42, .55);
            z-index: 1029;
        }
        .sidebar-backdrop.show { display: block; }

        /* Tablet & mobile: <992px → sidebar slide-in */
        @media (max-width: 991.98px) {
            .mobile-hamburger { display: inline-flex; }
            .sidebar {
                transform: translateX(-100%);
                transition: transform .3s ease;
                width: 260px;
            }
            .sidebar.is-open { transform: translateX(0); }
            .main-content {
                margin-left: 0 !important;
                padding: 76px 16px 30px 16px;
            }
        }
        @media (max-width: 575.98px) {
            .main-content { padding: 76px 12px 20px 12px; }
        }

        /* Sidebar dark theme override khi html data-theme="dark" */
        html[data-theme="dark"] .main-content { background-color: #0b1220; }
    </style>
</head>
<body>

<%
    /* Active route helper:
       - Highlight chính xác theo prefix path để các sub-page (vd /members/edit/3) cũng active /members
       - Các route càng cụ thể (vd /schedule/admin) phải xếp TRƯỚC route ngắn hơn (vd /schedule) trong logic */
    const _path = (typeof currentPath !== 'undefined' ? currentPath : '') || '';
    function isActive(prefix) {
        if (!_path) return false;
        if (prefix === '/') return _path === '/';
        // Exact match hoặc bắt đầu bằng prefix + "/"
        return _path === prefix || _path.indexOf(prefix + '/') === 0;
    }
%>

<% if (user) { %>
<button type="button" class="mobile-hamburger" id="gymHamburger" aria-label="Mở menu">
    <i class="bi bi-list"></i>
</button>
<div class="sidebar-backdrop" id="gymSidebarBackdrop"></div>
<% } %>

<div class="sidebar" id="gymSidebar">
    <div class="sidebar-header">
        <div class="d-flex align-items-center justify-content-between">
            <a href="/" class="navbar-brand mx-auto">GYM BRO</a>
            <button type="button" class="gym-theme-toggle" data-gym-theme-btn aria-label="Toggle theme">
                <i class="bi bi-moon-stars-fill"></i>
            </button>
        </div>

        <% if (user) { %>
            <div class="greeting-text">
                <i class="bi bi-person-circle"></i> Xin chào, <strong><%= user.fullname %></strong>
            </div>
            <a href="/logout" class="btn btn-logout"><i class="bi bi-box-arrow-right"></i> Đăng xuất</a>
        <% } %>
    </div>

    <div class="nav-section">
        <% if (user && user.role === 'admin') { %>
            <a href="/admin" class="nav-item<%= (_path === '/admin' || _path === '/admin/' || _path === '/') ? ' active' : '' %>"><i class="bi bi-speedometer2"></i> Dashboard</a>
            <a href="/reports" class="nav-item<%= isActive('/reports') ? ' active' : '' %>"><i class="bi bi-bar-chart-line"></i> Báo cáo Doanh thu</a>
            <a href="/members" class="nav-item<%= isActive('/members') ? ' active' : '' %>"><i class="bi bi-people-fill"></i> Quản lý Hội viên</a>
            <a href="/checkin" class="nav-item<%= isActive('/checkin') ? ' active' : '' %>"><i class="bi bi-upc-scan"></i> Máy Check-in</a>
            <a href="/schedule/admin" class="nav-item<%= isActive('/schedule') ? ' active' : '' %>"><i class="bi bi-calendar3"></i> Lịch tập</a>
            <a href="/packages" class="nav-item<%= isActive('/packages') ? ' active' : '' %>"><i class="bi bi-box-seam"></i> Gói tập</a>
            <a href="/trainers" class="nav-item<%= isActive('/trainers') ? ' active' : '' %>"><i class="bi bi-person-video3"></i> Huấn luyện viên</a>
            <a href="/products" class="nav-item<%= isActive('/products') ? ' active' : '' %>"><i class="bi bi-box2-fill"></i> Kho hàng</a>
            <a href="/registrations" class="nav-item<%= isActive('/registrations') ? ' active' : '' %>"><i class="bi bi-cart-plus"></i> Bán hàng (POS)</a>
            <a href="/discounts" class="nav-item<%= isActive('/discounts') ? ' active' : '' %>"><i class="bi bi-ticket-perforated"></i> Mã ưu đãi</a>
            <a href="/admin/messages" class="nav-item<%= isActive('/admin/messages') ? ' active' : '' %>">
                <i class="bi bi-envelope-paper"></i> Tin nhắn liên hệ
                <% if (typeof unreadContactCount !== 'undefined' && unreadContactCount > 0) { %>
                    <span class="badge unread"><%= unreadContactCount %></span>
                <% } %>
            </a>
        <% } %>

        <% if (user && user.role === 'staff') { %>
            <a href="/members" class="nav-item<%= isActive('/members') ? ' active' : '' %>"><i class="bi bi-people-fill"></i> Quản lý Hội viên</a>
            <a href="/checkin" class="nav-item<%= isActive('/checkin') ? ' active' : '' %>"><i class="bi bi-upc-scan"></i> Máy Check-in</a>
            <a href="/schedule/admin" class="nav-item<%= isActive('/schedule') ? ' active' : '' %>"><i class="bi bi-calendar3"></i> Lịch tập</a>
            <a href="/packages" class="nav-item<%= isActive('/packages') ? ' active' : '' %>"><i class="bi bi-box-seam"></i> Gói tập</a>
            <a href="/products" class="nav-item<%= isActive('/products') ? ' active' : '' %>"><i class="bi bi-box2-fill"></i> Kho hàng</a>
            <a href="/registrations" class="nav-item<%= isActive('/registrations') ? ' active' : '' %>"><i class="bi bi-cart-plus"></i> Bán hàng (POS)</a>
            <a href="/discounts" class="nav-item<%= isActive('/discounts') ? ' active' : '' %>"><i class="bi bi-ticket-perforated"></i> Mã ưu đãi</a>
            <a href="/admin/messages" class="nav-item<%= isActive('/admin/messages') ? ' active' : '' %>">
                <i class="bi bi-envelope-paper"></i> Tin nhắn liên hệ
                <% if (typeof unreadContactCount !== 'undefined' && unreadContactCount > 0) { %>
                    <span class="badge unread"><%= unreadContactCount %></span>
                <% } %>
            </a>
        <% } %>

        <% if (user && user.role === 'member') { %>
            <a href="/dashboard" class="nav-item<%= isActive('/dashboard') ? ' active' : '' %>"><i class="bi bi-speedometer2"></i> Tổng quan</a>
            <a href="/my-profile" class="nav-item<%= isActive('/my-profile') ? ' active' : '' %>"><i class="bi bi-person-vcard"></i> Trang cá nhân</a>
            <a href="/schedule" class="nav-item<%= (_path === '/schedule' || _path.indexOf('/schedule/') === 0) && !isActive('/profile/schedule') ? ' active' : '' %>"><i class="bi bi-calendar3"></i> Lịch tập</a>
            <a href="/profile/schedule" class="nav-item<%= isActive('/profile/schedule') ? ' active' : '' %>"><i class="bi bi-clock-history"></i> Lịch sử tập</a>
            <a href="/profile/change-password" class="nav-item<%= isActive('/profile/change-password') ? ' active' : '' %>"><i class="bi bi-key"></i> Đổi mật khẩu</a>
        <% } %>
    </div>
</div>

<%- include('chatbot') %>

<div class="main-content">
