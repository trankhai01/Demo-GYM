<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hệ thống Quản trị GYM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@600;700&display=swap" rel="stylesheet">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    
    <style>
        /* NỀN TỐI TOÀN HỆ THỐNG */
        body { 
            background-color: #121212; 
            color: #e0e0e0; 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
        }

        /* SIDEBAR (CỘT TRÁI TỐI MÀU) */
        .sidebar { 
            min-height: 100vh; 
            background: #000000; /* Đen tuyền */
            border-right: 1px solid #333; 
            position: fixed; 
            width: 250px; 
            left: 0; top: 0;
        }
        .sidebar a.nav-item { 
            color: #a0a0a0; 
            text-decoration: none; 
            padding: 15px 20px; 
            display: block; 
            transition: 0.3s; 
            font-weight: 500;
        }
        .sidebar a.nav-item:hover { 
            background: #1a1a1a; 
            color: #fff; 
            border-left: 4px solid #e50914; 
            padding-left: 16px; /* Hiệu ứng thụt lề */
        }
        .sidebar a.nav-item.active { 
            background: #1a1a1a; 
            color: #e50914; 
            border-left: 4px solid #e50914; 
            padding-left: 16px;
        }

        /* PHẦN NỘI DUNG CHÍNH BÊN PHẢI */
        .main-content { 
            margin-left: 250px; 
            padding: 30px; 
            min-height: 100vh; 
        }

        /* ÉP MÀU CÁC THÀNH PHẦN BOOTSTRAP SANG DARK MODE */
        .card { 
            background-color: #1e1e1e !important; 
            border: 1px solid #333 !important; 
            border-radius: 12px; 
            box-shadow: 0 10px 30px rgba(0,0,0,0.5); 
        }
        .table { color: #fff !important; border-color: #333; }
        .table-light { background-color: #2a2a2a !important; color: #e50914 !important; text-transform: uppercase; }
        .table-hover tbody tr:hover { background-color: #252525 !important; color: white !important;}
        .text-dark { color: #ffffff !important; } /* Sửa text-dark thành chữ trắng */
        .text-muted { color: #a0a0a0 !important; }

        .navbar-brand {
            font-family: 'Oswald', sans-serif;
            font-weight: 700;
            font-size: 2rem;
            color: #e50914 !important; 
            letter-spacing: 2px;
            text-decoration: none;
        }
    </style>
</head>
<body>
    
   <div class="sidebar shadow-lg">
    <div class="p-4 mb-2 text-center border-bottom" style="border-color: #333 !important;">
        <a href="/" class="navbar-brand">GYM BRO</a>
        
        <% if (user) { %>
            <div class="mt-3" style="color: #a0a0a0; font-size: 0.9rem;">
                <i class="bi bi-person-circle"></i> Xin chào, <strong class="text-white"><%= user.fullname %></strong>
            </div>
            <a href="/logout" class="btn btn-outline-danger btn-sm mt-3 w-100"><i class="bi bi-box-arrow-right"></i> Đăng xuất</a>
        <% } %>
    </div>

    <div class="mt-3">
        <% if (user && user.role === 'admin') { %>
            <a href="/members" class="nav-item"><i class="bi bi-people-fill me-2"></i> Quản lý Hội viên</a>
            <a href="/packages" class="nav-item"><i class="bi bi-box-seam me-2"></i> Gói tập</a>
            <a href="/registrations/add" class="nav-item"><i class="bi bi-cart-plus me-2"></i> Bán gói tập</a>
            <a href="/reports/revenue" class="nav-item"><i class="bi bi-bar-chart-line me-2"></i> Báo cáo Doanh thu</a>
        <% } %>

        <% if (user && user.role === 'member') { %>
            <a href="/my-profile" class="nav-item"><i class="bi bi-person-vcard me-2"></i> Trang cá nhân</a>
            <a href="/my-history" class="nav-item"><i class="bi bi-clock-history me-2"></i> Lịch sử tập</a>
        <% } %>
    </div>
</div>
<div class="main-content">