<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <title>Hệ thống Quản trị GYM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@600;700&display=swap" rel="stylesheet">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    
    <style>
        
        body { 
            background-color: #121212; 
            color: #e0e0e0; 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
        }

    
        .sidebar { 
            min-height: 100vh; 
            background: #000000; 
            border-right: 1px solid #333; 
            position: fixed; 
            width: 250px; 
            left: 0; top: 0;
        }
        .sidebar a.nav-item { 
            color: #a0a0a0; 
            text-decoration: none; 
            padding: 15px 20px; 
            display: block; 
            transition: 0.3s; 
            font-weight: 500;
        }
        .sidebar a.nav-item:hover { 
            background: #1a1a1a; 
            color: #fff; 
            border-left: 4px solid #e50914; 
            padding-left: 16px; 
        }
        .sidebar a.nav-item.active { 
            background: #1a1a1a; 
            color: #e50914; 
            border-left: 4px solid #e50914; 
            padding-left: 16px;
        }

        .main-content { 
            margin-left: 250px; 
            padding: 30px; 
            min-height: 100vh; 
        }
        .card { 
            background-color: #1e1e1e !important; 
            border: 1px solid #333 !important; 
            border-radius: 12px; 
            box-shadow: 0 10px 30px rgba(0,0,0,0.5); 
        }
        .table { color: #fff !important; border-color: #333; }
        .table-light { background-color: #2a2a2a !important; color: #e50914 !important; text-transform: uppercase; }
        .table-hover tbody tr:hover { background-color: #252525 !important; color: white !important;}
        .text-dark { color: #ffffff !important; } 
        .text-muted { color: #a0a0a0 !important; }

        .navbar-brand {
            font-family: 'Oswald', sans-serif;
            font-weight: 700;
            font-size: 2rem;
            color: #e50914 !important; 
            letter-spacing: 2px;
            text-decoration: none;
        }
    </style>
</head>
<body>
    
   <div class="sidebar shadow-lg">
    <div class="p-4 mb-2 text-center border-bottom" style="border-color: #333 !important;">
        <a href="/" class="navbar-brand">GYM BRO</a>
        
        <% if (user) { %>
            <div class="mt-3" style="color: #a0a0a0; font-size: 0.9rem;">
                <i class="bi bi-person-circle "></i> Xin chào, <strong class="text-white "><%= user.fullname %></strong>
            </div>
            <a href="/logout" class="btn btn-outline-danger btn-sm mt-3 w-100"><i class="bi bi-box-arrow-right"></i> Đăng xuất</a>
        <% } %>
    </div>

    <div class="mt-3">
        <% if (user && user.role === 'admin') { %>
            <a href="/reports" class="nav-item fw-bold"><i class="bi bi-bar-chart-line me-2"></i> Báo cáo Doanh thu</a>
            <a href="/members" class="nav-item fw-bold"><i class="bi bi-people-fill me-2"></i> Quản lý Hội viên</a>
            <a href="/checkin" class="nav-item fw-bold"><i class="bi bi-upc-scan me-2"></i> Máy Check-in</a>
            <a href="/schedule/admin" class="nav-item fw-bold"><i class="bi bi-calendar3 me-2"></i> Lịch tập</a>
            <a href="/packages" class="nav-item fw-bold"><i class="bi bi-box-seam me-2"></i> Gói tập</a>
            <a href="/trainers" class="nav-item fw-bold"><i class="bi bi-person-video3 me-2"></i> Huấn luyện viên</a>
            <a href="/products" class="nav-item fw-bold"><i class="bi bi-box2-fill me-2"></i> Kho hàng</a>
            <a href="/registrations" class="nav-item fw-bold"><i class="bi bi-cart-plus me-2"></i> Bán hàng (POS)</a>
            <a href="/admin/password-resets" class="nav-item fw-bold">
                <i class="bi bi-key me-2"></i> Yêu cầu đổi mật khẩu
                <% if (typeof pendingResetCount !== 'undefined' && pendingResetCount > 0) { %>
                    <span class="badge bg-danger ms-2"><%= pendingResetCount %></span>
                <% } %>
            </a>
            <a href="/admin/messages" class="nav-item fw-bold">
                <i class="bi bi-envelope-paper me-2"></i> Tin nhắn liên hệ
                <% if (typeof unreadContactCount !== 'undefined' && unreadContactCount > 0) { %>
                    <span class="badge bg-danger ms-2"><%= unreadContactCount %></span>
                <% } %>
            </a>
        <% } %>

        <% if (user && user.role === 'staff') { %>
            <a href="/members" class="nav-item fw-bold"><i class="bi bi-people-fill me-2"></i> Quản lý Hội viên</a>
            <a href="/checkin" class="nav-item fw-bold"><i class="bi bi-upc-scan me-2"></i> Máy Check-in</a>
            <a href="/schedule/admin" class="nav-item fw-bold"><i class="bi bi-calendar3 me-2"></i> Lịch tập</a>
            <a href="/packages" class="nav-item fw-bold"><i class="bi bi-box-seam me-2"></i> Gói tập</a>
<!--         <a href="/trainers" class="nav-item fw-bold"><i class="bi bi-person-video3 me-2"></i> Huấn luyện viên</a>-->   
            <a href="/products" class="nav-item fw-bold"><i class="bi bi-box2-fill me-2"></i> Kho hàng</a>
            <a href="/registrations" class="nav-item fw-bold"><i class="bi bi-cart-plus me-2"></i> Bán hàng (POS)</a>
            <a href="/admin/messages" class="nav-item fw-bold">
                <i class="bi bi-envelope-paper me-2"></i> Tin nhắn liên hệ
                <% if (typeof unreadContactCount !== 'undefined' && unreadContactCount > 0) { %>
                    <span class="badge bg-danger ms-2"><%= unreadContactCount %></span>
                <% } %>
            </a>
            
        <% } %>

        <% if (user && user.role === 'member') { %>
            <a href="/dashboard" class="nav-item fw-bold"><i class="bi bi-speedometer2 me-2"></i> Tổng quan</a>
            <a href="/my-profile" class="nav-item fw-bold"><i class="bi bi-person-vcard me-2"></i> Trang cá nhân</a>
            <a href="/schedule" class="nav-item fw-bold"><i class="bi bi-calendar3 me-2"></i> Lịch tập</a>
            <a href="/profile/schedule" class="nav-item fw-bold"><i class="bi bi-clock-history me-2"></i> Lịch sử tập</a>
            <a href="/profile/change-password" class="nav-item fw-bold"><i class="bi bi-key me-2"></i> Đổi mật khẩu</a>

        <% } %>
    </div>
</div>

<%- include('chatbot') %>

<div class="main-content">