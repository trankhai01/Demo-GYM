<!DOCTYPE html>
<html lang="<%= lang %>">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= t('register.title_tab') %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@600&display=swap" rel="stylesheet" />
    <style>
      :root {
        --gb-primary: #4f46e5;
        --gb-accent: #06b6d4;
        --gb-text: #0f172a;
      }
      body {
        background: linear-gradient(135deg, #eef2ff 0%, #ecfeff 100%);
        color: var(--gb-text);
        min-height: 100vh;
        display: flex;
        align-items: center;
        font-family: "Inter", "Segoe UI", sans-serif;
      }
      .register-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 36px;
        box-shadow: 0 12px 40px rgba(15, 23, 42, 0.08);
      }
      h2 {
        font-family: "Oswald", sans-serif;
        font-weight: 700;
        letter-spacing: 2px;
        background: linear-gradient(90deg, var(--gb-primary), var(--gb-accent));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }
      .form-label { color: #334155; font-weight: 600; }
      .form-control:focus, .form-select:focus {
        border-color: var(--gb-primary);
        box-shadow: 0 0 0 0.2rem rgba(79, 70, 229, 0.15);
      }
      .btn-gym {
        background: linear-gradient(90deg, var(--gb-primary), var(--gb-accent));
        color: white;
        border: none;
        font-weight: 700;
        padding: 12px;
        border-radius: 8px;
        text-transform: uppercase;
        letter-spacing: 1px;
      }
      .btn-gym:hover { filter: brightness(0.95); color: white; }
      a { color: var(--gb-primary); text-decoration: none; font-weight: 600; }
      a:hover { text-decoration: underline; }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-md-5">
          <div class="register-card">
            <div class="d-flex justify-content-end mb-2">
              <%- include('partials/lang-switch') %>
            </div>
            <div class="text-center mb-4">
              <h2 class="display-6"><%= t('register.title') %></h2>
              <p class="text-muted small"><%= t('register.subtitle') %></p>
            </div>

            <form action="/register" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="mb-3">
                <label class="form-label"><%= t('register.fullname') %></label>
                <input type="text" name="fullname" class="form-control"
                       value="<%= locals.fullname || '' %>" required />
              </div>
              <div class="mb-3">
                <label class="form-label"><%= t('register.gender') %></label>
                <select name="gender" class="form-select">
                  <option value="Nam" <%= locals.gender === 'Nam' ? 'selected' : '' %>><%= t('register.gender_male') %></option>
                  <option value="Nữ" <%= locals.gender === 'Nữ' ? 'selected' : '' %>><%= t('register.gender_female') %></option>
                </select>
              </div>
              <div class="mb-3">
                <label class="form-label"><%= t('register.phone') %></label>
                <input type="tel" name="phone" class="form-control"
                       value="<%= locals.phone || '' %>" required />
              </div>
              <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" name="email" class="form-control"
                       placeholder="email@gmail.com"
                       value="<%= locals.email || '' %>" />
              </div>

              <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger py-2"><i class="bi bi-exclamation-triangle-fill"></i> <%= error %></div>
              <% } %>

              <div class="mb-3">
                <label class="form-label"><%= t('register.password') %></label>
                <input type="password" name="password" class="form-control" required />
              </div>
              <button type="submit" class="btn btn-gym w-100">
                <%= t('register.submit') %>
              </button>
            </form>

            <div class="text-center mt-4 text-muted">
              <span><%= t('register.have_account') %></span>
              <a href="/login"><%= t('register.login_link') %></a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
