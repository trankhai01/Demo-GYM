<%- include('../partials/header') %>

<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>

<style>
    .ts-header {
        background: var(--gb-surface-raised);
        border: 1px solid var(--gb-border);
        border-radius:14px;
        padding:18px 20px;
        margin-bottom:18px;
        display:flex; align-items:center; gap:18px;
        box-shadow: var(--gb-shadow);
    }
    .ts-avatar {
        width:84px; height:84px;
        border-radius:50%;
        background:linear-gradient(135deg,var(--gb-primary),var(--gb-accent));
        display:flex; align-items:center; justify-content:center;
        color:#fff; font-size:2rem; font-weight:700;
        flex-shrink:0;
        overflow:hidden;
    }
    .ts-avatar img { width:100%; height:100%; object-fit:cover; }
    .ts-name { font-weight:800; color:var(--gb-heading); font-size:1.4rem; margin:0; }
    .ts-spec { color:var(--gb-text-muted); font-size:.95rem; }
    .ts-spec .badge {
        background:var(--gb-primary-100) !important; color:var(--gb-primary) !important;
        font-weight:600; padding:4px 10px;
    }
    .ts-stat-row { display:flex; gap:24px; margin-left:auto; }
    .ts-stat { text-align:center; }
    .ts-stat-num { font-size:1.5rem; font-weight:800; color:var(--gb-primary); }
    .ts-stat-lbl { font-size:.78rem; color:var(--gb-text-muted); text-transform:uppercase; letter-spacing:.5px; }

    #trainerCal {
        background:var(--gb-surface-raised);
        color: var(--gb-text);
        border:1px solid var(--gb-border);
        border-radius:14px;
        padding:14px;
        box-shadow:var(--gb-shadow);
    }
    .fc { color: var(--gb-text); }
    .fc-toolbar-title { color:var(--gb-heading) !important; font-weight: 800; }
    .fc-button-primary {
        background:var(--gb-primary) !important;
        border-color:var(--gb-primary) !important;
        color:#fff !important;
        font-weight: 700 !important;
    }
    .fc-button-primary:hover,
    .fc-button-primary:not(:disabled).fc-button-active {
        background:var(--gb-primary-600) !important;
        border-color:var(--gb-primary-600) !important;
    }
    .fc-theme-standard td, .fc-theme-standard th, .fc-theme-standard .fc-scrollgrid {
        border-color: var(--gb-border) !important;
    }
    .fc-scrollgrid,
    .fc .fc-timegrid-slot,
    .fc .fc-timegrid-axis,
    .fc .fc-col-header-cell,
    .fc .fc-daygrid-day {
        background: var(--gb-surface-raised);
    }
    .fc .fc-col-header-cell-cushion,
    .fc .fc-timegrid-slot-label-cushion,
    .fc .fc-daygrid-day-number {
        color: var(--gb-text-muted) !important;
    }
    .fc-day-today { background: rgba(79, 70, 229, 0.09) !important; }
    html[data-theme="dark"] .fc-day-today { background: rgba(129, 140, 248, 0.14) !important; }
    .fc-event {
        border: 0;
        border-radius: 6px;
        box-shadow: 0 8px 20px rgba(15, 23, 42, .12);
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold text-uppercase" style="color:var(--gb-heading);">
        LỊCH HLV <span style="color:var(--gb-primary);"><%= trainer.fullname %></span>
    </h3>
    <a href="/trainers" class="btn btn-sm" style="background:var(--gb-primary-100);color:var(--gb-primary);">
        <i class="bi bi-arrow-left me-1"></i> Quay lại
    </a>
</div>

<div class="ts-header">
    <div class="ts-avatar">
        <% if (trainer.image_url) { %>
            <img src="<%= trainer.image_url %>" alt="<%= trainer.fullname %>">
        <% } else { %>
            <%= (trainer.fullname || 'H').charAt(0).toUpperCase() %>
        <% } %>
    </div>
    <div>
        <h4 class="ts-name"><%= trainer.fullname %></h4>
        <div class="ts-spec mt-1">
            <% if (trainer.specialty) { %>
                <span class="badge"><%= trainer.specialty %></span>
            <% } %>
            <% if (trainer.phone) { %>
                <span class="ms-2"><i class="bi bi-telephone"></i> <%= trainer.phone %></span>
            <% } %>
        </div>
    </div>
    <div class="ts-stat-row">
        <div class="ts-stat">
            <div class="ts-stat-num" id="ts-week-cnt">—</div>
            <div class="ts-stat-lbl">Buổi tuần này</div>
        </div>
        <div class="ts-stat">
            <div class="ts-stat-num" id="ts-month-cnt">—</div>
            <div class="ts-stat-lbl">Buổi tháng này</div>
        </div>
    </div>
</div>

<div id="trainerCal"></div>

<script>
    const trainerId = <%= trainer.id %>;
    let cal;

    document.addEventListener('DOMContentLoaded', function () {
        const el = document.getElementById('trainerCal');
        cal = new FullCalendar.Calendar(el, {
            initialView: 'timeGridWeek',
            locale: 'vi',
            firstDay: 1,
            slotMinTime: '06:00:00',
            slotMaxTime: '23:00:00',
            allDaySlot: false,
            height: 'auto',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'timeGridWeek,timeGridDay,dayGridMonth'
            },
            events: function (info, successCallback, failureCallback) {
                fetch('/schedule/trainer-events/' + trainerId
                    + '?start=' + encodeURIComponent(info.start.toISOString())
                    + '&end=' + encodeURIComponent(info.end.toISOString()))
                    .then(r => r.json())
                    .then(data => successCallback(data))
                    .catch(() => failureCallback('Lỗi tải lịch'));
            },
            eventClick: function (info) {
                const p = info.event.extendedProps;
                Toast.info('<strong>' + (p.member_name || '—') + '</strong><br>' +
                    info.event.start.toLocaleString('vi-VN') + ' → ' + info.event.end.toLocaleString('vi-VN') +
                    (p.note ? '<br><em>' + p.note + '</em>' : ''),
                    { duration: 6000 });
            }
        });
        cal.render();

        // Thống kê buổi tập.
        function loadCounts() {
            const now = new Date();
            const dow = (now.getDay() + 6) % 7;
            const monStart = new Date(now); monStart.setDate(now.getDate() - dow); monStart.setHours(0,0,0,0);
            const monEnd = new Date(monStart); monEnd.setDate(monStart.getDate() + 7);
            const mFirst = new Date(now.getFullYear(), now.getMonth(), 1);
            const mLast  = new Date(now.getFullYear(), now.getMonth() + 1, 1);

            fetch('/schedule/trainer-events/' + trainerId
                + '?start=' + encodeURIComponent(monStart.toISOString())
                + '&end=' + encodeURIComponent(monEnd.toISOString()))
                .then(r => r.json())
                .then(data => { document.getElementById('ts-week-cnt').textContent = data.length; })
                .catch(() => {});

            fetch('/schedule/trainer-events/' + trainerId
                + '?start=' + encodeURIComponent(mFirst.toISOString())
                + '&end=' + encodeURIComponent(mLast.toISOString()))
                .then(r => r.json())
                .then(data => { document.getElementById('ts-month-cnt').textContent = data.length; })
                .catch(() => {});
        }
        loadCounts();
    });
</script>

<%- include('../partials/footer') %>
