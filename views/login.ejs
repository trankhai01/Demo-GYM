<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - GYM BRO</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@600;700&display=swap" rel="stylesheet" />
    <style>
      body {
        background-color: #121212;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100vh;
        margin: 0;
        font-family: "Segoe UI", sans-serif;
      }
      .login-card {
        width: 400px;
        padding: 40px;
        border-radius: 15px;
        background: #1e1e1e;
        border: 1px solid #333;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.7);
      }
      .brand-name {
        font-family: "Oswald", sans-serif;
        color: #e50914;
        letter-spacing: 2px;
        font-size: 2.2rem;
        font-weight: 700;
      }
      .form-label {
        color: #ccc;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 8px;
      }
      .form-control {
        background-color: #2a2a2a !important;
        border: 1px solid #444 !important;
        color: white !important;
        padding: 12px;
        border-radius: 8px;
      }
      .form-control:focus {
        border-color: #e50914 !important;
        box-shadow: 0 0 0 0.25rem rgba(229, 9, 20, 0.25) !important;
      }
      .btn-gym {
        background-color: #e50914;
        border: none;
        color: white;
        padding: 12px;
        font-family: "Oswald", sans-serif;
        font-size: 1.1rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: 0.3s;
        border-radius: 8px;
      }
      .btn-gym:hover {
        background-color: #b20710;
        transform: translateY(-2px);
        color: white;
      }
      .footer-link {
        color: #888;
        font-size: 0.9rem;
        text-decoration: none;
      }
      .footer-link a {
        color: #e50914;
        text-decoration: none;
        font-weight: 600;
      }
      .footer-link a:hover {
        text-decoration: underline;
      }
      .text-muted {
        color: #a0a0a0 !important;
      }
      .hero-section .lead {
        color: #d1d1d1 !important;
        text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5);
      }
    </style>
  </head>
  <body>
    <div class="login-card">
      <div class="text-center mb-4">
        <h1 class="brand-name mb-0">GYM BRO</h1>
        <p class="text-white-50 small">WELCOME BACK, CHAMPION!</p>
      </div>

      <% if (locals.error) { %>
        <div class="alert alert-danger text-center p-2 mb-3" style="font-size: 0.9rem; border-radius: 8px;">
          <i class="bi bi-exclamation-triangle-fill me-1"></i> <%= error %>
        </div>
      <% } %>

      <form action="/login" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="mb-3">
          <label class="form-label">Số điện thoại</label>
          <input
            type="text"
            name="phone"
            class="form-control"
            placeholder="0xxxxxxxxx"
            value="<%= locals.phone || '' %>"
            required
          />
        </div>
        <div class="mb-4">
          <label class="form-label text-start">Mật khẩu</label>
          <input
            type="password"
            name="password"
            class="form-control"
            placeholder="••••••••"
            required
          />
        </div>
        <button type="submit" class="btn btn-gym w-100 shadow">
          Đăng nhập ngay
        </button>
      </form>

      <div class="text-center mt-4 footer-link" style="color: #bbb;">
        Chưa có tài khoản? <a href="/register">Gia nhập ngay</a>
      </div>
    </div>
  </body>
</html>